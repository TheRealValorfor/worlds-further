	quest.000C9E6D1D2415FD.quest_desc: ["A docking connector on your ship, ready to link up with another vessel or a mobile base."]
	quest.000C9E6D1D2415FD.title: "Docking Systems"
	quest.0014FC2D69455629.quest_desc: [
		"Don't stare too long."
		"Take one down."
	]
	quest.0014FC2D69455629.title: "Enderman Bounty: Novice"
	quest.001E982341A22713.quest_desc: ["A thousand. At this point they might be more scared of you."]
	quest.001E982341A22713.title: "Enderman Bounty: Legend"
	quest.001F40159AAF95D4.quest_desc: [
		"Straight-line power transfer, nothing fancy about it."
		"Every contraption you build will have a few of these running through it."
	]
	quest.001F40159AAF95D4.title: "Shaft"
	quest.002AC82E96F9E263.quest_desc: ["Gathers up loose seeds as you tend the fields, so you don't have to."]
	quest.002AC82E96F9E263.title: "Seed Pouch"
	quest.0039412794011052.quest_desc: ["Oak track, plain and sturdy - every railway starts with a length of this underfoot."]
	quest.0039412794011052.title: "Lay Some Track"
	quest.0045BF2F3390D9C5.quest_desc: ["A Stabilized Warp Scroll offers a steadier way to cross the space you've just learned to bend."]
	quest.0045BF2F3390D9C5.title: "Stabilized Travel"
	quest.005D3418B20DFF9C.quest_desc: ["A Blank Scroll is where every travel scroll starts."]
	quest.005D3418B20DFF9C.title: "Blank Scroll"
	quest.005FAB38C05CF736.quest_desc: [
		"Every hit you land heals you back."
		"The ultimate combat artifact - simple as that."
	]
	quest.005FAB38C05CF736.title: "Vampiric Glove"
	quest.0060E25E8DAAB03F.quest_desc: [
		"So many trees to try."
		"Apples are a fine place to start an orchard."
	]
	quest.0060E25E8DAAB03F.title: "Plant an Apple Orchard"
	quest.006515B692F2017E.quest_desc: [
		"A brighter cousin to Inferium, sitting closer to the surface."
		"Its shards open an entirely different path."
	]
	quest.006515B692F2017E.title: "Prosperous Beginnings"
	quest.008A63382F1141A1.quest_desc: ["Sweeps nearby drops straight into the backpack as you walk."]
	quest.008A63382F1141A1.title: "Pickup Upgrade"
	quest.00936D431BFA2C0F.quest_desc: [
		"Plays a sound of your choosing when the signal comes through."
		"Pair it with the relayer for a doorbell or a dinner call."
	]
	quest.00936D431BFA2C0F.title: "Speaker Block"
	quest.009ED8A43F73ECBE.quest_desc: [
		"Something a dragon exhales, bottled before it dissolves into the wind."
		"The first strange step toward automating what a dragon leaves behind."
	]
	quest.009ED8A43F73ECBE.title: "Bottling Dragon's Breath"
	quest.00A3DBE546F74B19.quest_desc: [
		"A contraption that actually leaves the ground, and airspace you can finally call yours."
		"The sky was never really closed off. It just took you a while to get up there."
	]
	quest.00A3DBE546F74B19.title: "Claimed Skies"
	quest.00BB0FF914BBB0D7.quest_desc: ["Simmer your tomatoes down into something worth saving."]
	quest.00BB0FF914BBB0D7.title: "Tomato Sauce"
	quest.00D60A41AA61B526.quest_desc: ["Essence sharpens as well as it grows. Forge a pick and blade to call the first tier mastered."]
	quest.00D60A41AA61B526.title: "Tools of Essence"
	quest.00DCD60DF213C470.quest_desc: ["Carve Sourcestone into a Pedestal - the seed of your future Enchanting Apparatus."]
	quest.00DCD60DF213C470.title: "Arcane Pedestal"
	quest.00E47C5D1477978D.quest_desc: [
		"Every hunter starts somewhere."
		"Put down a single Creeper."
	]
	quest.00E47C5D1477978D.title: "Creeper Bounty: Novice"
	quest.00F08811CBBFCF7E.quest_desc: [
		"Spreads dirt, sand, and gravel without the back-and-forth."
		"A small thing, but you'll reach for it constantly."
	]
	quest.00F08811CBBFCF7E.title: "Trowel"
	quest.012CD2FD2AB2B751.quest_desc: [
		"Guards posted, weapons ready - now face down an Illusioner."
		"Friends and Foes puts them in the world. The spawn egg is not the goal; surviving the fight is."
	]
	quest.012CD2FD2AB2B751.title: "Defeat the Illusioner"
	quest.013553BB2F654B7D.quest_desc: [
		"Plays a sound of your choosing when the signal comes through."
		"Pair it with the relayer for a doorbell or a dinner call."
	]
	quest.013553BB2F654B7D.title: "Speaker Block"
	quest.013BDC4EE566A779.quest_desc: [
		"None of this locks you in - just gives you a feel for what's out there."
		"Chase whichever one pulled at you the most."
	]
	quest.013BDC4EE566A779.title: "Somewhere to Start"
	quest.016BBB8CBF38703C.quest_desc: [
		"Every explorer starts leaving their own trail of shortcuts and landmarks eventually."
		"You may already have a Waystone or two out there without calling it anything special."
	]
	quest.016BBB8CBF38703C.title: "Marks on the Map"
	quest.01A3E591884B367F.quest_desc: [
		"Twist sugar into stripes, no cocoa line required."
		"A quick treat you can make on the side."
	]
	quest.01A3E591884B367F.title: "Candy Cane"
	quest.01AB68F6B2345C16.quest_desc: ["Another jump in capacity, stacked on top of the first."]
	quest.01AB68F6B2345C16.title: "Storage Upgrade (II)"
	quest.01B52215366501CD.quest_desc: [
		"Whip these up soft and fluffy."
		"Good on their own, better once they meet chocolate."
	]
	quest.01B52215366501CD.title: "Marshmallow"
	quest.01D108F9F863429C.quest_desc: [
		"Flick it out to mine a block and it comes right back to you."
		"Handy for that one ore you can never quite reach."
	]
	quest.01D108F9F863429C.title: "Pickarang"
	quest.01F0BF26AFA7A4C1.quest_desc: [
		"Mix it down to a fine powder - the base for anything"
		"dark and bitter."
	]
	quest.01F0BF26AFA7A4C1.title: "Cocoa Powder"
	quest.01F0E71D96281D03.quest_desc: [
		"Small charms, real power - Artifacts and relics slot into your Curios inventory (open it with G)."
		"Find any trinket and equip it. The Power Glove is only one of many."
	]
	quest.01F0E71D96281D03.title: "Your First Trinket"
	quest.021FF5F6AE267D96.quest_desc: [
		"Melt a brick down into a proper drink."
		"A fitting reward for a fully automated cocoa line."
	]
	quest.021FF5F6AE267D96.title: "Hot Chocolate"
	quest.02534B762C4B695A.quest_desc: ["Carve Sourcestone into a Pedestal - the seed of your future Enchanting Apparatus."]
	quest.02534B762C4B695A.title: "Arcane Pedestal"
	quest.025393CB765284B4.quest_desc: [
		"Smelt the Zinc, mix it with Copper in the Mixer, and you've"
		"got Brass - the metal the rest of this pack runs on."
	]
	quest.025393CB765284B4.title: "Zinc and Brass"
	quest.0283BDF23FEF183B.quest_desc: ["Fry, sear, and get creative with what the stove can do."]
	quest.0283BDF23FEF183B.title: "The Skillet"
	quest.029060C4CF454198.quest_desc: [
		"Dresses drawers up with trim and matching materials."
		"For when function needs to look good too."
	]
	quest.029060C4CF454198.title: "Framing Table"
	quest.0293AC063F6E64E1.quest_desc: [
		"Andesite casing tidies up the wiring and toughens it -"
		"the first upgrade tier."
	]
	quest.0293AC063F6E64E1.title: "Andesite Encased Connector"
	quest.02C6343A7846FE95.quest_desc: [
		"Near a crafting table, in a hole in the ground - that's where every story here begins."
		"The horizon has been waiting this whole time."
	]
	quest.02C6343A7846FE95.title: "First Steps Beyond"
	quest.02CB63352BD89E14.quest_desc: ["A handful of walnuts, roasted into a good little snack."]
	quest.02CB63352BD89E14.title: "Roasted Walnuts"
	quest.02F1EDBDE9ECE947.quest_desc: ["Keeps an eye out for anything living that wanders past."]
	quest.02F1EDBDE9ECE947.title: "Ender Watcher"
	quest.02FC44AD0C094263.quest_desc: ["Brew up something warming for a quiet evening."]
	quest.02FC44AD0C094263.title: "Chai Tea"
	quest.0301199AD973A517.quest_desc: [
		"Gold and Silver alloyed into Electrum wire - carries"
		"current more efficiently than Copper ever could."
	]
	quest.0301199AD973A517.title: "Electrum Wiring"
	quest.0323A014089BAA4D.quest_desc: [
		"Twist sugar into stripes, no cocoa line required."
		"A quick treat you can make on the side."
	]
	quest.0323A014089BAA4D.title: "Candy Cane"
	quest.036FCFC315235E0F.quest_desc: ["Fifty. You've got a real knack for not making eye contact."]
	quest.036FCFC315235E0F.title: "Enderman Bounty: Veteran"
	quest.03793CE3FC42A5FB.quest_desc: ["Essence sharpens as well as it grows. Forge a pick and blade to call the first tier mastered."]
	quest.03793CE3FC42A5FB.title: "Tools of Essence"
	quest.03866F2C4BC5C19E.quest_desc: [
		"A furnace, some ore, and suddenly the world opens up."
		"Iron tools mean real mining - and real armor isn't far behind."
	]
	quest.03866F2C4BC5C19E.title: "The Age of Iron"
	quest.0390EA5A178F77B8.quest_desc: [
		"Stolen from a nest perched somewhere no sane creature builds a home."
		"Raise it right and it will carry you further than your legs ever could."
	]
	quest.0390EA5A178F77B8.title: "Hippogryph Egg"
	quest.03DA5931734105DC.quest_desc: [
		"One slot, one item, no fuss."
		"Your first step into Functional Storage."
	]
	quest.03DA5931734105DC.title: "Oak Drawer (1x1)"
	quest.041A3553E7DB393A.quest_desc: ["Mystical Agradditions dares one tier further. Crux and awakened essence combine into the true capstone: Insanium."]
	quest.041A3553E7DB393A.title: "Insanium: Beyond Awakened"
	quest.042DB1E3888E3A6A.quest_desc: [
		"The ocean keeps its best secrets where the light gives up."
		"Bring something back worth telling people about."
	]
	quest.042DB1E3888E3A6A.title: "Beneath the Waves"
	quest.04508D97C0044D38.quest_desc: [
		"You've seen more of this world than most people who ever load it up will."
		"The map stopped being frightening a long time ago."
	]
	quest.04508D97C0044D38.title: "Beyond the Horizon"
	quest.047EC009A985459D.quest_desc: ["A couple of colorful containers keep your goods tidy and dry."]
	quest.047EC009A985459D.title: "Shipping Containers"
	quest.0492DDD87165FAAF.quest_desc: ["Finish the bedroom off with a bed that's a cut above plain."]
	quest.0492DDD87165FAAF.title: "A Proper Bed"
	quest.04B161ED3C6112A2.quest_desc: [
		"Still smoldering when you pull it free of the dragon that carried it."
		"Everything a Fire Dragonsteel weapon needs to exist."
	]
	quest.04B161ED3C6112A2.title: "Heart of a Fire Dragon"
	quest.04B90AEFA2CB30A8.quest_desc: ["Carve Sourcestone into a Pedestal - the seed of your future Enchanting Apparatus."]
	quest.04B90AEFA2CB30A8.title: "Arcane Pedestal"
	quest.04D503941759DDA9.quest_desc: [
		"Not everything you move needs to leave the ground."
		"Build a train station alongside your airship station for cargo that's happy to stay earthbound."
	]
	quest.04D503941759DDA9.title: "Grounded Logistics"
	quest.050CA83360894D67.quest_desc: [
		"A blade turns that board into a real prep station."
		"The flint knife won't win awards, but it'll do."
	]
	quest.050CA83360894D67.title: "A Sharp Edge"
	quest.051FF35E02F84E7F.quest_desc: ["Sweeps nearby drops straight into the backpack as you walk."]
	quest.051FF35E02F84E7F.title: "Pickup Upgrade"
	quest.056EE4CE9D45F9D8.quest_desc: [
		"Warm brick for walls that feel lived-in."
		"Start with a batch of Scarlet Bricks."
	]
	quest.056EE4CE9D45F9D8.title: "Scarlet Brick Palette"
	quest.05724EB10D0707C6.quest_desc: ["Lets a train pick a direction - no junction works without one."]
	quest.05724EB10D0707C6.title: "Andesite Track Switch"
	quest.0581A3A5D5778DF1.quest_desc: [
		"Four iron blocks in a T, a carved pumpkin on top."
		"Summon an Iron Golem built to take a beating for your village."
	]
	quest.0581A3A5D5778DF1.title: "Iron Golem"
	quest.058C11005DEFB024.quest_desc: [
		"A sturdier coupler for heavier carriages."
		"Keeps the ride smooth when the load adds up."
	]
	quest.058C11005DEFB024.title: "Split Knuckle Coupler"
	quest.05BCFEE31929712D.quest_desc: [
		"A thousand Creepers. Nobody's builds have been safer."
		"This is a legendary tally."
	]
	quest.05BCFEE31929712D.title: "Creeper Bounty: Legend"
	quest.05DEFE37822DD884.quest_desc: [
		"When the season is wrong for a bed, hang a hammock and sleep under the eaves."
		"Comforts lets you skip the night without a full bedroom wherever you camp."
	]
	quest.05DEFE37822DD884.title: "A Hammock for Warm Nights"
	quest.05F7F2978684352E.quest_desc: [
		"Woodland spirits, shy at first."
		"A Whirlisprig charm coaxes one into staying close and speeding your growth."
	]
	quest.05F7F2978684352E.title: "Befriend a Whirlisprig"
	quest.05F99A41194E6670.quest_desc: [
		"Every ship needs somewhere official to call home."
		"Build an airship station as your hub for arrivals and departures."
	]
	quest.05F99A41194E6670.title: "Airship Station"
	quest.062CED1300D324C2.quest_desc: ["The deepslate version rounds out the whole lamp family nicely."]
	quest.062CED1300D324C2.title: "Deepslate Lamp"
	quest.0637B173CF3D325C.quest_desc: [
		"Rituals built for the farm, not the fight."
		"Fields grow faster, and reap themselves besides."
	]
	quest.0637B173CF3D325C.title: "Fertility and Harvest"
	quest.064DD81FAB9D5FF2.quest_desc: [
		"Two habits will save you hours out here."
		"Press U over an item for its recipe in JEI, and let Jade tell you what you're looking at."
	]
	quest.064DD81FAB9D5FF2.title: "Learn Your Tools"
	quest.0661C278F9D8CDC0.quest_desc: [
		"Not everything out there is common, and not every common thing behaves itself."
		"Something crossed your path and made you stop and stare."
	]
	quest.0661C278F9D8CDC0.title: "An Unusual Encounter"
	quest.0670F838C39AEAE7.quest_desc: [
		"Source Gems hum quietly near deposits of Sourcestone, holding the energy every spell will draw from."
		"Gather a handful to begin."
	]
	quest.0670F838C39AEAE7.title: "Gems of Source"
	quest.069DBC4792903DA6.quest_desc: [
		"Conjures decoys and vanishes mid-fight."
		"Trust nothing you see."
	]
	quest.069DBC4792903DA6.title: "Rare Encounter: Illusioner"
	quest.06E238E998307715.quest_desc: ["Soft, magic-soaked stone, gathered wherever Source Gems are found."]
	quest.06E238E998307715.title: "Sourcestone"
	quest.07035B8F3B344B39.quest_desc: ["A lockable spot to tuck away whatever you treasure most."]
	quest.07035B8F3B344B39.title: "Safe"
	quest.07140983EEA9CB07.quest_desc: [
		"A whole new set of kitchen tools begins here."
		"Craft a cutting board and start prepping."
	]
	quest.07140983EEA9CB07.title: "Pam's Cutting Board"
	quest.071E1F269983AA52.quest_desc: [
		"Ars Creo already lets Spell Turrets and Source Jars ride Create contraptions."
		"Park a turret on a bearing, give it a jar of Source, and fire while the machine moves. Check this off when you have tried it."
	]
	quest.071E1F269983AA52.title: "Turret on the Move"
	quest.072B581BA32BEFE3.quest_desc: ["Round out the table with a warm loaf of garlic bread."]
	quest.072B581BA32BEFE3.title: "Garlic Bread Feast"
	quest.0735CEF3A92891F7.quest_desc: ["Serious capacity for serious adventuring."]
	quest.0735CEF3A92891F7.title: "Diamond Backpack"
	quest.073CBB96F73A730D.quest_desc: [
		"A boot that seems to forget it's supposed to be heavy."
		"Whoever crafted these understood more than simple enchanting."
	]
	quest.073CBB96F73A730D.title: "Light as Air"
	quest.075A8473DF81F403.quest_desc: [
		"Wires a whole bank of drawers into one network."
		"The backbone of any storage room worth the name."
	]
	quest.075A8473DF81F403.title: "Drawer Controller"
	quest.07779FAE265B8B6F.quest_desc: [
		"Relics reveal themselves through use, not explanation."
		"Keep it on you. Try it in places you wouldn't expect."
	]
	quest.07779FAE265B8B6F.title: "Experiment"
	quest.07B87913A753F08A.quest_desc: [
		"A destination stopped mattering somewhere along the way - direction was always enough."
		"The map in your head has outgrown the one in your hand."
	]
	quest.07B87913A753F08A.title: "Seasoned Explorer"
	quest.07DB942C9A14B1C5.quest_desc: ["Cold, patient, and every bit as lethal as its fiery cousin."]
	quest.07DB942C9A14B1C5.title: "Slay an Ice Dragon"
	quest.07F2A6A118B83F03.quest_desc: [
		"Stolen from a nest perched somewhere no sane creature builds a home."
		"Raise it right and it will carry you further than your legs ever could."
	]
	quest.07F2A6A118B83F03.title: "Hippogryph Egg"
	quest.07F2E8E0EA3CF948.quest_desc: [
		"A book that only matters once its pages are full of things you actually lived through."
		"Yours has real weight to it now."
	]
	quest.07F2E8E0EA3CF948.title: "The Grimoire's Weight"
	quest.081E79E5745D4207.quest_desc: [
		"Caves and mountains hide something that hits like a falling tree."
		"Bring a troll down before it brings the ceiling down on you."
	]
	quest.081E79E5745D4207.title: "Rare Encounter: Troll"
	quest.0828EAF07499C0E3.quest_desc: ["A sturdier ladder for climbs that need a bit more backbone."]
	quest.0828EAF07499C0E3.title: "Iron Ladder"
	quest.0843F6D396186A7F.quest_desc: [
		"The payoff for the whole network: a Tesla Coil that lets"
		"your stored power go out with a bang."
	]
	quest.0843F6D396186A7F.title: "Tesla Coil"
	quest.084EAA328555DE36.quest_desc: [
		"Point it anywhere and feel the pull toward whatever biome you're chasing."
		"No more blind wandering, hoping the terrain agrees with you."
	]
	quest.084EAA328555DE36.title: "Nature's Compass"
	quest.0851CA83C2A3B7CF.quest_desc: ["Round out the table with a warm loaf of garlic bread."]
	quest.0851CA83C2A3B7CF.title: "Garlic Bread Feast"
	quest.087EBB058621ECD2.quest_desc: ["Dense storage for a single item, wired straight into the network."]
	quest.087EBB058621ECD2.title: "Filing Cabinet"
	quest.087FF89B652F55F3.quest_desc: [
		"A propeller in your hand is just a toy."
		"Mount it on a bearing and give a contraption something to drive."
	]
	quest.087FF89B652F55F3.title: "Mounted for Flight"
	quest.0886F815BBE28B4F.quest_desc: ["A lockable spot to tuck away whatever you treasure most."]
	quest.0886F815BBE28B4F.title: "Safe"
	quest.08902CEF744A9B72.quest_desc: [
		"A floating nether menace, all fire and fury."
		"Watch for the flames."
	]
	quest.08902CEF744A9B72.title: "Rare Encounter: Wildfire"
	quest.0894C0C6BBDF339D.quest_desc: [
		"Make a big batch and keep it close."
		"A bucket of stew never goes to waste."
	]
	quest.0894C0C6BBDF339D.title: "Stew by the Bucket"
	quest.0899BAA5BD9ED25C.quest_desc: [
		"A simple wooden propeller doesn't look like much."
		"But it's the same part that ends up carrying entire flying bases."
	]
	quest.0899BAA5BD9ED25C.title: "A Taste of the Skies"
	quest.089DD38FF44472B5.quest_desc: [
		"Finish it off and you've got the core logic chip every"
		"advanced block in this network needs."
	]
	quest.089DD38FF44472B5.title: "Control Chip"
	quest.08AE162D739422E1.quest_desc: ["Stops a train dead at the end of the line, no drama."]
	quest.08AE162D739422E1.title: "Track Buffer"
	quest.08AEF6C219D57ED0.quest_desc: [
		"A contraption that actually leaves the ground, and airspace you can finally call yours."
		"The sky was never really closed off. It just took you a while to get up there."
	]
	quest.08AEF6C219D57ED0.title: "Claimed Skies"
	quest.08AFD9F9B7DAC226.quest_desc: [
		"A full stomach keeps you sprinting, jumping, healing - all of it."
		"Cook something simple and eat."
	]
	quest.08AFD9F9B7DAC226.title: "Fill Your Belly"
	quest.08BBBC8F46E3AB93.quest_desc: [
		"A full chestplate demanding fire, ice, and lightning all pay their toll first."
		"You don't wear this until three different dragons have already tried to stop you."
	]
	quest.08BBBC8F46E3AB93.title: "Fire Dragonsteel Chestplate"
	quest.08D8D042A9FE0ADE.quest_desc: ["Matching slabs and stairs round the set out nicely."]
	quest.08D8D042A9FE0ADE.title: "Brick Shapes"
	quest.08D9F3F187EE3247.quest_desc: [
		"Every good kitchen starts somewhere simple."
		"A cutting board's as good a start as any."
	]
	quest.08D9F3F187EE3247.title: "The Cutting Board"
	quest.08F21A28A72B8C0F.quest_desc: [
		"Bolt one onto a Grindstone and reclaim the XP you'd"
		"otherwise waste disenchanting gear."
	]
	quest.08F21A28A72B8C0F.title: "Grindstone Drain"
	quest.08FC820701C45704.quest_desc: [
		"Copper's cheap and you've got plenty of it."
		"Start your tool line here."
	]
	quest.08FC820701C45704.title: "Copper Tools"
	quest.0912E5EFA2A3850E.quest_desc: ["A hundred down. You don't flinch at cobwebs anymore."]
	quest.0912E5EFA2A3850E.title: "Spider Bounty: Expert"
	quest.09157E29D3ED06C6.quest_desc: [
		"Copper's cheap and you've got plenty of it."
		"Start your tool line here."
	]
	quest.09157E29D3ED06C6.title: "Copper Tools"
	quest.091FE285CD7F0F31.quest_desc: [
		"Something you barely understood at first, now humming along because you willed it to."
		"It runs because you made it run."
	]
	quest.091FE285CD7F0F31.title: "Engine of Ambition"
	quest.092634D325DE7350.quest_desc: ["Seals out the water so you can actually get work done down there."]
	quest.092634D325DE7350.title: "Diving Helmet"
	quest.09278B941DBEF6AB.quest_desc: [
		"A homestead's better with some company in the pasture."
		"Fence in a few animals and look after them."
	]
	quest.09278B941DBEF6AB.title: "Livestock and Care"
	quest.093E78ACB5D13EDC.quest_desc: [
		"There's more swimming out there than you'd think."
		"Grab a rod and find out what's biting."
	]
	quest.093E78ACB5D13EDC.title: "Cast a Line"
	quest.09469F58206EB4CA.quest_desc: [
		"One panel, the whole network."
		"Monitor and control everything from a single dashboard."
	]
	quest.09469F58206EB4CA.title: "Dashboard"
	quest.094BB93FFDDC9281.quest_desc: [
		"Forged from a storm given shape, and then given a heart."
		"It hums faintly, like it's still deciding whether to strike."
	]
	quest.094BB93FFDDC9281.title: "Lightning Dragonsteel Ingot"
	quest.0952B98FA16E0FD8.quest_desc: [
		"Hidden structures don't advertise themselves - this one finds them anyway."
		"Aim it at a rumor and start walking."
	]
	quest.0952B98FA16E0FD8.title: "Explorer's Compass"
	quest.095A329F1C751AA2.quest_desc: [
		"A heart, a forge, and heat most things wouldn't survive."
		"What comes out the other side is close to unbreakable."
	]
	quest.095A329F1C751AA2.title: "Fire Dragonsteel Ingot"
	quest.09760243FE2D6B26.quest_desc: [
		"Every good kitchen starts somewhere simple."
		"A cutting board's as good a start as any."
	]
	quest.09760243FE2D6B26.title: "The Cutting Board"
	quest.098745C7FEEC6827.quest_desc: ["A lockable spot to tuck away whatever you treasure most."]
	quest.098745C7FEEC6827.title: "Safe"
	quest.0992760A4AD186B4.quest_desc: [
		"Crew need somewhere that is not a plank."
		"Fit a seat before the first long voyage."
	]
	quest.0992760A4AD186B4.title: "A Place to Sit"
	quest.0993C3797D7E2DF5.quest_desc: ["Keeps the fire fed - no fuel, no steam."]
	quest.0993C3797D7E2DF5.title: "Fuel Tank"
	quest.09A561CED1F9EA36.quest_desc: ["The upgrade: a scroll bound for good, always ready for that one trip."]
	quest.09A561CED1F9EA36.title: "Bound Scroll"
	quest.0A195EECA9A58D1A.quest_desc: [
		"Knife and board together make quick work of dinner prep."
		"Cod slices are a fine place to start."
	]
	quest.0A195EECA9A58D1A.title: "Slice It Up"
	quest.0A20B9B44071FB2A.quest_desc: [
		"A simple wooden propeller doesn't look like much."
		"But it's the same part that ends up carrying entire flying bases."
	]
	quest.0A20B9B44071FB2A.title: "A Taste of the Skies"
	quest.0A61DCF8E4889C15.quest_desc: ["A low brick wall gives the yard a tidy edge."]
	quest.0A61DCF8E4889C15.title: "Brick Wall"
	quest.0ACB99D512F6B07C.quest_desc: ["Bumps up the stack size on everything stored inside."]
	quest.0ACB99D512F6B07C.title: "Stack Upgrade Tier 1"
	quest.0ACD88717821EC73.quest_desc: ["Prudentium tools bite far deeper than Inferium ever could."]
	quest.0ACD88717821EC73.title: "Prudentium Gear"
	quest.0AE4C0D810DB00E0.quest_desc: [
		"A Source Gem hums faintly in your hand."
		"It's the first spark of something much bigger."
	]
	quest.0AE4C0D810DB00E0.title: "A Taste of Magic"
	quest.0AFF62D0FAB84903.quest_desc: ["Fifty down. Caves are a little less rattly now."]
	quest.0AFF62D0FAB84903.title: "Skeleton Bounty: Veteran"
	quest.0B026D8E657D3647.quest_desc: [
		"Some of what you've found doesn't just feel powerful."
		"It feels arcane. Deliberate. Like it was made, not found. Somewhere, there may be an explanation."
	]
	quest.0B026D8E657D3647.title: "Something Stranger Still"
	quest.0B2545D1F344F5DE.quest_desc: ["Nut trees like walnut are worth the wait, come roasting time."]
	quest.0B2545D1F344F5DE.title: "Walnut Trees"
	quest.0B45875342C3F9D3.quest_desc: [
		"Forged from Brass, roughly Iron-grade."
		"A solid mid-tier set while you work toward Blazing."
	]
	quest.0B45875342C3F9D3.title: "Brass Tools"
	quest.0B4A82D6F54A3661.quest_desc: [
		"Every journey starts with a chopped log and a rough set of tools."
		"Nothing fancy - just enough to get moving."
	]
	quest.0B4A82D6F54A3661.title: "First Tools"
	quest.0B89117BC18E8B99.quest_desc: ["Fry, sear, and get creative with what the stove can do."]
	quest.0B89117BC18E8B99.title: "The Skillet"
	quest.0BAF8EFA0D0B6B47.quest_desc: [
		"Feed it Blaze Cake and it superheats whatever's sitting above it."
		"Unlocks the hotter alloying recipes, Brass included."
	]
	quest.0BAF8EFA0D0B6B47.title: "Blaze Burner"
	quest.0BBB6FD49D10C34C.quest_desc: ["A wall-mounted light that warms up any hallway."]
	quest.0BBB6FD49D10C34C.title: "Sconce"
	quest.0BD7F282D86D98C2.quest_desc: [
		"A pale ore veined through the deep rock, waiting to be melted down."
		"The first ingredient in gear built for things that don't die easy."
	]
	quest.0BD7F282D86D98C2.title: "Silver Ore"
	quest.0BF465B8317D0842.quest_desc: ["Stops a train dead at the end of the line, no drama."]
	quest.0BF465B8317D0842.title: "Track Buffer"
	quest.0BF84D9974485653.quest_desc: [
		"Forged from a storm given shape, and then given a heart."
		"It hums faintly, like it's still deciding whether to strike."
	]
	quest.0BF84D9974485653.title: "Lightning Dragonsteel Ingot"
	quest.0C0828B1276FFDA4.quest_desc: ["Sucks matching drops off the floor straight into the drawer."]
	quest.0C0828B1276FFDA4.title: "Magnet Upgrade"
	quest.0C08DB6B16857AD8.quest_desc: [
		"Not everything you move needs to leave the ground."
		"Build a train station alongside your airship station for cargo that's happy to stay earthbound."
	]
	quest.0C08DB6B16857AD8.title: "Grounded Logistics"
	quest.0C1AC066CC8AA237.quest_desc: [
		"Every explorer starts leaving their own trail of shortcuts and landmarks eventually."
		"You may already have a Waystone or two out there without calling it anything special."
	]
	quest.0C1AC066CC8AA237.title: "Marks on the Map"
	quest.0C24A82285B386CE.quest_desc: [
		"Forged from a storm given shape, and then given a heart."
		"It hums faintly, like it's still deciding whether to strike."
	]
	quest.0C24A82285B386CE.title: "Lightning Dragonsteel Ingot"
	quest.0C52F3F2593AEC79.quest_desc: ["Let a machine take over the slicing, so your hands are free for everything else."]
	quest.0C52F3F2593AEC79.title: "The Mechanical Cutter"
	quest.0C803E06CEE97366.quest_desc: ["Fifty. Even the caves feel less crawly."]
	quest.0C803E06CEE97366.title: "Spider Bounty: Veteran"
	quest.0C85035F67A708E9.quest_desc: [
		"A blade carved from the bones of something that used to be unstoppable."
		"Your first real answer to dragon country."
	]
	quest.0C85035F67A708E9.title: "Dragon Bone Sword"
	quest.0C893EDAC589CD7A.quest_desc: ["Cast from prismarine alloy - the first component you'll reach for in most aquatic builds."]
	quest.0C893EDAC589CD7A.title: "Prismarine Alloy Rod"
	quest.0C934CB626F5F43D.quest_desc: ["Set an Infusion Crystal spinning, and Inferium climbs one step further into Prudentium."]
	quest.0C934CB626F5F43D.title: "Prudentium Tier"
	quest.0C9483F70C4CF79F.quest_desc: [
		"A hearty root crop worth keeping in the pantry."
		"Plant a few and let them settle in."
	]
	quest.0C9483F70C4CF79F.title: "Plant Sweet Potatoes"
	quest.0CB11AF2EFCA309B.quest_desc: [
		"Every good dish needs an onion nearby."
		"Grow a patch of your own."
	]
	quest.0CB11AF2EFCA309B.title: "Growing Onions"
	quest.0CEA5DC6C7568E47.quest_desc: [
		"The stove is the heart of a proper kitchen."
		"It's what gets the skillet going."
	]
	quest.0CEA5DC6C7568E47.title: "Fire Up the Stove"
	quest.0CEBBE600988488B.quest_desc: ["A little zinc fencing keeps things secure, and still looks the part."]
	quest.0CEBBE600988488B.title: "Bars and Mesh Fences"
	quest.0CFEE6E50F5045F2.quest_desc: [
		"Not a drop of steam in sight, and your engine runs anyway."
		"A real milestone in self-contained power."
	]
	quest.0CFEE6E50F5045F2.title: "Steamless Engine"
	quest.0D178BD7C66EB274.quest_desc: ["Keeps an eye out for anything living that wanders past."]
	quest.0D178BD7C66EB274.title: "Ender Watcher"
	quest.0D1D87B6C53EF08A.quest_desc: ["Soft, magic-soaked stone, gathered wherever Source Gems are found."]
	quest.0D1D87B6C53EF08A.title: "Sourcestone"
	quest.0D2FB4CE0DFC973E.quest_desc: [
		"A thousand fallen. You've earned the quiet nights."
		"Maximum Smite, and a scrap of the Nether's toughest metal."
	]
	quest.0D2FB4CE0DFC973E.title: "Zombie Bounty: Legend"
	quest.0D3DBB249CCE7F9A.quest_desc: [
		"The Basin catches items and fluids; the Mixer stirs them together."
		"Between the two, half your crafting table becomes obsolete."
	]
	quest.0D3DBB249CCE7F9A.title: "Basin \\& Mechanical Mixer"
	quest.0D5F7DB37678F778.quest_desc: ["Beyond Supremium lies something Awakened - reachable only through a second, stranger altar."]
	quest.0D5F7DB37678F778.title: "The Awakening Altar"
	quest.0D6D5590F1AFAD7D.quest_desc: [
		"A garden's better with a bit of red in it."
		"Get some tomato seeds in the ground."
	]
	quest.0D6D5590F1AFAD7D.title: "Growing Tomatoes"
	quest.0D732C37BD768E79.quest_desc: [
		"Straps on over your chestplate and speeds up mining"
		"and movement both. Your first taste of powered gear."
	]
	quest.0D732C37BD768E79.title: "Copper Exoskeleton"
	quest.0D7F1330BDEDAD93.quest_desc: ["Only one tier of gear now stands between you and Supremium."]
	quest.0D7F1330BDEDAD93.title: "Imperium Gear"
	quest.0D88303F4695D6A0.quest_desc: [
		"Shed scales, still warm, gathered where dragons rest or fall."
		"Light enough to move in, tough enough to matter."
	]
	quest.0D88303F4695D6A0.title: "Dragon Scales"
	quest.0D8CDBFCEDB799F5.quest_desc: [
		"Regulates current flow for the heavier machinery"
		"further down the line."
	]
	quest.0D8CDBFCEDB799F5.title: "Capacitor"
	quest.0DAEFD97E16FE9D9.quest_desc: ["A handful of walnuts, roasted into a good little snack."]
	quest.0DAEFD97E16FE9D9.title: "Roasted Walnuts"
	quest.0DF420B235CC5469.quest_desc: [
		"Stolen from a nest perched somewhere no sane creature builds a home."
		"Raise it right and it will carry you further than your legs ever could."
	]
	quest.0DF420B235CC5469.title: "Hippogryph Egg"
	quest.0E13077C86FE6D2D.quest_desc: [
		"A wand and a little stored Source are enough to bind your first spell book."
		"Simple glyphs, simple experiments."
	]
	quest.0E13077C86FE6D2D.title: "Novice Spell Book"
	quest.0E1831CD5D6AFB3B.quest_desc: [
		"A thousand Creepers. Nobody's builds have been safer."
		"This is a legendary tally."
	]
	quest.0E1831CD5D6AFB3B.title: "Creeper Bounty: Legend"
	quest.0E3D6B33D039F757.quest_desc: ["A hundred archers who never got a shot off worth remembering."]
	quest.0E3D6B33D039F757.title: "Skeleton Bounty: Expert"
	quest.0E4978C43C438D2D.quest_desc: ["Bottle Source in a jar, and you're no longer tethered to the deposit that made it."]
	quest.0E4978C43C438D2D.title: "Storing Source"
	quest.0E51A5018619BE5E.quest_desc: [
		"Stripped off an aggressive reef dweller."
		"Tougher than it looks, and worth the fight."
	]
	quest.0E51A5018619BE5E.title: "Spiky Shell"
	quest.0E88CF2F3F8B57A8.quest_desc: ["Beyond Supremium lies something Awakened - reachable only through a second, stranger altar."]
	quest.0E88CF2F3F8B57A8.title: "The Awakening Altar"
	quest.0E915336A74107CB.quest_desc: ["Top-tier capacity, for when you're storing by the thousands."]
	quest.0E915336A74107CB.title: "Diamond Upgrade"
	quest.0EB4B0A2074B31D5.quest_desc: ["Essence sharpens as well as it grows. Forge a pick and blade to call the first tier mastered."]
	quest.0EB4B0A2074B31D5.title: "Tools of Essence"
	quest.0EBD8DCC4BC30281.quest_desc: ["A cupboard and drawer keep the clutter out of sight."]
	quest.0EBD8DCC4BC30281.title: "Storage Furniture"
	quest.0EC313C5FB410213.quest_desc: ["Sucks matching drops off the floor straight into the drawer."]
	quest.0EC313C5FB410213.title: "Magnet Upgrade"
	quest.0EE4B033BDEB1643.quest_desc: [
		"A Shovel for digging, a Cleaver for mobs -"
		"rounds out the Blazing set nicely."
	]
	quest.0EE4B033BDEB1643.title: "Blazing Shovel \\& Cleaver"
	quest.0EEDD36A579D7DFC.quest_desc: [
		"Every hunter starts somewhere."
		"Put down a single Creeper."
	]
	quest.0EEDD36A579D7DFC.title: "Creeper Bounty: Novice"
	quest.0F0D137D2F6E9DF0.quest_desc: ["For the angler who's serious about it. A diamond rod earns its keep."]
	quest.0F0D137D2F6E9DF0.title: "Diamond Fishing Rod"
	quest.0F1BA90678F5BE0E.quest_desc: [
		"Crack the ore, or grow it from seed - either way, essence pools in your hands."
		"Nearly everything ahead starts with this."
	]
	quest.0F1BA90678F5BE0E.title: "Inferium Essence"
	quest.0F1D23F548BB06FF.quest_desc: ["Ten fewer things that go boom near your builds."]
	quest.0F1D23F548BB06FF.title: "Creeper Bounty: Apprentice"
	quest.0F33E4BEEE239CF6.quest_desc: [
		"Straps on over your chestplate and speeds up mining"
		"and movement both. Your first taste of powered gear."
	]
	quest.0F33E4BEEE239CF6.title: "Copper Exoskeleton"
	quest.0F3F8931D68B405D.quest_desc: [
		"A book that only matters once its pages are full of things you actually lived through."
		"Yours has real weight to it now."
	]
	quest.0F3F8931D68B405D.title: "The Grimoire's Weight"
	quest.0F46B2433A6CCAFE.quest_desc: [
		"Goblins never give anything away for free, but they'll always make a deal."
		"Trade with a Goblin Trader and see what they're carrying."
	]
	quest.0F46B2433A6CCAFE.title: "Strike a Deal"
	quest.0F57342D2908C188.quest_desc: [
		"Some of what you've found doesn't just feel powerful."
		"It feels arcane. Deliberate. Like it was made, not found. Somewhere, there may be an explanation."
	]
	quest.0F57342D2908C188.title: "Something Stranger Still"
	quest.0F5F5C2A91ED8CF1.quest_desc: [
		"Melt a brick down into a proper drink."
		"A fitting reward for a fully automated cocoa line."
	]
	quest.0F5F5C2A91ED8CF1.title: "Hot Chocolate"
	quest.0F88DD54B326CF7C.quest_desc: [
		"Goblins never give anything away for free, but they'll always make a deal."
		"Trade with a Goblin Trader and see what they're carrying."
	]
	quest.0F88DD54B326CF7C.title: "Strike a Deal"
	quest.0F91B4BCC9E31238.quest_desc: ["A handful of walnuts, roasted into a good little snack."]
	quest.0F91B4BCC9E31238.title: "Roasted Walnuts"
	quest.0FA2089FE521199C.quest_desc: [
		"Melt a brick down into a proper drink."
		"A fitting reward for a fully automated cocoa line."
	]
	quest.0FA2089FE521199C.title: "Hot Chocolate"
	quest.0FA8613167067EB4.quest_desc: [
		"Not everything in the garden is for eating."
		"Cotton grows well alongside the rest."
	]
	quest.0FA8613167067EB4.title: "Harvest Cotton"
	quest.0FC0CBBD0451C172.quest_desc: [
		"A plain lamp that only glows when you flick a switch for it."
		"Perfect for a hidden light you control from elsewhere."
	]
	quest.0FC0CBBD0451C172.title: "Stone Lamp"
	quest.0FEA68DC0569363B.quest_desc: [
		"The last guardian of the End, and one of the oldest fights in the game."
		"Bring it down."
	]
	quest.0FEA68DC0569363B.title: "Slay the Ender Dragon"
	quest.101CC8983543C03B.quest_desc: ["Thick, meaty, and just the thing after a long day's work."]
	quest.101CC8983543C03B.title: "Hearty Beef Stew"
	quest.10227DEAF3E86FED.quest_desc: [
		"The basics of flight are behind you - now, where are you actually going?"
		"Craft a navigation table and start plotting real courses."
	]
	quest.10227DEAF3E86FED.title: "Charting Your Course"
	quest.102422D334C65A53.quest_desc: [
		"The relics you've encountered don't appear to be isolated curiosities."
		"Some share signs of a distinctly arcane origin. Somewhere in the world there may be an explanation."
	]
	quest.102422D334C65A53.title: "Something Doesn't Add Up"
	quest.102B54FD23A98C0C.quest_desc: ["Fifty down. Caves are a little less rattly now."]
	quest.102B54FD23A98C0C.title: "Skeleton Bounty: Veteran"
	quest.1041DBC952A1B5A3.quest_desc: [
		"A heated Mixer can fold amethyst or lapis with Sourceberries into Source Gems."
		"It does not replace Imbuement for speed, but it is a farm you can pipe."
	]
	quest.1041DBC952A1B5A3.title: "Gems Without the Chamber"
	quest.10446F93E1055493.quest_desc: [
		"A matched pair sends rotational power wirelessly."
		"Run machinery clear across your base without laying a single shaft."
	]
	quest.10446F93E1055493.title: "Kinetic Bridge"
	quest.1050FB7AB3354B15.quest_desc: ["A hundred. The End itself is starting to feel routine."]
	quest.1050FB7AB3354B15.title: "Enderman Bounty: Expert"
	quest.10796C8121EEC3BD.quest_desc: [
		"Raw levitite is too unstable to use as-is."
		"Blend it down into the base ingredient for a whole class of anti-gravity gear."
	]
	quest.10796C8121EEC3BD.title: "Refining Levitite"
	quest.107CE122C71E52EE.quest_desc: ["After enough seasons of farming and building, it all starts to come naturally."]
	quest.107CE122C71E52EE.title: "A Grower's Instinct"
	quest.1097123E8A3F02F1.quest_desc: ["Brass catwalks and railings keep you steady above it all."]
	quest.1097123E8A3F02F1.title: "Catwalks and Railings"
	quest.109CBFF3E79DC312.quest_desc: ["A Portstone travels light - all the convenience, none of the bulk."]
	quest.109CBFF3E79DC312.title: "Portstone"
	quest.10C0293E59226CB2.quest_desc: ["Bolts onto the front of the frame, channeling exhaust clear of the boiler."]
	quest.10C0293E59226CB2.title: "Locometal Smokebox"
	quest.10ECE028BB684E49.quest_desc: [
		"A Storage Terminal doesn't care if the inventory behind it is bolted down."
		"Slap one onto a moving Create contraption, and your network follows the machine instead of the other way around."
	]
	quest.10ECE028BB684E49.title: "Terminals on the Move"
	quest.10EDD5389140E1AD.quest_desc: ["Simmer your tomatoes down into something worth saving."]
	quest.10EDD5389140E1AD.title: "Tomato Sauce"
	quest.10F274DCFB23E83F.quest_desc: [
		"Refined Radiance and Shadow Steel, fused into a component your"
		"logic and display setups will lean on."
	]
	quest.10F274DCFB23E83F.title: "Electron Tube"
	quest.1103DAA56D71F696.quest_desc: ["Head out where the water runs deep. Tuna are waiting."]
	quest.1103DAA56D71F696.title: "Deep Water Catch"
	quest.1114BB7B801CAACF.quest_desc: [
		"Crack the ore, or grow it from seed - either way, essence pools in your hands."
		"Nearly everything ahead starts with this."
	]
	quest.1114BB7B801CAACF.title: "Inferium Essence"
	quest.1119FA0C88831E5B.quest_desc: ["Ten fewer things that go boom near your builds."]
	quest.1119FA0C88831E5B.title: "Creeper Bounty: Apprentice"
	quest.11331A611DDA90E9.quest_desc: ["A little stand to show off your favorite hat by the door."]
	quest.11331A611DDA90E9.title: "Hat Stand"
	quest.114EE7F148A0D253.quest_desc: [
		"Warm brick for walls that feel lived-in."
		"Start with a batch of Scarlet Bricks."
	]
	quest.114EE7F148A0D253.title: "Scarlet Brick Palette"
	quest.1153882F6BD6B43D.quest_desc: ["Every home needs somewhere to sit down."]
	quest.1153882F6BD6B43D.title: "Take a Seat"
	quest.1174C90FB254AB0E.quest_desc: [
		"Every item, every bit of experience you pick up now announces itself quietly at the edge of the screen."
		"No more wondering what that pile of drops just added to your inventory."
	]
	quest.1174C90FB254AB0E.title: "Every Pickup, Noted"
	quest.117B8AFB8B0F7E1A.quest_desc: [
		"Plays a sound of your choosing when the signal comes through."
		"Pair it with the relayer for a doorbell or a dinner call."
	]
	quest.117B8AFB8B0F7E1A.title: "Speaker Block"
	quest.1193C587E9F5297A.quest_desc: ["Carve Sourcestone into a Pedestal - the seed of your future Enchanting Apparatus."]
	quest.1193C587E9F5297A.title: "Arcane Pedestal"
	quest.11B04E3E25D9E622.quest_desc: ["Imperium Essence glows brighter than anything before it - and the climb still isn't over."]
	quest.11B04E3E25D9E622.title: "Imperium Tier"
	quest.11B4C210532C05AC.quest_desc: [
		"Eight legs, bad attitude."
		"Deal with one."
	]
	quest.11B4C210532C05AC.title: "Spider Bounty: Novice"
	quest.11C16D4C61E49D74.quest_desc: [
		"Dresses drawers up with trim and matching materials."
		"For when function needs to look good too."
	]
	quest.11C16D4C61E49D74.title: "Framing Table"
	quest.11D27C0B7B1F0BEF.quest_desc: ["Scrape it up off the seabed - it's the starting point for every prismarine alloy you'll cast."]
	quest.11D27C0B7B1F0BEF.title: "Calcium Rich Powder"
	quest.11F1AD29A53FFF2A.quest_desc: [
		"One slot, one item, no fuss."
		"Your first step into Functional Storage."
	]
	quest.11F1AD29A53FFF2A.title: "Oak Drawer (1x1)"
	quest.1230A587F2AB124D.quest_desc: ["One swing clears a 3x3 patch, so tunnels go a lot faster."]
	quest.1230A587F2AB124D.title: "Hammer"
	quest.12353B310E640620.quest_desc: ["Serious capacity for serious adventuring."]
	quest.12353B310E640620.title: "Diamond Backpack"
	quest.1242D664BF8C941E.quest_desc: ["Gathers up loose seeds as you tend the fields, so you don't have to."]
	quest.1242D664BF8C941E.title: "Seed Pouch"
	quest.125D1D389B2020C7.quest_desc: ["Seals out the water so you can actually get work done down there."]
	quest.125D1D389B2020C7.title: "Diving Helmet"
	quest.1277E0F8BD21BAA8.quest_desc: [
		"A Shovel for digging, a Cleaver for mobs -"
		"rounds out the Blazing set nicely."
	]
	quest.1277E0F8BD21BAA8.title: "Blazing Shovel \\& Cleaver"
	quest.1288DAB469F647E3.quest_desc: ["A sturdier ladder for climbs that need a bit more backbone."]
	quest.1288DAB469F647E3.title: "Iron Ladder"
	quest.129901BD24B82CCC.quest_desc: [
		"Not everything out there is common, and not every common thing behaves itself."
		"Something crossed your path and made you stop and stare."
	]
	quest.129901BD24B82CCC.title: "An Unusual Encounter"
	quest.12AE01266D4F936F.quest_desc: ["Thick, meaty, and just the thing after a long day's work."]
	quest.12AE01266D4F936F.title: "Hearty Beef Stew"
	quest.12BA5A8E31EBA1F0.quest_desc: [
		"Sky raiders looking to make your airship their next target."
		"Fitting, if you've taken to the skies yourself."
	]
	quest.12BA5A8E31EBA1F0.title: "Rare Encounter: Pillager Aviator"
	quest.12DA6876342EAE11.quest_desc: ["A crossbow means the raiders never even reach you."]
	quest.12DA6876342EAE11.title: "Ranged Defense"
	quest.12E06C708815F938.quest_desc: [
		"An iron rod holds up longer and finds better luck."
		"Worth the upgrade."
	]
	quest.12E06C708815F938.title: "Iron Fishing Rod"
	quest.12EFC4209184BFE9.quest_desc: [
		"Forged in fire that used to belong to something with wings."
		"Among the fiercest things you can carry into a fight."
	]
	quest.12EFC4209184BFE9.title: "Fire Dragonsteel Sword"
	quest.12F6926F8EF14010.quest_desc: ["Cold, patient, and every bit as lethal as its fiery cousin."]
	quest.12F6926F8EF14010.title: "Slay an Ice Dragon"
	quest.130CE70EA598414D.quest_desc: [
		"Flying in a straight line is easy - turning is another matter."
		"Craft a steering wheel and take real control."
	]
	quest.130CE70EA598414D.title: "Steering Wheel"
	quest.1333BB19146AA19B.quest_desc: [
		"A wood-matched chest for whichever room it lands in."
		"Start the collection with a simple Oak Chest."
	]
	quest.1333BB19146AA19B.title: "Variant Chest"
	quest.1388924766753EC3.quest_desc: [
		"Arm a villager with a sword and they may take up the guard's life."
		"You do not need a spawn egg - convert someone who already lives in your village."
	]
	quest.1388924766753EC3.title: "Hire a Guard"
	quest.13C01977A932FB34.quest_desc: [
		"Raise a shield, and you're already thinking like an adventurer."
		"Combat out here rewards more than just swinging harder."
	]
	quest.13C01977A932FB34.title: "A Taste of Adventure"
	quest.13CBC2C140C449B5.quest_desc: [
		"Look at everything behind you now - what you fought, what you learned, what you built, how far you wandered."
		"None of it was required. You did it anyway, and that's the whole point."
	]
	quest.13CBC2C140C449B5.title: "A Life Well Built"
	quest.13CBF2241FE92BA4.quest_desc: ["Serves no purpose at all, and somehow that's exactly the charm."]
	quest.13CBF2241FE92BA4.title: "Tiny Potato"
	quest.13E875ABEC2AC77B.quest_desc: ["Fancy a cooler look? Try a batch of Blue Bricks instead."]
	quest.13E875ABEC2AC77B.title: "Blue Brick Palette"
	quest.13F41B057DA317E5.quest_desc: ["A little stand to show off your favorite hat by the door."]
	quest.13F41B057DA317E5.title: "Hat Stand"
	quest.1427E689288BDC95.quest_desc: [
		"Bolt one onto a Grindstone and reclaim the XP you'd"
		"otherwise waste disenchanting gear."
	]
	quest.1427E689288BDC95.title: "Grindstone Drain"
	quest.1452018A586B6E36.quest_desc: [
		"Fifty and counting. You've got a rhythm for this now."
		"A Smite charm, for the undead that still give you trouble."
	]
	quest.1452018A586B6E36.title: "Zombie Bounty: Veteran"
	quest.1468525BC50763E3.quest_desc: [
		"There's no shortage of things to grow here."
		"Start easy, with a row of tomatoes."
	]
	quest.1468525BC50763E3.title: "Plant Tomatoes"
	quest.146C662DAF712BD2.quest_desc: [
		"Every journey starts with a chopped log and a rough set of tools."
		"Nothing fancy - just enough to get moving."
	]
	quest.146C662DAF712BD2.title: "First Tools"
	quest.1471A113472B0F27.quest_desc: [
		"Timing beats mashing every time."
		"Chain your strikes together and land a combo on something that deserves it."
	]
	quest.1471A113472B0F27.title: "Chain Your Strikes"
	quest.148AC5C68637DFBB.quest_desc: ["The deepslate version rounds out the whole lamp family nicely."]
	quest.148AC5C68637DFBB.title: "Deepslate Lamp"
	quest.14A128F9CAFEF655.quest_desc: [
		"Every good kitchen starts somewhere simple."
		"A cutting board's as good a start as any."
	]
	quest.14A128F9CAFEF655.title: "The Cutting Board"
	quest.14C73E4FA00B035B.quest_desc: [
		"The payoff for the whole network: a Tesla Coil that lets"
		"your stored power go out with a bang."
	]
	quest.14C73E4FA00B035B.title: "Tesla Coil"
	quest.14C83905FD8DEA80.quest_desc: [
		"Cold even in your hand, taken from a dragon that never once blinked."
		"The Ice Dragonsteel line begins here - but it starts with a kill."
	]
	quest.14C83905FD8DEA80.title: "Heart of an Ice Dragon"
	quest.14E08C4049AFFBE2.quest_desc: [
		"A Storage Terminal doesn't care if the inventory behind it is bolted down."
		"Slap one onto a moving Create contraption, and your network follows the machine instead of the other way around."
	]
	quest.14E08C4049AFFBE2.title: "Terminals on the Move"
	quest.14EF6F6263D22491.quest_desc: [
		"A brass shell waiting to be filled."
		"On its own it already holds a modest enchanting boost."
	]
	quest.14EF6F6263D22491.title: "Incomplete Brass Bookshelf"
	quest.151F213E9A29ACA4.quest_desc: [
		"Every wood type gets its own bookshelf, lighted variants included."
		"No more oak shelves clashing with a spruce study."
	]
	quest.151F213E9A29ACA4.title: "A Shelf That Fits"
	quest.1530BB8D3A01BC93.quest_desc: [
		"Walk far enough and the world keeps changing its mind about what it wants to be."
		"A handful of biomes that felt like a different planet entirely."
	]
	quest.1530BB8D3A01BC93.title: "A World of Many Faces"
	quest.1533CC1C6EEC17C5.quest_desc: ["Oak track, plain and sturdy - every railway starts with a length of this underfoot."]
	quest.1533CC1C6EEC17C5.title: "Lay Some Track"
	quest.15340506648F57DE.quest_desc: ["Every finished dish starts by bringing ingredients together in a bowl."]
	quest.15340506648F57DE.title: "The Mixing Bowl"
	quest.155F3B7B60153F02.quest_desc: ["Turn fruit from the orchard into something worth drinking."]
	quest.155F3B7B60153F02.title: "The Juicer"
	quest.156C136E6569332A.quest_desc: [
		"Basic powered flight, running on the same steam"
		"engineering as the rest of Create. Not fast, but it flies."
	]
	quest.156C136E6569332A.title: "Copper Jetpack"
	quest.158047902E58025E.quest_desc: [
		"A plain lamp that only glows when you flick a switch for it."
		"Perfect for a hidden light you control from elsewhere."
	]
	quest.158047902E58025E.title: "Stone Lamp"
	quest.158D8CEC9889619E.quest_desc: ["Longer, cleverer spells need a sturdier book. The Mage's Spell Book obliges."]
	quest.158D8CEC9889619E.title: "Mage's Spell Book"
	quest.159ED9A1D07FA151.quest_desc: ["More room, more upgrade slots - a solid step up from the basic pack."]
	quest.159ED9A1D07FA151.title: "Iron Backpack"
	quest.15B4A3039F4A5D97.quest_desc: [
		"Flick it out to mine a block and it comes right back to you."
		"Handy for that one ore you can never quite reach."
	]
	quest.15B4A3039F4A5D97.title: "Pickarang"
	quest.15B76B33640F3EEE.quest_desc: [
		"Chipped reskins storage and furniture into hundreds of wood-matched variants."
		"Start simple: a barrel that actually matches the rest of the room."
	]
	quest.15B76B33640F3EEE.title: "A Proper Barrel"
	quest.15C346839FBDFBBF.quest_desc: [
		"Smelt the Zinc, mix it with Copper in the Mixer, and you've"
		"got Brass - the metal the rest of this pack runs on."
	]
	quest.15C346839FBDFBBF.title: "Zinc and Brass"
	quest.15DC6090CAF8361D.quest_desc: [
		"The ocean keeps its best secrets where the light gives up."
		"Bring something back worth telling people about."
	]
	quest.15DC6090CAF8361D.title: "Beneath the Waves"
	quest.15DE27431248FA7E.quest_desc: [
		"Torn from a dragon's kill, or scavenged from the bones littering its lair."
		"The foundation of a whole arsenal built to survive what's coming."
	]
	quest.15DE27431248FA7E.title: "Dragon Bone"
	quest.162A1206ECFA1B5C.quest_desc: [
		"A full chestplate demanding fire, ice, and lightning all pay their toll first."
		"You don't wear this until three different dragons have already tried to stop you."
	]
	quest.162A1206ECFA1B5C.title: "Fire Dragonsteel Chestplate"
	quest.164D9BB2574BDBA6.quest_desc: [
		"Some of what you've found doesn't just feel powerful."
		"It feels arcane. Deliberate. Like it was made, not found. Somewhere, there may be an explanation."
	]
	quest.164D9BB2574BDBA6.title: "Something Stranger Still"
	quest.168AD8A6EFBD4998.quest_desc: ["Another capacity jump on top of copper."]
	quest.168AD8A6EFBD4998.title: "Gold Upgrade"
	quest.169B9E778D362C31.quest_desc: ["Let a little daylight in with a window and matching pane."]
	quest.169B9E778D362C31.title: "Windows"
	quest.169F3B68F77D4410.quest_desc: [
		"The ground drops away and, for the first time, you're actually flying."
		"Every aviator remembers this moment."
	]
	quest.169F3B68F77D4410.title: "Head in the Clouds"
	quest.16B6EF1D28538071.quest_desc: ["Light the Brazier, perform the Warping ritual, and watch space bend politely around your base."]
	quest.16B6EF1D28538071.title: "Rituals and Braziers"
	quest.16B76FFF07087576.quest_desc: ["The finest rod a river's ever seen, forged from what the depths gave up."]
	quest.16B76FFF07087576.title: "Neptunium Fishing Rod"
	quest.173D76189F341858.quest_desc: [
		"Insanium gemstones open doors well beyond farming."
		"GemsRealm offers up its whole hoard in thanks."
	]
	quest.173D76189F341858.title: "A Realm of Gems"
	quest.174A8822F9533A76.quest_desc: ["Once you know what's coming, let redstone take it from here."]
	quest.174A8822F9533A76.title: "Build Around the Weather"
	quest.1776F2654E75B94B.quest_desc: [
		"Auto-compacts stored items into their block form."
		"Cobblestone and sand stop eating up so much room."
	]
	quest.1776F2654E75B94B.title: "Compacting Drawers"
	quest.17AFE5099561FF52.quest_desc: [
		"Flying in a straight line is easy - turning is another matter."
		"Craft a steering wheel and take real control."
	]
	quest.17AFE5099561FF52.title: "Steering Wheel"
	quest.17B31E0B0FEBF7B6.quest_desc: ["Sweeps nearby drops straight into the backpack as you walk."]
	quest.17B31E0B0FEBF7B6.title: "Pickup Upgrade"
	quest.17C02C0560F77788.quest_desc: ["Fry, sear, and get creative with what the stove can do."]
	quest.17C02C0560F77788.title: "The Skillet"
	quest.17CA675360CDE9F8.quest_desc: [
		"Hand it an item and it'll punch, place or craft just like"
		"you would. Automated hands, basically."
	]
	quest.17CA675360CDE9F8.title: "Deployer"
	quest.17D548E236619270.quest_desc: [
		"Wear it once, keep the extra health forever."
		"The foundation stone of any artifact combat build."
	]
	quest.17D548E236619270.title: "Crystal Heart"
	quest.17F71F9EDB058F11.quest_desc: ["A softer take on glass, framed in wood and dyed to match any room."]
	quest.17F71F9EDB058F11.title: "Framed Glass"
	quest.17FE24284F0BFB78.quest_desc: [
		"Channels mechanical power straight down into the depths."
		"The hypertube network runs on this."
	]
	quest.17FE24284F0BFB78.title: "Conduit Cage"
	quest.17FF36636D434293.quest_desc: [
		"Refined Radiance and Shadow Steel, fused into a component your"
		"logic and display setups will lean on."
	]
	quest.17FF36636D434293.title: "Electron Tube"
	quest.18150655922B99B9.quest_desc: ["Once you know what's coming, let redstone take it from here."]
	quest.18150655922B99B9.title: "Build Around the Weather"
	quest.18247BA88A421E64.quest_desc: ["A transponder that broadcasts your ship's identity to logistics networks below."]
	quest.18247BA88A421E64.title: "Transponders"
	quest.1825AEDE46A2464C.quest_desc: ["Head out where the water runs deep. Tuna are waiting."]
	quest.1825AEDE46A2464C.title: "Deep Water Catch"
	quest.18429B43C9BEFF8F.quest_desc: ["The upgrade: a scroll bound for good, always ready for that one trip."]
	quest.18429B43C9BEFF8F.title: "Bound Scroll"
	quest.188F12FBCA018F3D.quest_desc: [
		"Not every crop here is ordinary."
		"Gather slime jelly for something a little stranger."
	]
	quest.188F12FBCA018F3D.title: "Slime Jelly"
	quest.1898335D9E8BD1FA.quest_desc: ["Blend it up for something cool and refreshing."]
	quest.1898335D9E8BD1FA.title: "Banana Smoothie"
	quest.18ABD1B784FE4BB1.quest_desc: ["Once you know what's coming, let redstone take it from here."]
	quest.18ABD1B784FE4BB1.title: "Build Around the Weather"
	quest.18D432CBCA32F646.quest_desc: ["A jar built to hold something less tangible than essence - souls, drawn from fallen mobs."]
	quest.18D432CBCA32F646.title: "Capturing Souls"
	quest.18E87850D1CA17B1.quest_desc: ["Let a machine take over the slicing, so your hands are free for everything else."]
	quest.18E87850D1CA17B1.title: "The Mechanical Cutter"
	quest.18EC1BCF4782B77B.quest_desc: [
		"At some point the machines just kept running, and you stopped checking on them."
		"That quiet trust is how you know automation actually won."
	]
	quest.18EC1BCF4782B77B.title: "The Automator"
	quest.18F85B46CDBD8477.quest_desc: ["Mount tools and weapons right on the wall instead of burying them in a chest."]
	quest.18F85B46CDBD8477.title: "Tool Hook"
	quest.18FCE8C0133A48F0.quest_desc: [
		"One blast calls your dragon out of the sky and straight to your side."
		"Command, at last, over something that could kill you outright."
	]
	quest.18FCE8C0133A48F0.title: "Dragon Horn"
	quest.18FD6FC3B6648475.quest_desc: ["Runes coaxed from the Apparatus unlock glyphs your Novice book could never hold."]
	quest.18FD6FC3B6648475.title: "Runes of Knowledge"
	quest.191C7512A80693EB.quest_desc: ["Chalk up notes and doodles right on the wall."]
	quest.191C7512A80693EB.title: "Blackboard"
	quest.192DA57C7FF0BC95.quest_desc: ["Ten fewer things that go boom near your builds."]
	quest.192DA57C7FF0BC95.title: "Creeper Bounty: Apprentice"
	quest.19C59EAF50281F47.quest_desc: ["Pair that chair with a proper table for meals and gatherings."]
	quest.19C59EAF50281F47.title: "Dining Table"
	quest.19D5D9F27475C6EA.quest_desc: ["Fancy a cooler look? Try a batch of Blue Bricks instead."]
	quest.19D5D9F27475C6EA.title: "Blue Brick Palette"
	quest.19D627B2E6ACD6CD.quest_desc: [
		"Fifty. Even the caves feel less crawly."
		"A Bane of Arthropods charm, well overdue."
	]
	quest.19D627B2E6ACD6CD.title: "Spider Bounty: Veteran"
	quest.19D64128F6C9C503.quest_desc: [
		"Somewhere out there, someone wrote a song about flying."
		"Track down a copy for yourself."
	]
	quest.19D64128F6C9C503.title: "A Tune for the Clouds"
	quest.19F6C155DC848EC0.quest_desc: [
		"Rotation, power, fluids, wiring, and a workshop that finally looks the part."
		"Every corner of Create you touched, working together instead of sitting in separate corners."
	]
	quest.19F6C155DC848EC0.title: "The Complete Workshop"
	quest.1A019E26C0ECA5B7.quest_desc: [
		"Forged from something that used to own the sky, before you had a say in it."
		"Wearing this means you already answered the hardest question this world had for you."
	]
	quest.1A019E26C0ECA5B7.title: "Dragonslayer's Due"
	quest.1A04F0F29C3F0814.quest_desc: ["Brew up something warming for a quiet evening."]
	quest.1A04F0F29C3F0814.title: "Chai Tea"
	quest.1A331E998C2B7CA1.quest_desc: ["A sturdier ladder for climbs that need a bit more backbone."]
	quest.1A331E998C2B7CA1.title: "Iron Ladder"
	quest.1A3660AD2FF4FD51.quest_desc: [
		"Deep beneath the waves lies neptunium."
		"Melt the ore down into something useful."
	]
	quest.1A3660AD2FF4FD51.title: "Neptunium Ingots"
	quest.1A469FCDD3C29E84.quest_desc: [
		"Not every crop here is ordinary."
		"Gather slime jelly for something a little stranger."
	]
	quest.1A469FCDD3C29E84.title: "Slime Jelly"
	quest.1A79865B228938B6.quest_desc: ["A warm bowl made from a harvest you grew yourself."]
	quest.1A79865B228938B6.title: "Tomato Soup"
	quest.1A799C3FD3D0B405.quest_desc: [
		"Flying in a straight line is easy - turning is another matter."
		"Craft a steering wheel and take real control."
	]
	quest.1A799C3FD3D0B405.title: "Steering Wheel"
	quest.1A89E2FCBD322816.quest_desc: ["Knife in hand, turn your catch into clean fillets, ready for the pan."]
	quest.1A89E2FCBD322816.title: "Fillet Your Catch"
	quest.1A9216EFD440C462.quest_desc: [
		"A propeller in your hand is just a toy."
		"Mount it on a bearing and give a contraption something to drive."
	]
	quest.1A9216EFD440C462.title: "Mounted for Flight"
	quest.1AA1BFA0EAAA0248.quest_desc: [
		"The ground drops away and, for the first time, you're actually flying."
		"Every aviator remembers this moment."
	]
	quest.1AA1BFA0EAAA0248.title: "Head in the Clouds"
	quest.1ADB2340453DF3E1.quest_desc: [
		"The night is full of them."
		"Put one down."
	]
	quest.1ADB2340453DF3E1.title: "Zombie Bounty: Novice"
	quest.1AE024E7D7CD5FA9.quest_desc: [
		"Raise one at every junction."
		"Keeps two trains from ever meeting somewhere they shouldn't."
	]
	quest.1AE024E7D7CD5FA9.title: "Raise a Semaphore"
	quest.1AEAFEB9F692A4F2.quest_desc: [
		"One panel, the whole network."
		"Monitor and control everything from a single dashboard."
	]
	quest.1AEAFEB9F692A4F2.title: "Dashboard"
	quest.1AF48A34A188ABCC.quest_desc: ["Thick, meaty, and just the thing after a long day's work."]
	quest.1AF48A34A188ABCC.title: "Hearty Beef Stew"
	quest.1B08D7AE2D394FC6.quest_desc: ["Brew up something warming for a quiet evening."]
	quest.1B08D7AE2D394FC6.title: "Chai Tea"
	quest.1B32809379C5438F.quest_desc: ["Nut trees like walnut are worth the wait, come roasting time."]
	quest.1B32809379C5438F.title: "Walnut Trees"
	quest.1B56D92C96969AF4.quest_desc: [
		"An iron rod holds up longer and finds better luck."
		"Worth the upgrade."
	]
	quest.1B56D92C96969AF4.title: "Iron Fishing Rod"
	quest.1B6F7260ABAB1B8D.quest_desc: [
		"Turns power ninety degrees, no fuss."
		"Handy the moment your build stops being a straight line."
	]
	quest.1B6F7260ABAB1B8D.title: "Gearbox"
	quest.1B6FE547EFB68145.quest_desc: ["A sturdier switch for junctions that see real traffic."]
	quest.1B6FE547EFB68145.title: "Brass Track Switch"
	quest.1B7B8432CA967B5C.quest_desc: [
		"Built from a Fluid Hatch and a block of bottled experience."
		"Feeds liquid XP straight into your enchanting setup."
	]
	quest.1B7B8432CA967B5C.title: "Experience Hatch"
	quest.1BAC2872B2C9DB87.quest_desc: ["Head out where the water runs deep. Tuna are waiting."]
	quest.1BAC2872B2C9DB87.title: "Deep Water Catch"
	quest.1BB2298C7A913F66.quest_desc: [
		"A thousand. At this point they might be more scared of you."
		"Maximum Looting, and a scrap pulled from the Nether's depths."
	]
	quest.1BB2298C7A913F66.title: "Enderman Bounty: Legend"
	quest.1BC7649D3A5E10D1.quest_desc: ["Bind a Warp Scroll to a Waystone for one quick trip from anywhere."]
	quest.1BC7649D3A5E10D1.title: "Warp Scroll"
	quest.1C03B061506E409B.quest_desc: [
		"Crack the ore, or grow it from seed - either way, essence pools in your hands."
		"Nearly everything ahead starts with this."
	]
	quest.1C03B061506E409B.title: "Inferium Essence"
	quest.1C3D6ACB4EB72F5F.quest_desc: [
		"The rumours are true. Somewhere out past the frontier, something with wings is old enough to remember when the land looked different."
		"This isn't early-game country. Come with diamond gear or better, and something that's already survived worse than a skeleton."
	]
	quest.1C3D6ACB4EB72F5F.title: "Ready for Dragon Country"
	quest.1C5A39803819DCAB.quest_desc: [
		"Flattens metal into sheets, or set it over a Basin for"
		"compacting recipes. One tool, two jobs."
	]
	quest.1C5A39803819DCAB.title: "Mechanical Press"
	quest.1C7807DE8298314E.quest_desc: [
		"Thrust alone won't keep you up forever - you need lift."
		"Sew an envelope and encase a shaft within it: together, the heart of a proper balloon."
	]
	quest.1C7807DE8298314E.title: "Catching the Wind"
	quest.1CCC4EFEE2BE32B9.quest_desc: [
		"Tempered over a Blaze Burner. Hits like Diamond"
		"and never needs repairing."
	]
	quest.1CCC4EFEE2BE32B9.title: "Blazing Pickaxe"
	quest.1CFA74C1159412ED.quest_desc: [
		"Flying in a straight line is easy - turning is another matter."
		"Craft a steering wheel and take real control."
	]
	quest.1CFA74C1159412ED.title: "Steering Wheel"
	quest.1CFFC3029F079AEF.quest_desc: [
		"Cargo won't sort and route itself - well, almost."
		"Craft a logistics terminal and automate the flow of goods through your station."
	]
	quest.1CFFC3029F079AEF.title: "Logistics Network"
	quest.1D16BB9819A47FD0.quest_desc: [
		"Brass tier down, tracks next. Lay rail and put up a"
		"station - your logistics just went off-road."
	]
	quest.1D16BB9819A47FD0.title: "All Aboard: Trains"
	quest.1D4EE9702C8CBBFD.quest_desc: [
		"A thousand Creepers. Nobody's builds have been safer."
		"Maximum Blast Protection, and something dug up from deep in the Nether."
	]
	quest.1D4EE9702C8CBBFD.title: "Creeper Bounty: Legend"
	quest.1D64F6AC915FA403.quest_desc: [
		"Every good defense starts with a shield."
		"Craft one before the raiders come knocking."
	]
	quest.1D64F6AC915FA403.title: "Arm Yourself"
	quest.1D6A93934B06759F.quest_desc: [
		"A thousand Creepers. Nobody's builds have been safer."
		"Maximum Blast Protection, and something dug up from deep in the Nether."
	]
	quest.1D6A93934B06759F.title: "Creeper Bounty: Legend"
	quest.1D6B39B60A4401CD.quest_desc: [
		"Stack two snow blocks, top them with a carved pumpkin."
		"A Snow Golem that'll pelt hostiles from a distance, free of charge."
	]
	quest.1D6B39B60A4401CD.title: "Snow Golem"
	quest.1D85F18A02B42049.quest_desc: [
		"Ring it with Brass Bookshelves and this becomes the top"
		"of the line - full power, fully automated."
	]
	quest.1D85F18A02B42049.title: "Blaze Enchanter"
	quest.1DBEFFA3BEC17E0A.quest_desc: [
		"Winches, couplings, plungers - you move around a ship now without ever needing an engine."
		"Traversal mastered."
	]
	quest.1DBEFFA3BEC17E0A.title: "Learning the Ropes"
	quest.1DC98B5E605CF4A9.quest_desc: [
		"A contraption that actually leaves the ground, and airspace you can finally call yours."
		"The sky was never really closed off. It just took you a while to get up there."
	]
	quest.1DC98B5E605CF4A9.title: "Claimed Skies"
	quest.1DCB7942A0F94930.quest_desc: ["A little stand to show off your favorite hat by the door."]
	quest.1DCB7942A0F94930.title: "Hat Stand"
	quest.1DD5E956FE0C497C.quest_desc: ["A Spell Turret casts on its own - magic quietly learning to automate itself."]
	quest.1DD5E956FE0C497C.title: "Automated Casting"
	quest.1DDD229A29F7328A.quest_desc: ["Keeps an eye out for anything living that wanders past."]
	quest.1DDD229A29F7328A.title: "Ender Watcher"
	quest.1E039EF54333E796.quest_desc: [
		"Cold even in your hand, taken from a dragon that never once blinked."
		"The Ice Dragonsteel line begins here."
	]
	quest.1E039EF54333E796.title: "Heart of an Ice Dragon"
	quest.1E06CB2B11BC0114.quest_desc: [
		"Ferment it further and you've got Bioethanol -"
		"clean fuel for your generators."
	]
	quest.1E06CB2B11BC0114.title: "Bioethanol"
	quest.1E129CABEF1A7BC4.quest_desc: ["Bumps up the stack size on everything stored inside."]
	quest.1E129CABEF1A7BC4.title: "Stack Upgrade Tier 1"
	quest.1E49244D9128860A.quest_desc: ["Matching slabs and stairs round the set out nicely."]
	quest.1E49244D9128860A.title: "Brick Shapes"
	quest.1E52A18B5D873F78.quest_desc: ["A hundred down. You don't flinch at cobwebs anymore."]
	quest.1E52A18B5D873F78.title: "Spider Bounty: Expert"
	quest.1E5A7BB316C10020.quest_desc: [
		"Draw Copper Rods into wire. Every electrical connection"
		"in this network starts with a spool of this."
	]
	quest.1E5A7BB316C10020.title: "Copper Wiring"
	quest.1E5B9AA5800087B2.quest_desc: ["The blank slate every backpack upgrade is built from."]
	quest.1E5B9AA5800087B2.title: "Upgrade Base"
	quest.1E638BCF0F095C9F.quest_desc: [
		"Compost your organic scraps down to Biomass."
		"First step on the road to brewing your own fuel."
	]
	quest.1E638BCF0F095C9F.title: "Biomass"
	quest.1ECAB2D91AD2E7D3.quest_desc: ["A cupboard and drawer keep the clutter out of sight."]
	quest.1ECAB2D91AD2E7D3.title: "Storage Furniture"
	quest.1ECABF419D7EE8AD.quest_desc: [
		"Straps on over your chestplate and speeds up mining"
		"and movement both. Your first taste of powered gear."
	]
	quest.1ECABF419D7EE8AD.title: "Copper Exoskeleton"
	quest.1F03B9C085A16360.quest_desc: ["Bumps up the stack size on everything stored inside."]
	quest.1F03B9C085A16360.title: "Stack Upgrade Tier 1"
	quest.1F0BB9657DEF1B76.quest_desc: ["A finished kitchen deserves a table set to match."]
	quest.1F0BB9657DEF1B76.title: "Set the Table"
	quest.1F10843882965F4F.quest_desc: [
		"Not everything you move needs to leave the ground."
		"Build a train station alongside your airship station for cargo that's happy to stay earthbound."
	]
	quest.1F10843882965F4F.title: "Grounded Logistics"
	quest.1F1D487D7F114842.quest_desc: [
		"A matched pair sends rotational power wirelessly."
		"Run machinery clear across your base without laying a single shaft."
	]
	quest.1F1D487D7F114842.title: "Kinetic Bridge"
	quest.1F372388F51C4AB9.quest_desc: ["It moves like a storm and hits like one too."]
	quest.1F372388F51C4AB9.title: "Slay a Lightning Dragon"
	quest.1F4ADC133E519CD6.quest_desc: [
		"A blade turns that board into a real prep station."
		"The flint knife won't win awards, but it'll do."
	]
	quest.1F4ADC133E519CD6.title: "A Sharp Edge"
	quest.1F514A7D47CB46D3.quest_desc: ["Bind a Warp Scroll to a Waystone for one quick trip from anywhere."]
	quest.1F514A7D47CB46D3.title: "Warp Scroll"
	quest.1F53DBAB7E7DFDEA.quest_desc: [
		"A pale ore veined through the deep rock, waiting to be melted down."
		"The first ingredient in gear built for things that don't die easy."
	]
	quest.1F53DBAB7E7DFDEA.title: "Silver Ore"
	quest.1F550EBDB4C523BC.quest_desc: ["A crossbow means the raiders never even reach you."]
	quest.1F550EBDB4C523BC.title: "Ranged Defense"
	quest.1F59754A080D7F19.quest_desc: [
		"Bolt on Windmill Sails and output climbs with every one you add."
		"Big footprint, bigger payoff."
	]
	quest.1F59754A080D7F19.title: "Windmill Bearing"
	quest.1F6DFD9D7D14A199.quest_desc: ["Another capacity jump on top of copper."]
	quest.1F6DFD9D7D14A199.title: "Gold Upgrade"
	quest.1F833E2088433D93.quest_desc: [
		"Alloy your first bit of andesite and you've taken your first step into Create."
		"There's a whole engineer's life waiting past this one alloy."
	]
	quest.1F833E2088433D93.title: "A Taste of Engineering"
	quest.1F9052119C5F27D2.quest_desc: [
		"Auto-compacts stored items into their block form."
		"Cobblestone and sand stop eating up so much room."
	]
	quest.1F9052119C5F27D2.title: "Compacting Drawers"
	quest.1FAC42A7F7691874.quest_desc: ["A darker take on the lamp, right at home in a nether-themed room."]
	quest.1FAC42A7F7691874.title: "Blackstone Lamp"
	quest.1FDC36FB234CAFAE.quest_desc: [
		"Eight legs, bad attitude."
		"Deal with one."
	]
	quest.1FDC36FB234CAFAE.title: "Spider Bounty: Novice"
	quest.1FDE9774FCAFD99D.quest_desc: [
		"Onions turn up in more recipes than you'd expect."
		"Get a patch growing."
	]
	quest.1FDE9774FCAFD99D.title: "Plant Onions"
	quest.1FF2C6140A58E01A.quest_desc: [
		"Wood only gets you so far before you hit something harder."
		"Mine a little cobblestone and upgrade."
	]
	quest.1FF2C6140A58E01A.title: "Onto Stone"
	quest.201780460E1B7B5C.quest_desc: [
		"Function first, but nobody said your envelope has to be plain."
		"Dye a few and make it yours."
	]
	quest.201780460E1B7B5C.title: "Colors of the Sky"
	quest.202B644386BD9E93.quest_desc: ["Blend it up for something cool and refreshing."]
	quest.202B644386BD9E93.title: "Banana Smoothie"
	quest.20568D0FD7C5768A.quest_desc: [
		"A heart, a forge, and heat most things wouldn't survive."
		"What comes out the other side is close to unbreakable."
	]
	quest.20568D0FD7C5768A.title: "Fire Dragonsteel Ingot"
	quest.206147EFC8D069C6.quest_desc: ["A couch is the start of any cozy living room."]
	quest.206147EFC8D069C6.title: "Living Room Couch"
	quest.2074B7118F0294E5.quest_desc: [
		"Shed scales, still warm, gathered where dragons rest or fall."
		"Light enough to move in, tough enough to matter."
	]
	quest.2074B7118F0294E5.title: "Dragon Scales"
	quest.212D229BA2E0C183.quest_desc: [
		"Channels mechanical power straight down into the depths."
		"The hypertube network runs on this."
	]
	quest.212D229BA2E0C183.title: "Conduit Cage"
	quest.212D7761A6D414FE.quest_desc: [
		"A good fillet knife turns a catch into supper."
		"The wooden one's cheap, but it'll do."
	]
	quest.212D7761A6D414FE.title: "Wooden Fillet Knife"
	quest.2131449F90CEECC6.quest_desc: [
		"Automate the grinding itself and you get a steady drip"
		"of both items and XP."
	]
	quest.2131449F90CEECC6.title: "Mechanical Grindstone"
	quest.213F2CD37027E2DE.quest_desc: ["A Stabilized Warp Scroll offers a steadier way to cross the space you've just learned to bend."]
	quest.213F2CD37027E2DE.title: "Stabilized Travel"
	quest.21473241577F934C.quest_desc: [
		"Finishes off the frame with a sleeker profile."
		"Run it through the Train Assembly tool and your first true locomotive is ready to roll."
	]
	quest.21473241577F934C.title: "Streamlined Smokestack"
	quest.2147D88F6546D506.quest_desc: ["Grind Prosperity Ore into shards, the quiet currency behind Soulium craft."]
	quest.2147D88F6546D506.title: "Prosperity Shards"
	quest.21614886454B9D88.quest_desc: [
		"Track's down, signals are up, the locomotive's built."
		"Couple it all together and send your first train out."
	]
	quest.21614886454B9D88.title: "Build Your First Train Line"
	quest.2196D6487652EB67.quest_desc: [
		"Whip the butter alone, no powder needed, and you"
		"get smooth white chocolate."
	]
	quest.2196D6487652EB67.title: "White Chocolate"
	quest.219B34AAE019D1F8.quest_desc: ["For the angler who's serious about it. A diamond rod earns its keep."]
	quest.219B34AAE019D1F8.title: "Diamond Fishing Rod"
	quest.21BA562FFB915B1F.quest_desc: ["Set a pot over the fire and something warm is never far off."]
	quest.21BA562FFB915B1F.title: "The Cooking Pot"
	quest.21CE3993369B4333.quest_desc: ["A Blank Scroll is where every travel scroll starts."]
	quest.21CE3993369B4333.title: "Blank Scroll"
	quest.21D67F4634B737B9.quest_desc: [
		"Smelted, forged, and sharpened against things that fear silver more than steel."
		"The undead in particular will not enjoy this."
	]
	quest.21D67F4634B737B9.title: "Silver Sword"
	quest.21DD3357077889B9.quest_desc: ["A sturdier switch for junctions that see real traffic."]
	quest.21DD3357077889B9.title: "Brass Track Switch"
	quest.21E584CC573EC84E.quest_desc: ["A hundred archers who never got a shot off worth remembering."]
	quest.21E584CC573EC84E.title: "Skeleton Bounty: Expert"
	quest.21E78BFA6A92BA2A.quest_desc: [
		"A matched pair sends rotational power wirelessly."
		"Run machinery clear across your base without laying a single shaft."
	]
	quest.21E78BFA6A92BA2A.title: "Kinetic Bridge"
	quest.21F5EEEA9811618A.quest_desc: [
		"Set it beside a spinning shaft and let it grind out bonus"
		"materials while you do something else."
	]
	quest.21F5EEEA9811618A.title: "Millstone"
	quest.2229985CCC0E8CE0.quest_desc: [
		"Straight-line power transfer, nothing fancy about it."
		"Every contraption you build will have a few of these running through it."
	]
	quest.2229985CCC0E8CE0.title: "Shaft"
	quest.222C741EC2F92C62.quest_desc: ["Lay down Inferium Farmland, and your crops grow eager without ever needing a drop of water."]
	quest.222C741EC2F92C62.title: "Fertile Ground"
	quest.224CE45A61091D6E.quest_desc: [
		"A wood-matched chest for whichever room it lands in."
		"Start the collection with a simple Oak Chest."
	]
	quest.224CE45A61091D6E.title: "Variant Chest"
	quest.22815E9E0B2CC225.quest_desc: ["Mystical Agradditions dares one tier further. Crux and awakened essence combine into the true capstone: Insanium."]
	quest.22815E9E0B2CC225.title: "Insanium: Beyond Awakened"
	quest.2281C70F48EB0BD7.quest_desc: ["Every sprint gets a little faster with these on."]
	quest.2281C70F48EB0BD7.title: "Running Shoes"
	quest.2291B60F36D7A6C6.quest_desc: [
		"Calcium powder and prismarine crystals, fused together."
		"Everything underwater gets built on this."
	]
	quest.2291B60F36D7A6C6.title: "Prismarine Alloy"
	quest.2292DBE8E6116FF0.quest_desc: [
		"A hearty root crop worth keeping in the pantry."
		"Plant a few and let them settle in."
	]
	quest.2292DBE8E6116FF0.title: "Plant Sweet Potatoes"
	quest.22A2427AC66FD418.quest_desc: [
		"Not every ritual is peaceful."
		"This one calls a Wilden guardian - answer for it, or run."
	]
	quest.22A2427AC66FD418.title: "A Dangerous Summoning"
	quest.22AB0D2BA88B9C79.quest_desc: [
		"Mix it down to a fine powder - the base for anything"
		"dark and bitter."
	]
	quest.22AB0D2BA88B9C79.title: "Cocoa Powder"
	quest.22B6B3FB88DBD8EF.quest_desc: [
		"Keeps an eye on tube traffic as it moves through the network."
		"About as far as aquatic engineering goes."
	]
	quest.22B6B3FB88DBD8EF.title: "Tube Scanner Attachment"
	quest.22CF447052C365BB.quest_desc: ["Fill a cauldron with dye and every undyed piece you dip comes out in color."]
	quest.22CF447052C365BB.title: "Dye Cauldron"
	quest.22DB4F23154F6BA5.quest_desc: ["Imperium Essence glows brighter than anything before it - and the climb still isn't over."]
	quest.22DB4F23154F6BA5.title: "Imperium Tier"
	quest.22E7B6940FC3F7CE.quest_desc: ["Imbue a blade until it carries a little magic of its own."]
	quest.22E7B6940FC3F7CE.title: "Enchanted Armaments"
	quest.2308FAB7ACB57B3B.quest_desc: ["Wearable storage means never running short of space on a trip out."]
	quest.2308FAB7ACB57B3B.title: "Backpack"
	quest.2331616CF3191AFA.quest_desc: ["Thick, meaty, and just the thing after a long day's work."]
	quest.2331616CF3191AFA.title: "Hearty Beef Stew"
	quest.233876CDBCB3C445.quest_desc: [
		"Bind an amethyst shard, a writable book, and spruce wood together."
		"What results is no ordinary book - it's a record of arcane augmentation, waiting to be filled."
	]
	quest.233876CDBCB3C445.title: "The Skills Grimoire"
	quest.23759A4981E1934E.quest_desc: [
		"Gold and Silver alloyed into Electrum wire - carries"
		"current more efficiently than Copper ever could."
	]
	quest.23759A4981E1934E.title: "Electrum Wiring"
	quest.237EE651CE471571.quest_desc: [
		"Feed it your levels and it turns them into Liquid Experience."
		"Every automated enchanter starts right here."
	]
	quest.237EE651CE471571.title: "Experience Hatch"
	quest.23819DDD69647F61.quest_desc: ["Light the Brazier, perform the Warping ritual, and watch space bend politely around your base."]
	quest.23819DDD69647F61.title: "Rituals and Braziers"
	quest.23870796CD4A59E9.quest_desc: [
		"One slot, one item, no fuss."
		"Your first step into Functional Storage."
	]
	quest.23870796CD4A59E9.title: "Oak Drawer (1x1)"
	quest.23A68BD71C4B511B.quest_desc: ["For the angler who's serious about it. A diamond rod earns its keep."]
	quest.23A68BD71C4B511B.title: "Diamond Fishing Rod"
	quest.23ABC249D55BD222.quest_desc: ["A hundred down. You don't flinch at cobwebs anymore."]
	quest.23ABC249D55BD222.title: "Spider Bounty: Expert"
	quest.23C735804CDC24F4.quest_desc: [
		"Brass-built and better tuned - smoother flight,"
		"more control than the Copper model."
	]
	quest.23C735804CDC24F4.title: "Brass Jetpack"
	quest.23C7EBFA1B63D352.quest_desc: [
		"Every good kitchen starts somewhere simple."
		"A cutting board's as good a start as any."
	]
	quest.23C7EBFA1B63D352.title: "The Cutting Board"
	quest.23C7F58AE06F46D7.quest_desc: ["Wake your Supremium at the altar, and it becomes something the mod never quite intended."]
	quest.23C7F58AE06F46D7.title: "Awakened Supremium"
	quest.23DE6C87E0DAF20B.quest_desc: [
		"Andesite alloy plating around a rotating shaft."
		"A simple frame for grinding down enchanted gear."
	]
	quest.23DE6C87E0DAF20B.title: "Mechanical Grindstone"
	quest.2405AD5F845BBB87.quest_desc: [
		"Spin it fast enough and rotational power turns into real"
		"electricity. The bridge between kinetic and electric."
	]
	quest.2405AD5F845BBB87.title: "Alternator"
	quest.241E1AC5AE1091B0.quest_desc: [
		"Strap these on and suddenly the ground doesn't hold you down."
		"Your first step into artifact mobility."
	]
	quest.241E1AC5AE1091B0.title: "Bunny Hoppers"
	quest.2444790711A23838.quest_desc: [
		"Banks the surplus from your Alternators so demand"
		"spikes don't leave you short."
	]
	quest.2444790711A23838.title: "Accumulator"
	quest.2446B1D89378EE57.quest_desc: [
		"Not everything in the garden is for eating."
		"Cotton grows well alongside the rest."
	]
	quest.2446B1D89378EE57.title: "Harvest Cotton"
	quest.2459A8851B602A87.quest_desc: [
		"Something a dragon exhales, bottled before it dissolves into the wind."
		"The first strange step toward automating what a dragon leaves behind."
	]
	quest.2459A8851B602A87.title: "Bottling Dragon's Breath"
	quest.2462DFE3983FCE6C.quest_desc: ["A hundred. The End itself is starting to feel routine."]
	quest.2462DFE3983FCE6C.title: "Enderman Bounty: Expert"
	quest.246F570BFD8AE58F.quest_desc: [
		"Track's down, signals are up, the locomotive's built."
		"Couple it all together and send your first train out."
	]
	quest.246F570BFD8AE58F.title: "Build Your First Train Line"
	quest.2490B66DDEE97B87.quest_desc: [
		"Barding forged to keep your mount alive when the fight follows you into the air."
		"A flying companion is only as safe as the armor on its back."
	]
	quest.2490B66DDEE97B87.title: "Iron Hippogryph Armor"
	quest.2492E586370A27D2.quest_desc: [
		"One panel, the whole network."
		"Monitor and control everything from a single dashboard."
	]
	quest.2492E586370A27D2.title: "Dashboard"
	quest.24D4C3FEBDBF7BB9.quest_desc: ["Roomier still."]
	quest.24D4C3FEBDBF7BB9.title: "Gold Backpack"
	quest.2523C1D61D3C8FE1.quest_desc: ["Walls and a roof make shelter. A little care makes it home."]
	quest.2523C1D61D3C8FE1.title: "Make It Feel Like Home"
	quest.255345EE4F6C8889.quest_desc: ["Head out where the water runs deep. Tuna are waiting."]
	quest.255345EE4F6C8889.title: "Deep Water Catch"
	quest.257C2339193C3F7B.quest_desc: [
		"Shed scales, still warm, gathered where dragons rest or fall."
		"Light enough to move in, tough enough to matter."
	]
	quest.257C2339193C3F7B.title: "Dragon Scales"
	quest.2583050DDF48A92B.quest_desc: [
		"Plays a sound of your choosing when the signal comes through."
		"Pair it with the relayer for a doorbell or a dinner call."
	]
	quest.2583050DDF48A92B.title: "Speaker Block"
	quest.25A7EF8C6C27B80E.quest_desc: [
		"You've seen more of this world than most people who ever load it up will."
		"The map stopped being frightening a long time ago."
	]
	quest.25A7EF8C6C27B80E.title: "Beyond the Horizon"
	quest.25DA05D36E25DADE.quest_desc: [
		"A thousand fallen. You've earned the quiet nights."
		"Maximum Smite, and a scrap of the Nether's toughest metal."
	]
	quest.25DA05D36E25DADE.title: "Zombie Bounty: Legend"
	quest.26006FF7FA5D40ED.quest_desc: [
		"You've found more than one now."
		"They don't feel related. Or do they?"
	]
	quest.26006FF7FA5D40ED.title: "A Pattern Emerges"
	quest.2640CA6068491490.quest_desc: ["Cozy up the dim corners with a couple of cage lamps."]
	quest.2640CA6068491490.title: "Cage Lighting"
	quest.2650FB11C2ABC3E8.quest_desc: [
		"Ring it with Brass Bookshelves and this becomes the top"
		"of the line - full power, fully automated."
	]
	quest.2650FB11C2ABC3E8.title: "Blaze Enchanter"
	quest.26590A59B88D9DEA.quest_desc: ["A handful of walnuts, roasted into a good little snack."]
	quest.26590A59B88D9DEA.title: "Roasted Walnuts"
	quest.266B9E98A151E1E7.quest_desc: ["Imperium Essence glows brighter than anything before it - and the climb still isn't over."]
	quest.266B9E98A151E1E7.title: "Imperium Tier"
	quest.26933A107F53CE8B.quest_desc: [
		"Binds devices across different frequencies, tying your"
		"whole wireless setup into one network."
	]
	quest.26933A107F53CE8B.title: "Redstone Link Wildcard"
	quest.2694B848062470D1.quest_desc: [
		"Winches, couplings, plungers - you move around a ship now without ever needing an engine."
		"Traversal mastered."
	]
	quest.2694B848062470D1.title: "Learning the Ropes"
	quest.26992AC90BF8B25E.quest_desc: ["A wall-mounted light that warms up any hallway."]
	quest.26992AC90BF8B25E.title: "Sconce"
	quest.26AB9E3F09B49E10.quest_desc: [
		"The stove is the heart of a proper kitchen."
		"It's what gets the skillet going."
	]
	quest.26AB9E3F09B49E10.title: "Fire Up the Stove"
	quest.26B07F0404033915.quest_desc: [
		"Deep beneath the waves lies neptunium."
		"Melt the ore down into something useful."
	]
	quest.26B07F0404033915.title: "Neptunium Ingots"
	quest.26B6BF15CF1D4FFD.quest_desc: [
		"Still crackling faintly, taken from something that ruled the storm."
		"The spark that Lightning Dragonsteel needs to exist."
	]
	quest.26B6BF15CF1D4FFD.title: "Heart of a Lightning Dragon"
	quest.26DAB37A6F73FD95.quest_desc: [
		"The last guardian of the End, and one of the oldest fights in the game."
		"Bring it down."
	]
	quest.26DAB37A6F73FD95.title: "Slay the Ender Dragon"
	quest.26E012A57E92EEB9.quest_desc: [
		"Deep, blue, and worth every torch it took to find."
		"Diamond tools are the last stop before the world gets truly strange."
	]
	quest.26E012A57E92EEB9.title: "Striking Diamond"
	quest.274A71FBC2295D1A.quest_desc: [
		"Forged from a storm given shape, and then given a heart."
		"It hums faintly, like it's still deciding whether to strike."
	]
	quest.274A71FBC2295D1A.title: "Lightning Dragonsteel Ingot"
	quest.274B9746E87F7A33.quest_desc: ["A little zinc fencing keeps things secure, and still looks the part."]
	quest.274B9746E87F7A33.title: "Bars and Mesh Fences"
	quest.275224B316B1195B.quest_desc: ["Simple, filling, and grown right in your own garden."]
	quest.275224B316B1195B.title: "Vegetable Soup"
	quest.2764709070ED199C.quest_desc: ["Cozy up the dim corners with a couple of cage lamps."]
	quest.2764709070ED199C.title: "Cage Lighting"
	quest.276A9FD72C099D00.quest_desc: ["Oak track, plain and sturdy - every railway starts with a length of this underfoot."]
	quest.276A9FD72C099D00.title: "Lay Some Track"
	quest.276CF437A15B3D35.quest_desc: [
		"Hand it an item and it'll punch, place or craft just like"
		"you would. Automated hands, basically."
	]
	quest.276CF437A15B3D35.title: "Deployer"
	quest.27B4D747215C49DD.quest_desc: [
		"A ship this valuable needs protecting - from raiders, from griefers, from anyone who isn't you."
		"Place a claim block aboard and bring it under your protection, wherever it flies."
	]
	quest.27B4D747215C49DD.title: "Claim the Skies"
	quest.27C2AD3CB8310714.quest_desc: ["Roomier still."]
	quest.27C2AD3CB8310714.title: "Gold Backpack"
	quest.27CAB15116167F95.quest_desc: [
		"Deep, blue, and worth every torch it took to find."
		"Diamond tools are the last stop before the world gets truly strange."
	]
	quest.27CAB15116167F95.title: "Striking Diamond"
	quest.27F3F6FA492FA044.quest_desc: [
		"Alloy your first bit of andesite and you've taken your first step into Create."
		"There's a whole engineer's life waiting past this one alloy."
	]
	quest.27F3F6FA492FA044.title: "A Taste of Engineering"
	quest.2812C00CF8E047A0.quest_desc: ["Pressurized and ready to work - the heart of any steam engine."]
	quest.2812C00CF8E047A0.title: "Locometal Boiler"
	quest.28169DB7A6EA031A.quest_desc: [
		"Raise the Infusion Altar and ring it with pedestals."
		"Every tier beyond this one passes through here."
	]
	quest.28169DB7A6EA031A.title: "The Infusion Altar"
	quest.2838265F8BC0A659.quest_desc: [
		"Smelt the Zinc, mix it with Copper in the Mixer, and you've"
		"got Brass - the metal the rest of this pack runs on."
	]
	quest.2838265F8BC0A659.title: "Zinc and Brass"
	quest.283D57BDE6CBA762.quest_desc: ["Beyond Supremium lies something Awakened - reachable only through a second, stranger altar."]
	quest.283D57BDE6CBA762.title: "The Awakening Altar"
	quest.285AA0C293FC963C.quest_desc: ["Tomato sauce and fresh onions, brought together into a rustic little classic."]
	quest.285AA0C293FC963C.title: "Ratatouille"
	quest.2883DA5CE73E23A8.quest_desc: ["Pin up a book or two for the whole household to read."]
	quest.2883DA5CE73E23A8.title: "Notice Board"
	quest.28A1A175EC9C4614.quest_desc: ["One blast and the platform knows it's time to go."]
	quest.28A1A175EC9C4614.title: "Conductor's Whistle"
	quest.28A1BC5705A5F17B.quest_desc: [
		"Turns power ninety degrees, no fuss."
		"Handy the moment your build stops being a straight line."
	]
	quest.28A1BC5705A5F17B.title: "Gearbox"
	quest.28A2DA6887FB08D4.quest_desc: [
		"Point it anywhere and feel the pull toward whatever biome you're chasing."
		"No more blind wandering, hoping the terrain agrees with you."
	]
	quest.28A2DA6887FB08D4.title: "Nature's Compass"
	quest.28ABB35E0F8B2B95.quest_desc: [
		"Onions turn up in more recipes than you'd expect."
		"Get a patch growing."
	]
	quest.28ABB35E0F8B2B95.title: "Plant Onions"
	quest.28F8956C7A34DD4B.quest_desc: [
		"Binds devices across different frequencies, tying your"
		"whole wireless setup into one network."
	]
	quest.28F8956C7A34DD4B.title: "Redstone Link Wildcard"
	quest.2903EDF356D0A1C2.quest_desc: [
		"Auto-compacts stored items into their block form."
		"Cobblestone and sand stop eating up so much room."
	]
	quest.2903EDF356D0A1C2.title: "Compacting Drawers"
	quest.290CBE91CF397114.quest_desc: [
		"Not everything in the garden is for eating."
		"Cotton grows well alongside the rest."
	]
	quest.290CBE91CF397114.title: "Harvest Cotton"
	quest.291BD42650DA8D69.quest_desc: [
		"Every good defense starts with a shield."
		"Craft one before the raiders come knocking."
	]
	quest.291BD42650DA8D69.title: "Arm Yourself"
	quest.291CD8FF4AE9B062.quest_desc: ["A Stabilized Warp Scroll offers a steadier way to cross the space you've just learned to bend."]
	quest.291CD8FF4AE9B062.title: "Stabilized Travel"
	quest.295D5AC71050DC6B.quest_desc: [
		"Bolt one onto a Grindstone and reclaim the XP you'd"
		"otherwise waste disenchanting gear."
	]
	quest.295D5AC71050DC6B.title: "Grindstone Drain"
	quest.2964C0EEB0AE9E7F.quest_desc: [
		"Andesite casing tidies up the wiring and toughens it -"
		"the first upgrade tier."
	]
	quest.2964C0EEB0AE9E7F.title: "Andesite Encased Connector"
	quest.29783B2E14F8144F.quest_desc: [
		"Turns power ninety degrees, no fuss."
		"Handy the moment your build stops being a straight line."
	]
	quest.29783B2E14F8144F.title: "Gearbox"
	quest.299C700F46411D1A.quest_desc: [
		"Straight-line power transfer, nothing fancy about it."
		"Every contraption you build will have a few of these running through it."
	]
	quest.299C700F46411D1A.title: "Shaft"
	quest.29D34516DDF15C7A.quest_desc: [
		"A thousand fallen. You've earned the quiet nights."
		"Maximum Smite, and a scrap of the Nether's toughest metal."
	]
	quest.29D34516DDF15C7A.title: "Zombie Bounty: Legend"
	quest.29DD6A58F2D39A53.quest_desc: ["The core block of the network - links up adjacent chests and barrels into one system."]
	quest.29DD6A58F2D39A53.title: "Inventory Connector"
	quest.29ED0AD5A9038CF0.quest_desc: ["Craft a Return Scroll and snap straight back to wherever you came from."]
	quest.29ED0AD5A9038CF0.title: "Return Scroll"
	quest.2A116A527C484FCD.quest_desc: [
		"Every stage of propulsion, conquered."
		"This is what true thrust mastery feels like."
	]
	quest.2A116A527C484FCD.title: "In Thrust We Trust"
	quest.2A179D78A08FDEE2.quest_desc: [
		"Fires a redstone signal off how much of an item sits in the network."
		"Handy for automating farms and machines."
	]
	quest.2A179D78A08FDEE2.title: "Level Emitter"
	quest.2A1E74BD1FF63731.quest_desc: [
		"Four iron blocks in a T, a carved pumpkin on top."
		"Summon an Iron Golem built to take a beating for your village."
	]
	quest.2A1E74BD1FF63731.title: "Iron Golem"
	quest.2A23DC3295765E39.quest_desc: [
		"Press instead of mix and you get cocoa butter,"
		"the fatty base behind the paler chocolates."
	]
	quest.2A23DC3295765E39.title: "Cocoa Butter"
	quest.2A3470AC627AD3EB.quest_desc: [
		"All three chocolates, blended and moulded into bricks."
		"This is the building block everything downstream uses."
	]
	quest.2A3470AC627AD3EB.title: "Chocolate Bricks"
	quest.2A6CCFF569CCA637.quest_desc: [
		"Thrust alone won't keep you up forever - you need lift."
		"Sew an envelope and encase a shaft within it: together, the heart of a proper balloon."
	]
	quest.2A6CCFF569CCA637.title: "Catching the Wind"
	quest.2A7161B714D70CDF.quest_desc: [
		"Four iron blocks in a T, a carved pumpkin on top."
		"Summon an Iron Golem built to take a beating for your village."
	]
	quest.2A7161B714D70CDF.title: "Iron Golem"
	quest.2A791CB2169B0717.quest_desc: ["Brass catwalks and railings keep you steady above it all."]
	quest.2A791CB2169B0717.title: "Catwalks and Railings"
	quest.2A820B22BC95E16D.quest_desc: [
		"Powder and butter together, and out comes ruby chocolate -"
		"the rarest of the three, worth the extra step."
	]
	quest.2A820B22BC95E16D.title: "Ruby Chocolate"
	quest.2AB1434C67C6711E.quest_desc: ["Another jump in capacity, stacked on top of the first."]
	quest.2AB1434C67C6711E.title: "Storage Upgrade (II)"
	quest.2AC3994F76110940.quest_desc: [
		"Barding forged to keep your mount alive when the fight follows you into the air."
		"A flying companion is only as safe as the armor on its back."
	]
	quest.2AC3994F76110940.title: "Iron Hippogryph Armor"
	quest.2AC3E0D0863A2714.quest_desc: ["A wall-mounted light that warms up any hallway."]
	quest.2AC3E0D0863A2714.title: "Sconce"
	quest.2AC59C3521A6A764.quest_desc: [
		"A cutting board here, a fishing rod there, a season tracked, a chocolate line running on its own."
		"None of it looked connected at first. Laid out on one table, it very much is."
	]
	quest.2AC59C3521A6A764.title: "The Whole Spread"
	quest.2AF7BB97B5D5BDC9.quest_desc: [
		"Binds devices across different frequencies, tying your"
		"whole wireless setup into one network."
	]
	quest.2AF7BB97B5D5BDC9.title: "Redstone Link Wildcard"
	quest.2B092558454CFCB8.quest_desc: ["Let a machine take over the slicing, so your hands are free for everything else."]
	quest.2B092558454CFCB8.title: "The Mechanical Cutter"
	quest.2B0BA748492B3422.quest_desc: [
		"Don't stare too long."
		"Take one down."
	]
	quest.2B0BA748492B3422.title: "Enderman Bounty: Novice"
	quest.2B179CEF12741526.quest_desc: ["A Stabilized Warp Scroll offers a steadier way to cross the space you've just learned to bend."]
	quest.2B179CEF12741526.title: "Stabilized Travel"
	quest.2B32B761FB4BDE7E.quest_desc: ["A darker take on the lamp, right at home in a nether-themed room."]
	quest.2B32B761FB4BDE7E.title: "Blackstone Lamp"
	quest.2B41D136AE46A457.quest_desc: ["Put the skillet to good use with a quick, satisfying batch of fried rice."]
	quest.2B41D136AE46A457.title: "Fried Rice"
	quest.2B56525D63431945.quest_desc: [
		"Strange veins hum beneath the stone, waiting to be broken open."
		"Essence farming begins right here."
	]
	quest.2B56525D63431945.title: "A Curious Ore"
	quest.2B5FC97DABA696EA.quest_desc: ["Magebloom woven into robes light enough that spellcasting never feels encumbered."]
	quest.2B5FC97DABA696EA.title: "Arcanist's Robes"
	quest.2B63A58B1DA93B32.quest_desc: [
		"The Alternator in reverse - feed it electricity,"
		"get rotation back out."
	]
	quest.2B63A58B1DA93B32.title: "Electric Motor"
	quest.2B78599E234DB4B3.quest_desc: ["A hundred. Villages sleep easier because of you."]
	quest.2B78599E234DB4B3.title: "Zombie Bounty: Expert"
	quest.2B827E391815E5B0.quest_desc: [
		"Bolt one onto a Grindstone and reclaim the XP you'd"
		"otherwise waste disenchanting gear."
	]
	quest.2B827E391815E5B0.title: "Grindstone Drain"
	quest.2BAC5792358FF912.quest_desc: [
		"Roll a brick out and cut it into bite-sized candy."
		"Dead simple, and it belts up nicely."
	]
	quest.2BAC5792358FF912.title: "Chocolate Candy"
	quest.2BD0586163497E82.quest_desc: [
		"A propeller that tilts with your ship opens up thrust vectors nothing else can reach."
		"Craft the gyroscopic bearing - the pinnacle of propulsion hardware."
	]
	quest.2BD0586163497E82.title: "Gyroscopic Mount"
	quest.2BE9354829A477EA.quest_desc: ["Somewhere to set a candle or a book before bed."]
	quest.2BE9354829A477EA.title: "Bedside Nightstand"
	quest.2C1762C711EBB1E1.quest_desc: ["Every good airship deserves a way to say hello from a distance."]
	quest.2C1762C711EBB1E1.title: "Mounted Potato Cannon"
	quest.2C75120F7410BBCC.quest_desc: [
		"Channels mechanical power straight down into the depths."
		"The hypertube network runs on this."
	]
	quest.2C75120F7410BBCC.title: "Conduit Cage"
	quest.2C7C1DD4F7A7E77C.quest_desc: ["Another capacity jump on top of copper."]
	quest.2C7C1DD4F7A7E77C.title: "Gold Upgrade"
	quest.2CAB5BFE066B4E3B.quest_desc: ["Lay down Inferium Farmland, and your crops grow eager without ever needing a drop of water."]
	quest.2CAB5BFE066B4E3B.title: "Fertile Ground"
	quest.2CABB3773D263B8E.quest_desc: ["Smooth things over with sand paper in a few different grits."]
	quest.2CABB3773D263B8E.title: "Sanded Finish"
	quest.2CB7F8983F902DF6.quest_desc: [
		"A drawer, a piston, some iron and stone."
		"Automatically compacts its contents into their block form."
	]
	quest.2CB7F8983F902DF6.title: "Compacting Drawer"
	quest.2CBAF31C773D5C8E.quest_desc: ["Ten fewer webs to walk into."]
	quest.2CBAF31C773D5C8E.title: "Spider Bounty: Apprentice"
	quest.2CC4EA9940E9C37A.quest_desc: [
		"Not every piece of furniture is just for looks."
		"The Alchemy Bench gives your study a little personality of its own."
	]
	quest.2CC4EA9940E9C37A.title: "Alchemy Bench"
	quest.2CC9042ADE8AAD05.quest_desc: [
		"Cargo won't sort and route itself - well, almost."
		"Craft a logistics terminal and automate the flow of goods through your station."
	]
	quest.2CC9042ADE8AAD05.title: "Logistics Network"
	quest.2CD3F52185B540D9.quest_desc: [
		"Every so often you'll find something that feels like more than it should."
		"If an old, unassuming item catches your eye, hang onto it."
	]
	quest.2CD3F52185B540D9.title: "Whispers of the Old World"
	quest.2CEB62F56901E5CB.quest_desc: [
		"Just the frame for now - add books before it does"
		"anything for your enchanting power."
	]
	quest.2CEB62F56901E5CB.title: "Incomplete Brass Bookshelf"
	quest.2CFE1BBD1E8BA7BD.quest_desc: ["A dial instead of a fixed flame - control your climb instead of just hoping for one."]
	quest.2CFE1BBD1E8BA7BD.title: "Hot Air Burner"
	quest.2D01656AC3C5576B.quest_desc: ["Essence sharpens as well as it grows. Forge a pick and blade to call the first tier mastered."]
	quest.2D01656AC3C5576B.title: "Tools of Essence"
	quest.2D386AB8193825AE.quest_desc: [
		"Not every strange trinket shares the same origin."
		"Some feel newer. Sharper. Like they were waiting to be found by someone in particular."
	]
	quest.2D386AB8193825AE.title: "Beyond the Ordinary"
	quest.2D45B053C9F56B3B.quest_desc: [
		"Bind an amethyst shard, a writable book, and spruce wood together."
		"What results is no ordinary book - it's a record of arcane augmentation, waiting to be filled."
	]
	quest.2D45B053C9F56B3B.title: "The Skills Grimoire"
	quest.2D48B0DBE7B9EDD9.quest_desc: [
		"No more spinning propellers by hand - it's time for real self-contained power."
		"Build a portable engine and work it up into a finished engine assembly."
	]
	quest.2D48B0DBE7B9EDD9.title: "Building an Engine"
	quest.2D5E051FC5C3F518.quest_desc: [
		"A Shovel for digging, a Cleaver for mobs -"
		"rounds out the Blazing set nicely."
	]
	quest.2D5E051FC5C3F518.title: "Blazing Shovel and Cleaver"
	quest.2DC7E39D4C4A643C.quest_desc: [
		"A simple wooden propeller doesn't look like much."
		"But it's the same part that ends up carrying entire flying bases."
	]
	quest.2DC7E39D4C4A643C.title: "A Taste of the Skies"
	quest.2DE9108DA6CF3C62.quest_desc: ["Ten down. The horde barely notices, but you will."]
	quest.2DE9108DA6CF3C62.title: "Zombie Bounty: Apprentice"
	quest.2DFC537271BA0F64.quest_desc: [
		"Ice and Fire's most infamous discovery."
		"Not a fight to walk into unprepared."
	]
	quest.2DFC537271BA0F64.title: "Slay a Fire Dragon"
	quest.2DFE78D2F59DA00A.quest_desc: ["A pale stone quarried from underground, good for a lighter build."]
	quest.2DFE78D2F59DA00A.title: "Limestone Bricks"
	quest.2E3B6A753FBAE707.quest_desc: ["A darker take on the lamp, right at home in a nether-themed room."]
	quest.2E3B6A753FBAE707.title: "Blackstone Lamp"
	quest.2E74FE3B3C4B98A5.quest_desc: ["With your best gear finally in hand, go see what the water's been hiding."]
	quest.2E74FE3B3C4B98A5.title: "Treasure Chest"
	quest.2E84B5348B8DE8D0.quest_desc: [
		"A good fillet knife turns a catch into supper."
		"The wooden one's cheap, but it'll do."
	]
	quest.2E84B5348B8DE8D0.title: "Wooden Fillet Knife"
	quest.2E930464EF3EF28A.quest_desc: [
		"Two more, found worlds apart, yet cut from the same unmistakable craft."
		"A ring of frost, and an amulet of distant stars."
	]
	quest.2E930464EF3EF28A.title: "Starlight and Frost"
	quest.2EAE5C76024350B6.quest_desc: [
		"Deep underground, a mineral seems to weigh less than it should."
		"Mine some levitite and find out why."
	]
	quest.2EAE5C76024350B6.title: "A Strange Floating Mineral"
	quest.2EB291301F9DE177.quest_desc: [
		"Smelt the Zinc, mix it with Copper in the Mixer, and you've"
		"got Brass - the metal the rest of this pack runs on."
	]
	quest.2EB291301F9DE177.title: "Zinc and Brass"
	quest.2EE1A01AD65C53EF.quest_desc: [
		"Flick it out to mine a block and it comes right back to you."
		"Handy for that one ore you can never quite reach."
	]
	quest.2EE1A01AD65C53EF.title: "Pickarang"
	quest.2F0A67420F1DFA98.quest_desc: [
		"Mesh with a regular Cogwheel and you can gear speed up or down."
		"Simple as that."
	]
	quest.2F0A67420F1DFA98.title: "Large Cogwheel"
	quest.2F199D125447EA68.quest_desc: ["Shell plating for extra protection out on aquatic jobs."]
	quest.2F199D125447EA68.title: "Turtle Chestplate"
	quest.2F554A3DEEEF3F50.quest_desc: [
		"Point it anywhere and feel the pull toward whatever biome you're chasing."
		"No more blind wandering, hoping the terrain agrees with you."
	]
	quest.2F554A3DEEEF3F50.title: "Nature's Compass"
	quest.2F7519A0D324FC52.quest_desc: [
		"Fifty. Even the caves feel less crawly."
		"A Bane of Arthropods charm, well overdue."
	]
	quest.2F7519A0D324FC52.title: "Spider Bounty: Veteran"
	quest.2FB8EA6B1AF24113.quest_desc: [
		"Not experience earned through practice - power poured directly in."
		"This is not the same kind of growth Skill Progression tracks. This is augmentation."
	]
	quest.2FB8EA6B1AF24113.title: "A Spark of Knowledge"
	quest.2FDC478CBBD3CA2C.quest_desc: ["Simmer your tomatoes down into something worth saving."]
	quest.2FDC478CBBD3CA2C.title: "Tomato Sauce"
	quest.2FED62C88E34C779.quest_desc: [
		"Every good kitchen starts somewhere simple."
		"A cutting board's as good a start as any."
	]
	quest.2FED62C88E34C779.title: "The Cutting Board"
	quest.2FF658B6F5C02010.quest_desc: [
		"The payoff for the whole network: a Tesla Coil that lets"
		"your stored power go out with a bang."
	]
	quest.2FF658B6F5C02010.title: "Tesla Coil"
	quest.300D708A56E35B9C.quest_desc: [
		"Not experience earned through practice - power poured directly in."
		"This is not the same kind of growth Skill Progression tracks. This is augmentation."
	]
	quest.300D708A56E35B9C.title: "A Spark of Knowledge"
	quest.30180E8DD0A0A7A6.quest_desc: [
		"Feed it Blaze Cake and it superheats whatever's sitting above it."
		"Unlocks the hotter alloying recipes, Brass included."
	]
	quest.30180E8DD0A0A7A6.title: "Blaze Burner"
	quest.303DA55766C89FCE.quest_desc: ["Two slots for a matched pair of items."]
	quest.303DA55766C89FCE.title: "Oak Drawer (1x2)"
	quest.30402E6E7A6C4CB7.quest_desc: [
		"Not experience earned through practice - power poured directly in."
		"This is not the same kind of growth Skill Progression tracks. This is augmentation."
	]
	quest.30402E6E7A6C4CB7.title: "A Spark of Knowledge"
	quest.3041B4140BA4D147.quest_desc: [
		"Armor pieced together from scales that once belonged to something enormous."
		"Light on your back, heavy in what it says about you."
	]
	quest.3041B4140BA4D147.title: "Dragon Scale Chestplate"
	quest.304F71C671D25404.quest_desc: [
		"Flattens metal into sheets, or set it over a Basin for"
		"compacting recipes. One tool, two jobs."
	]
	quest.304F71C671D25404.title: "Mechanical Press"
	quest.30707C386F9909FD.quest_desc: ["Fry, sear, and get creative with what the stove can do."]
	quest.30707C386F9909FD.title: "The Skillet"
	quest.309E8A944DD8F9F2.quest_desc: [
		"Fifty down. Caves are a little less rattly now."
		"A Protection charm, for the arrows you didn't dodge."
	]
	quest.309E8A944DD8F9F2.title: "Skeleton Bounty: Veteran"
	quest.30BFB1B0508F56FC.quest_desc: ["Cut from Jasper, found near lava, for a splash of color in your walls."]
	quest.30BFB1B0508F56FC.title: "Jasper Bricks"
	quest.30ED00A6C40E5980.quest_desc: [
		"The last guardian of the End, and one of the oldest fights in the game."
		"Bring it down."
	]
	quest.30ED00A6C40E5980.title: "Slay the Ender Dragon"
	quest.30EF0042F6993F89.quest_desc: [
		"Ice and Fire's most infamous discovery."
		"Not a fight to walk into unprepared."
	]
	quest.30EF0042F6993F89.title: "Slay a Fire Dragon"
	quest.30F444D7CCF32F51.quest_desc: [
		"Every wood type gets its own bookshelf, lighted variants included."
		"No more oak shelves clashing with a spruce study."
	]
	quest.30F444D7CCF32F51.title: "A Shelf That Fits"
	quest.313EC2F0991E53FA.quest_desc: ["Longer, cleverer spells need a sturdier book. The Mage's Spell Book obliges."]
	quest.313EC2F0991E53FA.title: "Mage's Spell Book"
	quest.3151312A26FC6322.quest_desc: ["A Warp Stone puts every Waystone you've found one click away."]
	quest.3151312A26FC6322.title: "Warp Stone"
	quest.315178A8B0F75D43.quest_desc: ["Only one tier of gear now stands between you and Supremium."]
	quest.315178A8B0F75D43.title: "Imperium Gear"
	quest.315625AD3E8BEBBE.quest_desc: ["Beyond Supremium lies something Awakened - reachable only through a second, stranger altar."]
	quest.315625AD3E8BEBBE.title: "The Awakening Altar"
	quest.3158E515549BC4C5.quest_desc: [
		"The Basin catches items and fluids; the Mixer stirs them together."
		"Between the two, half your crafting table becomes obsolete."
	]
	quest.3158E515549BC4C5.title: "Basin \\& Mechanical Mixer"
	quest.3167CC6A78672EA6.quest_desc: [
		"Ice and Fire's most infamous discovery."
		"Not a fight to walk into unprepared."
	]
	quest.3167CC6A78672EA6.title: "Slay a Fire Dragon"
	quest.316C16311C261A4C.quest_desc: [
		"A book that only matters once its pages are full of things you actually lived through."
		"Yours has real weight to it now."
	]
	quest.316C16311C261A4C.title: "The Grimoire's Weight"
	quest.3188EDBC1F369F0F.quest_desc: [
		"The stove is the heart of a proper kitchen."
		"It's what gets the skillet going."
	]
	quest.3188EDBC1F369F0F.title: "Fire Up the Stove"
	quest.31B06A5E5C2F839F.quest_desc: [
		"Onions turn up in more recipes than you'd expect."
		"Get a patch growing."
	]
	quest.31B06A5E5C2F839F.title: "Plant Onions"
	quest.31B84693D89CE193.quest_desc: [
		"Andesite casing tidies up the wiring and toughens it -"
		"the first upgrade tier."
	]
	quest.31B84693D89CE193.title: "Andesite Encased Connector"
	quest.31CCC3BAE420BC96.quest_desc: ["The lesser ring taught you the trick. This one takes it much further."]
	quest.31CCC3BAE420BC96.title: "Ring of Greater Discount"
	quest.31E1F442E2C183E0.quest_desc: [
		"Alloy your first bit of andesite and you've taken your first step into Create."
		"There's a whole engineer's life waiting past this one alloy."
	]
	quest.31E1F442E2C183E0.title: "A Taste of Engineering"
	quest.31EA46BD0199599E.quest_desc: [
		"Ars Creo hooks a Display Link to a Source Jar or turret so a Display Board can show Source and the loaded spell."
		"Check this off when the board is reading a jar."
	]
	quest.31EA46BD0199599E.title: "How Full Is the Jar?"
	quest.3210FD2958ADDCAF.quest_desc: ["Keeps the fire fed - no fuel, no steam."]
	quest.3210FD2958ADDCAF.title: "Fuel Tank"
	quest.3215C668F767FE1A.quest_desc: ["Serious capacity for serious adventuring."]
	quest.3215C668F767FE1A.title: "Diamond Backpack"
	quest.3257FEC13E1475EC.quest_desc: ["Round out the table with a warm loaf of garlic bread."]
	quest.3257FEC13E1475EC.title: "Garlic Bread Feast"
	quest.325B256C5B91D1C9.quest_desc: [
		"Not experience earned through practice - power poured directly in."
		"This is not the same kind of growth Skill Progression tracks. This is augmentation."
	]
	quest.325B256C5B91D1C9.title: "A Spark of Knowledge"
	quest.327985D42FBDA645.quest_desc: [
		"Four iron blocks in a T, a carved pumpkin on top."
		"Summon an Iron Golem built to take a beating for your village."
	]
	quest.327985D42FBDA645.title: "Iron Golem"
	quest.328588063C864F1A.quest_desc: [
		"Just the frame for now - add books before it does"
		"anything for your enchanting power."
	]
	quest.328588063C864F1A.title: "Incomplete Brass Bookshelf"
	quest.32AC856C5700BDEE.quest_desc: [
		"Shed scales, still warm, gathered where dragons rest or fall."
		"Light enough to move in, tough enough to matter."
	]
	quest.32AC856C5700BDEE.title: "Dragon Scales"
	quest.32C2F2796233F4C9.quest_desc: [
		"Holds a mountain of one item in a single block."
		"Where every drawer room starts."
	]
	quest.32C2F2796233F4C9.title: "Your First Drawer"
	quest.32F54C6FB6F67B37.quest_desc: [
		"A homestead's better with some company in the pasture."
		"Fence in a few animals and look after them."
	]
	quest.32F54C6FB6F67B37.title: "Livestock and Care"
	quest.3328A32CCA811A8F.quest_desc: ["Pulls dropped items straight into your hands, so nothing's left behind."]
	quest.3328A32CCA811A8F.title: "Magnet"
	quest.332B7BE663E97115.quest_desc: ["The reverse of the Puller - pushes contents out to whatever is next in line."]
	quest.332B7BE663E97115.title: "Pusher Upgrade"
	quest.332BBEB139BA8ED1.quest_desc: [
		"A homestead's better with some company in the pasture."
		"Fence in a few animals and look after them."
	]
	quest.332BBEB139BA8ED1.title: "Livestock and Care"
	quest.33315694EC8EE5A0.quest_desc: ["Let a machine take over the slicing, so your hands are free for everything else."]
	quest.33315694EC8EE5A0.title: "The Mechanical Cutter"
	quest.33785BD83B0C75CB.quest_desc: [
		"Mix it down to a fine powder - the base for anything"
		"dark and bitter."
	]
	quest.33785BD83B0C75CB.title: "Cocoa Powder"
	quest.33DE99C780CD2F42.quest_desc: [
		"Not everything in the garden is for eating."
		"Cotton grows well alongside the rest."
	]
	quest.33DE99C780CD2F42.title: "Harvest Cotton"
	quest.33E12B8AFAC48AEF.quest_desc: [
		"All three chocolates, blended and moulded into bricks."
		"This is the building block everything downstream uses."
	]
	quest.33E12B8AFAC48AEF.title: "Chocolate Bricks"
	quest.33E81C662315F287.quest_desc: [
		"Goblins never give anything away for free, but they'll always make a deal."
		"Trade with a Goblin Trader and see what they're carrying."
	]
	quest.33E81C662315F287.title: "Strike a Deal"
	quest.33FDB4C2B7B5879E.quest_desc: [
		"Run cocoa beans under a millstone or crushing wheels."
		"Every chocolate recipe in this line traces back to this step."
	]
	quest.33FDB4C2B7B5879E.title: "Crushed Cocoa"
	quest.3401A9A8323A16BC.quest_desc: [
		"Gold and Silver alloyed into Electrum wire - carries"
		"current more efficiently than Copper ever could."
	]
	quest.3401A9A8323A16BC.title: "Electrum Wiring"
	quest.34250D6B040325A5.quest_desc: [
		"A whole new set of kitchen tools begins here."
		"Craft a cutting board and start prepping."
	]
	quest.34250D6B040325A5.title: "Pam's Cutting Board"
	quest.346E1DCB3985617C.quest_desc: ["Blend it up for something cool and refreshing."]
	quest.346E1DCB3985617C.title: "Banana Smoothie"
	quest.3485224B16D608D7.quest_desc: [
		"It looks like a lantern. It burns like one, too - except the light it casts is somehow darker than the dark around it."
		"Another piece of the same arcane craft."
	]
	quest.3485224B16D608D7.title: "A Light That Isn't"
	quest.348A94BB5056BD19.quest_desc: [
		"Mesh two together and rotation changes direction."
		"Pair with a Shaft and you've got your first real machine."
	]
	quest.348A94BB5056BD19.title: "Cogwheel"
	quest.348B15D620F70D1C.quest_desc: ["A Spell Turret casts on its own - magic quietly learning to automate itself."]
	quest.348B15D620F70D1C.title: "Automated Casting"
	quest.34B396E5EA5846DE.quest_desc: ["Ten fewer things that go boom near your builds."]
	quest.34B396E5EA5846DE.title: "Creeper Bounty: Apprentice"
	quest.34E7AA279C481020.quest_desc: [
		"A garden's better with a bit of red in it."
		"Get some tomato seeds in the ground."
	]
	quest.34E7AA279C481020.title: "Growing Tomatoes"
	quest.34E97BE85383A9A9.quest_desc: [
		"Steel on your chest is one kind of ending. A horn that still answers is another."
		"Craft a dragon horn. The country remembers who learned its language."
	]
	quest.34E97BE85383A9A9.title: "Call the Sky Back"
	quest.34ED017A5666AB60.quest_desc: [
		"Relics reveal themselves through use, not explanation."
		"Keep it on you. Try it in places you wouldn't expect."
	]
	quest.34ED017A5666AB60.title: "Experiment"
	quest.351E0BDD27A3F8DC.quest_desc: [
		"Ferment it further and you've got Bioethanol -"
		"clean fuel for your generators."
	]
	quest.351E0BDD27A3F8DC.title: "Bioethanol"
	quest.3543E10A90A80E4A.quest_desc: [
		"A full stomach keeps you sprinting, jumping, healing - all of it."
		"Cook something simple and eat."
	]
	quest.3543E10A90A80E4A.title: "Fill Your Belly"
	quest.354DB392C129F6E1.quest_desc: ["Pressurized and ready to work - the heart of any steam engine."]
	quest.354DB392C129F6E1.title: "Locometal Boiler"
	quest.35677570E7D8216A.quest_desc: [
		"Forged from a storm given shape, and then given a heart."
		"It hums faintly, like it's still deciding whether to strike."
	]
	quest.35677570E7D8216A.title: "Lightning Dragonsteel Ingot"
	quest.359355E924201A2D.quest_desc: [
		"Cushions and sheets soften the room."
		"Small touches, but they're what make a house feel like home."
	]
	quest.359355E924201A2D.title: "Cozy Textiles"
	quest.359D94A257534A13.quest_desc: ["Fifty and counting. You've got a rhythm for this now."]
	quest.359D94A257534A13.title: "Zombie Bounty: Veteran"
	quest.35CB395286370908.quest_desc: [
		"A blade turns that board into a real prep station."
		"The flint knife won't win awards, but it'll do."
	]
	quest.35CB395286370908.title: "A Sharp Edge"
	quest.35D33444B8AD46C0.quest_desc: [
		"Not everything you move needs to leave the ground."
		"Build a train station alongside your airship station for cargo that's happy to stay earthbound."
	]
	quest.35D33444B8AD46C0.title: "Grounded Logistics"
	quest.3602502F660AAE1A.quest_desc: [
		"Settling in, engineering, magic, the skies, and worse things than skeletons - it's all through this book, organised so you always know where you left off."
		"Your skills grow on their own as you play. Nothing here demands grinding - just curiosity, and a willingness to open the next chapter."
	]
	quest.3602502F660AAE1A.title: "The Road Ahead"
	quest.360C8974ECF988C5.quest_desc: ["Wake your Supremium at the altar, and it becomes something the mod never quite intended."]
	quest.360C8974ECF988C5.title: "Awakened Supremium"
	quest.361E47F04272C293.quest_desc: [
		"Deep, blue, and worth every torch it took to find."
		"Diamond tools are the last stop before the world gets truly strange."
	]
	quest.361E47F04272C293.title: "Striking Diamond"
	quest.3653BEF4BB5AEADD.quest_desc: [
		"Marks where the tube system opens up."
		"Every line needs a way in."
	]
	quest.3653BEF4BB5AEADD.title: "Hypertube Entrance"
	quest.365CBEF03A407BA2.quest_desc: [
		"None of this locks you in - just gives you a feel for what's out there."
		"Chase whichever one pulled at you the most."
	]
	quest.365CBEF03A407BA2.title: "Somewhere to Start"
	quest.36677A3AD2691083.quest_desc: ["Every room deserves a proper door, and a trapdoor besides."]
	quest.36677A3AD2691083.title: "Doors and Trapdoors"
	quest.368C15E8FDC43AD0.quest_desc: ["A lockable spot to tuck away whatever you treasure most."]
	quest.368C15E8FDC43AD0.title: "Safe"
	quest.36958649AC80E5D1.quest_desc: [
		"Dragons, a Wither, and every common threat this world has thrown at you."
		"The board is finally clear."
	]
	quest.36958649AC80E5D1.title: "Master Bounty Hunter"
	quest.36990528408A1CB7.quest_desc: [
		"A propeller in your hand is just a toy."
		"Mount it on a bearing and give a contraption something to drive."
	]
	quest.36990528408A1CB7.title: "Mounted for Flight"
	quest.36BA3BCBCBC094F3.quest_desc: ["Fire and lava stop being a threat while this is on."]
	quest.36BA3BCBCBC094F3.title: "Obsidian Skull"
	quest.36EB4E9EB7EE0EF5.quest_desc: [
		"Draw Copper Rods into wire. Every electrical connection"
		"in this network starts with a spool of this."
	]
	quest.36EB4E9EB7EE0EF5.title: "Copper Wiring"
	quest.36F5ABC084BEFA7F.quest_desc: [
		"Rarer, stranger, and said to trade in things pulled straight from the rock."
		"Find and trade with a Vein Goblin Trader."
	]
	quest.36F5ABC084BEFA7F.title: "The Vein Goblin"
	quest.36F5CB860144F969.quest_desc: [
		"A hundred craters you didn't leave behind."
		"The blast resistance to prove it."
	]
	quest.36F5CB860144F969.title: "Creeper Bounty: Expert"
	quest.370FE84F407CAF82.quest_desc: [
		"Strange veins hum beneath the stone, waiting to be broken open."
		"Essence farming begins right here."
	]
	quest.370FE84F407CAF82.title: "A Curious Ore"
	quest.3748305A43E6BEA1.quest_desc: [
		"Twist sugar into stripes, no cocoa line required."
		"A quick treat you can make on the side."
	]
	quest.3748305A43E6BEA1.title: "Candy Cane"
	quest.37644AB6680A9E76.quest_desc: [
		"The wildlife here is not all hostile, and not all familiar."
		"Craft a capture net and take a closer look at something that isn't trying to eat you."
	]
	quest.37644AB6680A9E76.title: "Bring One Back Alive"
	quest.376EF18A1E51B81D.quest_desc: ["A sturdier switch for junctions that see real traffic."]
	quest.376EF18A1E51B81D.title: "Brass Track Switch"
	quest.377FD020404911D7.quest_desc: [
		"A heart, a forge, and heat most things wouldn't survive."
		"What comes out the other side is close to unbreakable."
	]
	quest.377FD020404911D7.title: "Fire Dragonsteel Ingot"
	quest.378CD1E52C074294.quest_desc: ["After enough seasons of farming and building, it all starts to come naturally."]
	quest.378CD1E52C074294.title: "A Grower's Instinct"
	quest.37B361326C516790.quest_desc: ["Sweeps nearby drops straight into the backpack as you walk."]
	quest.37B361326C516790.title: "Pickup Upgrade"
	quest.37B496F5FDA3B951.quest_desc: [
		"So many finished dishes to try."
		"Cornbread's a warm place to begin."
	]
	quest.37B496F5FDA3B951.title: "Cornbread"
	quest.37B53AAAA949A5D6.quest_desc: ["Carve Sourcestone into a Pedestal - the seed of your future Enchanting Apparatus."]
	quest.37B53AAAA949A5D6.title: "Arcane Pedestal"
	quest.37CD0E36A1DD81DF.quest_desc: ["Ten teleports too slow."]
	quest.37CD0E36A1DD81DF.title: "Enderman Bounty: Apprentice"
	quest.37E49647BBEDBA63.quest_desc: [
		"A full chestplate demanding fire, ice, and lightning all pay their toll first."
		"You don't wear this until three different dragons have already tried to stop you."
	]
	quest.37E49647BBEDBA63.title: "Fire Dragonsteel Chestplate"
	quest.37F649E0A3D53A63.quest_desc: ["Seals out the water so you can actually get work done down there."]
	quest.37F649E0A3D53A63.title: "Diving Helmet"
	quest.38289C3520926C1A.quest_desc: [
		"One panel, the whole network."
		"Monitor and control everything from a single dashboard."
	]
	quest.38289C3520926C1A.title: "Dashboard"
	quest.385F8BC5AC05E357.quest_desc: [
		"The Basin catches items and fluids; the Mixer stirs them together."
		"Between the two, half your crafting table becomes obsolete."
	]
	quest.385F8BC5AC05E357.title: "Basin \\& Mechanical Mixer"
	quest.3862846DCADE32D1.quest_desc: ["More room, more upgrade slots - a solid step up from the basic pack."]
	quest.3862846DCADE32D1.title: "Iron Backpack"
	quest.386A31D1A0EE2B3A.quest_desc: [
		"Run straight across water like it's solid ground."
		"The peak of artifact-powered mobility."
	]
	quest.386A31D1A0EE2B3A.title: "Aqua-Dashers"
	quest.386DE4CA6704B6EE.quest_desc: [
		"Picks and places between inventories, belts and depots -"
		"wherever you point it. Beats a wall of funnels."
	]
	quest.386DE4CA6704B6EE.title: "Mechanical Arm"
	quest.387AE4A87A2AAA67.quest_desc: ["Imperium Essence glows brighter than anything before it - and the climb still isn't over."]
	quest.387AE4A87A2AAA67.title: "Imperium Tier"
	quest.389306EBA71A3645.quest_desc: [
		"Take a walk. Get a feel for the biome, the neighbours, whatever's watching you back."
		"Keep your eyes open - this world hides more than it shows."
	]
	quest.389306EBA71A3645.title: "Step Outside"
	quest.38AF7EF7CA78B31C.quest_desc: ["Once you know what's coming, let redstone take it from here."]
	quest.38AF7EF7CA78B31C.title: "Build Around the Weather"
	quest.38B8C368731E86E9.quest_desc: ["Ten quivers emptied for nothing."]
	quest.38B8C368731E86E9.title: "Skeleton Bounty: Apprentice"
	quest.38D3908A487980D5.quest_desc: [
		"A kitchen that works, lighting that answers to you, a shelf for every knick-knack, and a coat of paint from three different mods."
		"It stopped being a shelter a while ago. Now it is actually, unmistakably, home."
	]
	quest.38D3908A487980D5.title: "Home, Furnished"
	quest.3931FE55F4D13B53.quest_desc: [
		"Roll a brick out and cut it into bite-sized candy."
		"Dead simple, and it belts up nicely."
	]
	quest.3931FE55F4D13B53.title: "Chocolate Candy"
	quest.394BC842E870D2C5.quest_desc: ["Runes coaxed from the Apparatus unlock glyphs your Novice book could never hold."]
	quest.394BC842E870D2C5.title: "Runes of Knowledge"
	quest.394FCA7F71AD2163.quest_desc: [
		"Carp are a fine start to a much bigger tackle box."
		"Reel a few in and get a feel for the water."
	]
	quest.394FCA7F71AD2163.title: "Catch of the Day"
	quest.3965E72BD5F60F01.quest_desc: [
		"You've seen more of this world than most people who ever load it up will."
		"The map stopped being frightening a long time ago."
	]
	quest.3965E72BD5F60F01.title: "Beyond the Horizon"
	quest.39977D2D225DB8FC.quest_desc: ["A hundred craters you didn't leave behind."]
	quest.39977D2D225DB8FC.title: "Creeper Bounty: Expert"
	quest.399F89945FFC4349.quest_desc: ["A hand-turned crank for a redstone signal, no wiring required."]
	quest.399F89945FFC4349.title: "Crank"
	quest.39D202EE41714D02.quest_desc: ["A stackable crate for keeping bulk goods neatly out of the way."]
	quest.39D202EE41714D02.title: "Storage Crate"
	quest.39EC1674DBFA2ED6.quest_desc: [
		"Every journey starts with a chopped log and a rough set of tools."
		"Nothing fancy - just enough to get moving."
	]
	quest.39EC1674DBFA2ED6.title: "First Tools"
	quest.3A1BDF87375408C4.quest_desc: ["One screen, your whole network searchable at a glance."]
	quest.3A1BDF87375408C4.title: "Storage Terminal"
	quest.3A22D6F0BFF04089.quest_desc: ["Longer, cleverer spells need a sturdier book. The Mage's Spell Book obliges."]
	quest.3A22D6F0BFF04089.title: "Mage's Spell Book"
	quest.3A254EAA4F27DBB2.quest_desc: [
		"Turn it yourself when you don't want to wait on a generator."
		"Good for testing a build before you bother automating it."
	]
	quest.3A254EAA4F27DBB2.title: "Hand Crank"
	quest.3A36F216D70212CC.quest_desc: ["Put the juicer to work on your first batch of apple juice."]
	quest.3A36F216D70212CC.title: "Fresh Apple Juice"
	quest.3A3FD2EA755FE225.quest_desc: ["Roomier still."]
	quest.3A3FD2EA755FE225.title: "Gold Backpack"
	quest.3A52D9DD62784925.quest_desc: ["Access the network from anywhere - no need to stand at a block."]
	quest.3A52D9DD62784925.title: "Wireless Terminal"
	quest.3A57E278B6D0D140.quest_desc: [
		"A whole new set of kitchen tools begins here."
		"Craft a cutting board and start prepping."
	]
	quest.3A57E278B6D0D140.title: "Pam's Cutting Board"
	quest.3A93FAAED246015A.quest_desc: [
		"There's no shortage of things to grow here."
		"Start easy, with a row of tomatoes."
	]
	quest.3A93FAAED246015A.title: "Plant Tomatoes"
	quest.3A9D541CDDBE5A39.quest_desc: [
		"Still smoldering when you pull it free of the dragon that carried it."
		"Everything a Fire Dragonsteel weapon needs to exist."
	]
	quest.3A9D541CDDBE5A39.title: "Heart of a Fire Dragon"
	quest.3ACE0A927E907C7B.quest_desc: ["One swing clears a 3x3 patch, so tunnels go a lot faster."]
	quest.3ACE0A927E907C7B.title: "Hammer"
	quest.3B04AC1C594561F8.quest_desc: [
		"Armor pieced together from scales that once belonged to something enormous."
		"Light on your back, heavy in what it says about you."
	]
	quest.3B04AC1C594561F8.title: "Dragon Scale Chestplate"
	quest.3B0702D439F0793A.quest_desc: [
		"Twist sugar into stripes, no cocoa line required."
		"A quick treat you can make on the side."
	]
	quest.3B0702D439F0793A.title: "Candy Cane"
	quest.3B074EA55D4FD8A4.quest_desc: ["Grind meat down for all the recipes that call for it."]
	quest.3B074EA55D4FD8A4.title: "The Grinder"
	quest.3B1C9EC9CF079E54.quest_desc: [
		"Smelted, forged, and sharpened against things that fear silver more than steel."
		"The undead in particular will not enjoy this."
	]
	quest.3B1C9EC9CF079E54.title: "Silver Sword"
	quest.3B53027F0C4ED1F3.quest_desc: ["Cozy up the dim corners with a couple of cage lamps."]
	quest.3B53027F0C4ED1F3.title: "Cage Lighting"
	quest.3B5F4E5F6E4D1A4C.quest_desc: [
		"A thousand spiders. That's not a fear anymore - that's a hobby."
		"Maximum Bane of Arthropods, and a piece of the Nether's finest."
	]
	quest.3B5F4E5F6E4D1A4C.title: "Spider Bounty: Legend"
	quest.3B67C73C03958D24.quest_desc: ["Stops a train dead at the end of the line, no drama."]
	quest.3B67C73C03958D24.title: "Track Buffer"
	quest.3B8A6017A0E168BD.quest_desc: [
		"So many trees to try."
		"Apples are a fine place to start an orchard."
	]
	quest.3B8A6017A0E168BD.title: "Plant an Apple Orchard"
	quest.3BA87A82B98C2265.quest_desc: [
		"Press M to open the FTB Chunks map. Claim the ground under your boots."
		"A claimed chunk is home, even before the house exists."
	]
	quest.3BA87A82B98C2265.title: "Claim Your Land"
	quest.3BBD006DABECD6DE.quest_desc: ["The deepslate version rounds out the whole lamp family nicely."]
	quest.3BBD006DABECD6DE.title: "Deepslate Lamp"
	quest.3BD002C96D1BB46D.quest_desc: [
		"Every hit you land heals you back."
		"The ultimate combat artifact - simple as that."
	]
	quest.3BD002C96D1BB46D.title: "Vampiric Glove"
	quest.3BEBFDAC0DF68570.quest_desc: [
		"A good fillet knife turns a catch into supper."
		"The wooden one's cheap, but it'll do."
	]
	quest.3BEBFDAC0DF68570.title: "Wooden Fillet Knife"
	quest.3C1073FD744A91CB.quest_desc: ["A sturdier ladder for climbs that need a bit more backbone."]
	quest.3C1073FD744A91CB.title: "Iron Ladder"
	quest.3C129E7D1A697CDC.quest_desc: [
		"Wood only gets you so far before you hit something harder."
		"Mine a little cobblestone and upgrade."
	]
	quest.3C129E7D1A697CDC.title: "Onto Stone"
	quest.3C1B5BC47DB64A53.quest_desc: [
		"Warm brick for walls that feel lived-in."
		"Start with a batch of Scarlet Bricks."
	]
	quest.3C1B5BC47DB64A53.title: "Scarlet Brick Palette"
	quest.3C29B7AE5C8B9527.quest_desc: [
		"A contraption that actually leaves the ground, and airspace you can finally call yours."
		"The sky was never really closed off. It just took you a while to get up there."
	]
	quest.3C29B7AE5C8B9527.title: "Claimed Skies"
	quest.3C3A6E84EC040DED.quest_desc: [
		"A ship without lookouts is just a slow way to hit a mountain."
		"Craft an optical sensor and give the helm something that sees farther than you do."
	]
	quest.3C3A6E84EC040DED.title: "Eyes on the Horizon"
	quest.3C5019CD14E08126.quest_desc: ["Walls and a roof make shelter. A little care makes it home."]
	quest.3C5019CD14E08126.title: "Make It Feel Like Home"
	quest.3C8BEEFC718226B0.quest_desc: [
		"Auto-compacts stored items into their block form."
		"Cobblestone and sand stop eating up so much room."
	]
	quest.3C8BEEFC718226B0.title: "Compacting Drawers"
	quest.3C92C7B5320885AF.quest_desc: [
		"Every hunter starts somewhere."
		"Put down a single Creeper."
	]
	quest.3C92C7B5320885AF.title: "Creeper Bounty: Novice"
	quest.3C9D7B24A15F3504.quest_desc: [
		"Refined Radiance and Shadow Steel, fused into a component your"
		"logic and display setups will lean on."
	]
	quest.3C9D7B24A15F3504.title: "Electron Tube"
	quest.3C9F42B5AD1CB2E8.quest_desc: ["Two rituals, one purpose: bend the clock itself when the moment calls for it."]
	quest.3C9F42B5AD1CB2E8.title: "Sunrise and Moonfall"
	quest.3CD0D7782912D305.quest_desc: ["Finish the bedroom off with a bed that's a cut above plain."]
	quest.3CD0D7782912D305.title: "A Proper Bed"
	quest.3CEAD11392741D64.quest_desc: ["Serious capacity for serious adventuring."]
	quest.3CEAD11392741D64.title: "Diamond Backpack"
	quest.3CED8E210088C5CB.quest_desc: ["Prudentium tools bite far deeper than Inferium ever could."]
	quest.3CED8E210088C5CB.title: "Prudentium Gear"
	quest.3D0641F9F5AB8524.quest_desc: ["Cold, patient, and every bit as lethal as its fiery cousin."]
	quest.3D0641F9F5AB8524.title: "Slay an Ice Dragon"
	quest.3D08022D79B1BB3A.quest_desc: [
		"There's a moment when spawn stops feeling like the center of everything."
		"Put real distance behind you and see what answers."
	]
	quest.3D08022D79B1BB3A.title: "Far From Home"
	quest.3D15F536D7D4AB5D.quest_desc: [
		"Not every crop here is ordinary."
		"Gather slime jelly for something a little stranger."
	]
	quest.3D15F536D7D4AB5D.title: "Slime Jelly"
	quest.3D1B5D76EFBDDAA3.quest_desc: ["A thousand fallen. You've earned the quiet nights."]
	quest.3D1B5D76EFBDDAA3.title: "Zombie Bounty: Legend"
	quest.3D6E3D3B8B67E43B.quest_desc: ["Sucks matching drops off the floor straight into the drawer."]
	quest.3D6E3D3B8B67E43B.title: "Magnet Upgrade"
	quest.3D8FA5996BD53844.quest_desc: [
		"Andesite alloy plating around a rotating shaft."
		"A simple frame for grinding down enchanted gear."
	]
	quest.3D8FA5996BD53844.title: "Mechanical Grindstone"
	quest.3DA639AE71E03C87.quest_desc: [
		"You no longer flinch when you find one."
		"You've started to understand what these things are - and how to make them yours."
	]
	quest.3DA639AE71E03C87.title: "A Student of Relics"
	quest.3DB0899A7456502D.quest_desc: [
		"Rarer, stranger, and said to trade in things pulled straight from the rock."
		"Find and trade with a Vein Goblin Trader."
	]
	quest.3DB0899A7456502D.title: "The Vein Goblin"
	quest.3DCDFC10DB37E44C.quest_desc: [
		"Twist sugar into stripes, no cocoa line required."
		"A quick treat you can make on the side."
	]
	quest.3DCDFC10DB37E44C.title: "Candy Cane"
	quest.3DE2C46D011A7FAD.quest_desc: ["A couch is the start of any cozy living room."]
	quest.3DE2C46D011A7FAD.title: "Living Room Couch"
	quest.3DF05FCC3E5D01F0.quest_desc: [
		"Something that crawled out of the ash and didn't stop moving."
		"Found in the scorched places of this world."
	]
	quest.3DF05FCC3E5D01F0.title: "Rare Encounter: Ashen"
	quest.3E07C1487164A345.quest_desc: ["The last base tier. Supremium gear rivals anything else you'll ever craft."]
	quest.3E07C1487164A345.title: "Supremium Tier"
	quest.3E16775793278F15.quest_desc: ["A darker take on the lamp, right at home in a nether-themed room."]
	quest.3E16775793278F15.title: "Blackstone Lamp"
	quest.3E17D68C5AE2BB2F.quest_desc: [
		"Channels mechanical power straight down into the depths."
		"The hypertube network runs on this."
	]
	quest.3E17D68C5AE2BB2F.title: "Conduit Cage"
	quest.3E3E34FB305AB3FF.quest_desc: [
		"Strange veins hum beneath the stone, waiting to be broken open."
		"Essence farming begins right here."
	]
	quest.3E3E34FB305AB3FF.title: "A Curious Ore"
	quest.3E4C5F5E0E75FB4D.quest_desc: [
		"Turns power ninety degrees, no fuss."
		"Handy the moment your build stops being a straight line."
	]
	quest.3E4C5F5E0E75FB4D.title: "Gearbox"
	quest.3E4D3F00665F3FEF.quest_desc: ["Seals out the water so you can actually get work done down there."]
	quest.3E4D3F00665F3FEF.title: "Diving Helmet"
	quest.3E6FA5C96C822410.quest_desc: ["Fancy a cooler look? Try a batch of Blue Bricks instead."]
	quest.3E6FA5C96C822410.title: "Blue Brick Palette"
	quest.3E7C74CBD20CA000.quest_desc: ["Two slots for a matched pair of items."]
	quest.3E7C74CBD20CA000.title: "Oak Drawer (1x2)"
	quest.3E9426D842B46E62.quest_desc: [
		"Take a walk. Get a feel for the biome, the neighbours, whatever's watching you back."
		"Keep your eyes open - this world hides more than it shows."
	]
	quest.3E9426D842B46E62.title: "Step Outside"
	quest.3EA99E045C8A903C.quest_desc: ["Bind your first wand. Every spell from here begins in your own two hands."]
	quest.3EA99E045C8A903C.title: "Your First Wand"
	quest.3EAA5BBDE7423DF9.quest_desc: [
		"A book that only matters once its pages are full of things you actually lived through."
		"Yours has real weight to it now."
	]
	quest.3EAA5BBDE7423DF9.title: "The Grimoire's Weight"
	quest.3ECD14F7C58F748E.quest_desc: [
		"A hearty root crop worth keeping in the pantry."
		"Plant a few and let them settle in."
	]
	quest.3ECD14F7C58F748E.title: "Plant Sweet Potatoes"
	quest.3ED6D6C659F3BAB4.quest_desc: [
		"Combat, magic, engineering, farming, wandering - you got genuinely good at more than one."
		"Not a specialist. Something a little rarer than that."
	]
	quest.3ED6D6C659F3BAB4.title: "Jack of All Trades"
	quest.3EF724C693DE8CC5.quest_desc: [
		"Alloy your first bit of andesite and you've taken your first step into Create."
		"There's a whole engineer's life waiting past this one alloy."
	]
	quest.3EF724C693DE8CC5.title: "A Taste of Engineering"
	quest.3F072CAC71F5B4A5.quest_desc: ["Head out where the water runs deep. Tuna are waiting."]
	quest.3F072CAC71F5B4A5.title: "Deep Water Catch"
	quest.3F32B9D5FBD1CE30.quest_desc: [
		"A boot that seems to forget it's supposed to be heavy."
		"Whoever crafted these understood more than simple enchanting."
	]
	quest.3F32B9D5FBD1CE30.title: "Light as Air"
	quest.3F36379149F5C897.quest_desc: [
		"A garden's better with a bit of red in it."
		"Get some tomato seeds in the ground."
	]
	quest.3F36379149F5C897.title: "Growing Tomatoes"
	quest.3F3E13704B527ED6.quest_desc: [
		"An iron rod holds up longer and finds better luck."
		"Worth the upgrade."
	]
	quest.3F3E13704B527ED6.title: "Iron Fishing Rod"
	quest.3F3E589B89164B39.quest_desc: ["Once you know what's coming, let redstone take it from here."]
	quest.3F3E589B89164B39.title: "Build Around the Weather"
	quest.3F3F445880AF50B8.quest_desc: [
		"There's no shortage of things to grow here."
		"Start easy, with a row of tomatoes."
	]
	quest.3F3F445880AF50B8.title: "Plant Tomatoes"
	quest.3F53B4E4539395FE.quest_desc: ["Bumps up capacity - first tier of the storage upgrade line."]
	quest.3F53B4E4539395FE.title: "Copper Upgrade"
	quest.3F733294AD2E59BC.quest_desc: [
		"Combos, rolls, trinkets, a skill set that's actually yours now."
		"You're not stumbling into fights anymore - you're choosing them."
	]
	quest.3F733294AD2E59BC.title: "Found Your Footing"
	quest.3F7817F0A5671105.quest_desc: [
		"Smelted, forged, and sharpened against things that fear silver more than steel."
		"The undead in particular will not enjoy this."
	]
	quest.3F7817F0A5671105.title: "Silver Sword"
	quest.3F8AF9E865241EF7.quest_desc: [
		"A true ship deserves a name, not just a pile of blocks that happens to fly."
		"Complete the ceremony that makes it official."
	]
	quest.3F8AF9E865241EF7.title: "I Declare Thee..."
	quest.3F8F2A829D911C52.quest_desc: [
		"Refined Radiance and Shadow Steel, fused into a component your"
		"logic and display setups will lean on."
	]
	quest.3F8F2A829D911C52.title: "Electron Tube"
	quest.3FAD415C5C2F3420.quest_desc: [
		"Envelope, propeller, and levitite - three disciplines, now one."
		"Craft aviator's goggles and wear the mark of someone who belongs up here."
	]
	quest.3FAD415C5C2F3420.title: "Aviator's Goggles"
	quest.3FCF7AE9433167C9.quest_desc: ["Runs the network around corners and across distance."]
	quest.3FCF7AE9433167C9.title: "Inventory Cable"
	quest.3FD486C77880DA03.quest_desc: [
		"Keeps an eye on tube traffic as it moves through the network."
		"About as far as aquatic engineering goes."
	]
	quest.3FD486C77880DA03.title: "Tube Scanner Attachment"
	quest.400EABEF2DDFD878.quest_desc: ["Runes coaxed from the Apparatus unlock glyphs your Novice book could never hold."]
	quest.400EABEF2DDFD878.title: "Runes of Knowledge"
	quest.4034AE3AEA4800E6.quest_desc: ["Shell plating for extra protection out on aquatic jobs."]
	quest.4034AE3AEA4800E6.title: "Turtle Chestplate"
	quest.40456C5F5CB3ABB1.quest_desc: ["A softer take on glass, framed in wood and dyed to match any room."]
	quest.40456C5F5CB3ABB1.title: "Framed Glass"
	quest.404EA61C9FAA85FB.quest_desc: ["A wall-mounted light that warms up any hallway."]
	quest.404EA61C9FAA85FB.title: "Sconce"
	quest.4054311C7CFE4844.quest_desc: [
		"Zinc, Iron and Andesite, melted together into the stuff that holds"
		"the rest of this pack up. Keep a stockpile going."
	]
	quest.4054311C7CFE4844.title: "Andesite Alloy"
	quest.40596A33688380E6.quest_desc: [
		"A decorative block made from compressed turtle scutes."
		"A stylish way to show off your turtle-taming skills - nothing to do with the hypertube."
	]
	quest.40596A33688380E6.title: "Turtle Scute Block"
	quest.405B287D9CDC8A12.quest_desc: ["A Blank Scroll is where every travel scroll starts."]
	quest.405B287D9CDC8A12.title: "Blank Scroll"
	quest.406ED4C649675B1E.quest_desc: [
		"Fifty and counting. You've got a rhythm for this now."
		"A Smite charm, for the undead that still give you trouble."
	]
	quest.406ED4C649675B1E.title: "Zombie Bounty: Veteran"
	quest.406EE3F6E657FB4D.quest_desc: ["One blast and the platform knows it's time to go."]
	quest.406EE3F6E657FB4D.title: "Conductor's Whistle"
	quest.407784E222AE0182.quest_desc: [
		"A Shovel for digging, a Cleaver for mobs -"
		"rounds out the Blazing set nicely."
	]
	quest.407784E222AE0182.title: "Blazing Shovel \\& Cleaver"
	quest.408B1CE91A51CA02.quest_desc: ["Reinforced with nautilus shell - dive deeper, stay under longer."]
	quest.408B1CE91A51CA02.title: "Nautilus Helmet"
	quest.4098A2E94049564F.quest_desc: [
		"Run cocoa beans under a millstone or crushing wheels."
		"Every chocolate recipe in this line traces back to this step."
	]
	quest.4098A2E94049564F.title: "Crushed Cocoa"
	quest.4099F2BEC1BE5479.quest_desc: ["One blast and the platform knows it's time to go."]
	quest.4099F2BEC1BE5479.title: "Conductor's Whistle"
	quest.40BC76F51F5E9617.quest_desc: [
		"Shed scales, still warm, gathered where dragons rest or fall."
		"Light enough to move in, tough enough to matter."
	]
	quest.40BC76F51F5E9617.title: "Dragon Scales"
	quest.40D1ED226AF5A2B5.quest_desc: ["Matching slabs and stairs round the set out nicely."]
	quest.40D1ED226AF5A2B5.title: "Brick Shapes"
	quest.40D90F5EF6E0EBFA.quest_desc: [
		"Not everything you move needs to leave the ground."
		"Build a train station alongside your airship station for cargo that's happy to stay earthbound."
	]
	quest.40D90F5EF6E0EBFA.title: "Grounded Logistics"
	quest.4101CE199E1B605F.quest_desc: [
		"A blade turns that board into a real prep station."
		"The flint knife won't win awards, but it'll do."
	]
	quest.4101CE199E1B605F.title: "A Sharp Edge"
	quest.412C91A5E7E28AD7.quest_desc: ["The blank slate every backpack upgrade is built from."]
	quest.412C91A5E7E28AD7.title: "Upgrade Base"
	quest.414714151E924C3E.quest_desc: [
		"Ferment it further and you've got Bioethanol -"
		"clean fuel for your generators."
	]
	quest.414714151E924C3E.title: "Bioethanol"
	quest.414A9B5FB48DF3DA.quest_desc: ["A Spell Turret casts on its own - magic quietly learning to automate itself."]
	quest.414A9B5FB48DF3DA.title: "Automated Casting"
	quest.4152E3E41BA6013D.quest_desc: [
		"A matched pair sends rotational power wirelessly."
		"Run machinery clear across your base without laying a single shaft."
	]
	quest.4152E3E41BA6013D.title: "Kinetic Bridge"
	quest.417AF486AD0C8C95.quest_desc: [
		"Straps on over your chestplate and speeds up mining"
		"and movement both. Your first taste of powered gear."
	]
	quest.417AF486AD0C8C95.title: "Copper Exoskeleton"
	quest.4189E961BC5FE40A.quest_desc: [
		"Raise one at every junction."
		"Keeps two trains from ever meeting somewhere they shouldn't."
	]
	quest.4189E961BC5FE40A.title: "Raise a Semaphore"
	quest.418C7E316627C319.quest_desc: [
		"Near a crafting table, in a hole in the ground - that's where every story here begins."
		"The horizon has been waiting this whole time."
	]
	quest.418C7E316627C319.title: "First Steps Beyond"
	quest.419CA9CE7EE0CC96.quest_desc: [
		"Enchanting machinery, a functioning hypertube network, armored divers, and your own rail line."
		"This is what Create looks like once the basics stop being enough."
	]
	quest.419CA9CE7EE0CC96.title: "The Advanced Engineer"
	quest.419E1D628ED355FE.quest_desc: ["Keeps an eye out for anything living that wanders past."]
	quest.419E1D628ED355FE.title: "Ender Watcher"
	quest.41A555F569219AA9.quest_desc: ["More room, more upgrade slots - a solid step up from the basic pack."]
	quest.41A555F569219AA9.title: "Iron Backpack"
	quest.41A5CE56318D938A.quest_desc: [
		"A wearable container with slots to spare for upgrades."
		"Where the whole backpack line begins."
	]
	quest.41A5CE56318D938A.title: "Basic Backpack"
	quest.41BB5CD2A80419B6.quest_desc: ["The blank slate every backpack upgrade is built from."]
	quest.41BB5CD2A80419B6.title: "Upgrade Base"
	quest.41E08F5BE48C0A5D.quest_desc: [
		"An iron rod holds up longer and finds better luck."
		"Worth the upgrade."
	]
	quest.41E08F5BE48C0A5D.title: "Iron Fishing Rod"
	quest.41FBF176A789CB06.quest_desc: [
		"Mesh with a regular Cogwheel and you can gear speed up or down."
		"Simple as that."
	]
	quest.41FBF176A789CB06.title: "Large Cogwheel"
	quest.4216A892B49E984C.quest_desc: ["For the angler who's serious about it. A diamond rod earns its keep."]
	quest.4216A892B49E984C.title: "Diamond Fishing Rod"
	quest.424300162192653E.quest_desc: [
		"A tiny, endlessly patient farmhand."
		"Set it loose on a field and let it harvest while you do something else entirely."
	]
	quest.424300162192653E.title: "Befriend a Drygmy"
	quest.427AD04A1850FEC8.quest_desc: [
		"A blade carved from the bones of something that used to be unstoppable."
		"Your first real answer to dragon country."
	]
	quest.427AD04A1850FEC8.title: "Dragon Bone Sword"
	quest.4281EED64D460814.quest_desc: [
		"A pale ore veined through the deep rock, waiting to be melted down."
		"The first ingredient in gear built for things that don't die easy."
	]
	quest.4281EED64D460814.title: "Silver Ore"
	quest.428398820ECD9C43.quest_desc: [
		"None of this locks you in - just gives you a feel for what's out there."
		"Chase whichever one pulled at you the most."
	]
	quest.428398820ECD9C43.title: "Somewhere to Start"
	quest.42C7B7C9C34034D4.quest_desc: ["Wake your Supremium at the altar, and it becomes something the mod never quite intended."]
	quest.42C7B7C9C34034D4.title: "Awakened Supremium"
	quest.42EA00D7D490C553.quest_desc: [
		"You've seen more of this world than most people who ever load it up will."
		"The map stopped being frightening a long time ago."
	]
	quest.42EA00D7D490C553.title: "Beyond the Horizon"
	quest.42EDEC893136799A.quest_desc: ["More room, more upgrade slots - a solid step up from the basic pack."]
	quest.42EDEC893136799A.title: "Iron Backpack"
	quest.4320D50A666F26EC.quest_desc: ["A Blank Scroll is where every travel scroll starts."]
	quest.4320D50A666F26EC.title: "Blank Scroll"
	quest.432694823CC6D856.quest_desc: ["Prudentium tools bite far deeper than Inferium ever could."]
	quest.432694823CC6D856.title: "Prudentium Gear"
	quest.4327CA00F11CED91.quest_desc: [
		"Rattling bones, aimed arrows."
		"Silence one."
	]
	quest.4327CA00F11CED91.title: "Skeleton Bounty: Novice"
	quest.434B01162ACEDEEA.quest_desc: ["Arm a villager and give your village its first line of defense."]
	quest.434B01162ACEDEEA.title: "Hire a Guard"
	quest.435CB577C3A127B9.quest_desc: ["Bare-handed mining just got a lot less bare."]
	quest.435CB577C3A127B9.title: "Digging Claws"
	quest.436E20DC530219EE.quest_desc: ["Keeps the fire fed - no fuel, no steam."]
	quest.436E20DC530219EE.title: "Fuel Tank"
	quest.4378DAD92523844C.quest_desc: [
		"Thrust alone won't keep you up forever - you need lift."
		"Sew an envelope and encase a shaft within it: together, the heart of a proper balloon."
	]
	quest.4378DAD92523844C.title: "Catching the Wind"
	quest.4388FCF32EBFA5CA.quest_desc: [
		"Raise one at every junction."
		"Keeps two trains from ever meeting somewhere they shouldn't."
	]
	quest.4388FCF32EBFA5CA.title: "Raise a Semaphore"
	quest.439578BA71372970.quest_desc: ["Arm a villager and give your village its first line of defense."]
	quest.439578BA71372970.title: "Hire a Guard"
	quest.439FB9BC3E8C9C8A.quest_desc: ["A placard and a decal help everyone find their way around."]
	quest.439FB9BC3E8C9C8A.title: "Signage and Decals"
	quest.439FEC61CB64CC0A.quest_desc: ["Essence sharpens as well as it grows. Forge a pick and blade to call the first tier mastered."]
	quest.439FEC61CB64CC0A.title: "Tools of Essence"
	quest.43C39163F9606417.quest_desc: [
		"The stove is the heart of a proper kitchen."
		"It's what gets the skillet going."
	]
	quest.43C39163F9606417.title: "Fire Up the Stove"
	quest.43CF39285DFA3F88.quest_desc: ["The key that opens the safe, and anything else you've locked up."]
	quest.43CF39285DFA3F88.title: "Key"
	quest.4427814FE653B1D0.quest_desc: [
		"Program a string of rotational steps and it repeats them"
		"exactly, every time. This is how contraptions stop needing you."
	]
	quest.4427814FE653B1D0.title: "Sequenced Gearshift"
	quest.44298589DA5C1B55.quest_desc: ["A couch is the start of any cozy living room."]
	quest.44298589DA5C1B55.title: "Living Room Couch"
	quest.4429BD3484FCEBA6.quest_desc: ["Locks the network down to you and you alone."]
	quest.4429BD3484FCEBA6.title: "Personal Key"
	quest.443FA6222FE31F49.quest_desc: [
		"Brings your casing and linking branches together into one"
		"precision part - the base of something bigger."
	]
	quest.443FA6222FE31F49.title: "Incomplete Control Chip"
	quest.444A764FCAB0E776.quest_desc: ["Tomato sauce and fresh onions, brought together into a rustic little classic."]
	quest.444A764FCAB0E776.title: "Ratatouille"
	quest.446A7B9831EBFC25.quest_desc: [
		"Every good defense starts with a shield."
		"Craft one before the raiders come knocking."
	]
	quest.446A7B9831EBFC25.title: "Arm Yourself"
	quest.44932003DD519EF5.quest_desc: [
		"Altitude is bragging. Remaining upright is seamanship."
		"Build a gyroscopic mechanism so the deck stays a deck."
	]
	quest.44932003DD519EF5.title: "Keep Her Steady"
	quest.44DDD6F8DEF209E8.quest_desc: [
		"A ship this valuable needs protecting - from raiders, from griefers, from anyone who isn't you."
		"Place a claim block aboard and bring it under your protection, wherever it flies."
	]
	quest.44DDD6F8DEF209E8.title: "Claim the Skies"
	quest.44EB1901350A2435.quest_desc: [
		"None of this locks you in - just gives you a feel for what's out there."
		"Chase whichever one pulled at you the most."
	]
	quest.44EB1901350A2435.title: "Somewhere to Start"
	quest.45029FEDDA28B625.quest_desc: [
		"Envelope, propeller, and levitite - three disciplines, now one."
		"Craft aviator's goggles and wear the mark of someone who belongs up here."
	]
	quest.45029FEDDA28B625.title: "Aviator's Goggles"
	quest.451AFC005C44B935.quest_desc: ["Serious capacity for serious adventuring."]
	quest.451AFC005C44B935.title: "Diamond Backpack"
	quest.451D4003DDEA769D.quest_desc: [
		"Some of what you've found doesn't just feel powerful."
		"It feels arcane. Deliberate. Like it was made, not found. Somewhere, there may be an explanation."
	]
	quest.451D4003DDEA769D.title: "Something Stranger Still"
	quest.453A501BE4F6ECE5.quest_desc: ["Every home needs somewhere to sit down."]
	quest.453A501BE4F6ECE5.title: "Take a Seat"
	quest.454263D4F34769DB.quest_desc: [
		"A good fillet knife turns a catch into supper."
		"The wooden one's cheap, but it'll do."
	]
	quest.454263D4F34769DB.title: "Wooden Fillet Knife"
	quest.454AA0E1DAFE859F.quest_desc: [
		"Press instead of mix and you get cocoa butter,"
		"the fatty base behind the paler chocolates."
	]
	quest.454AA0E1DAFE859F.title: "Cocoa Butter"
	quest.4552584E99603EA9.quest_desc: [
		"Thrust alone won't keep you up forever - you need lift."
		"Sew an envelope and encase a shaft within it: together, the heart of a proper balloon."
	]
	quest.4552584E99603EA9.title: "Catching the Wind"
	quest.45566AAB8225966E.quest_desc: ["A dressed-up controller for the room you actually want to look at."]
	quest.45566AAB8225966E.title: "Framed Drawer Controller"
	quest.455CB7A1B33E959C.quest_desc: [
		"A construct of bone and spite, built to end you."
		"End it first."
	]
	quest.455CB7A1B33E959C.title: "Slay the Wither"
	quest.45843196261EA6A3.quest_desc: ["The key that opens the safe, and anything else you've locked up."]
	quest.45843196261EA6A3.title: "Key"
	quest.45A15B76871453DE.quest_desc: [
		"Bind an amethyst shard, a writable book, and spruce wood together."
		"What results is no ordinary book - it's a record of arcane augmentation, waiting to be filled."
	]
	quest.45A15B76871453DE.title: "The Skills Grimoire"
	quest.45C9EC1EC675ECCF.quest_desc: [
		"Make a big batch and keep it close."
		"A bucket of stew never goes to waste."
	]
	quest.45C9EC1EC675ECCF.title: "Stew by the Bucket"
	quest.4664CE022C516858.quest_desc: [
		"Warm brick for walls that feel lived-in."
		"Start with a batch of Scarlet Bricks."
	]
	quest.4664CE022C516858.title: "Scarlet Brick Palette"
	quest.468867093B11C957.quest_desc: ["A classic dessert, sweet with cherries from your own trees."]
	quest.468867093B11C957.title: "Cherry Pie"
	quest.468FBB1E3C898F91.quest_desc: [
		"Cold even in your hand, taken from a dragon that never once blinked."
		"The Ice Dragonsteel line begins here."
	]
	quest.468FBB1E3C898F91.title: "Heart of an Ice Dragon"
	quest.46945DE21F993861.quest_desc: [
		"Run cocoa beans under a millstone or crushing wheels."
		"Every chocolate recipe in this line traces back to this step."
	]
	quest.46945DE21F993861.title: "Crushed Cocoa"
	quest.469B91AB07E71694.quest_desc: [
		"A whole new set of kitchen tools begins here."
		"Craft a cutting board and start prepping."
	]
	quest.469B91AB07E71694.title: "Pam's Cutting Board"
	quest.46F5D464B29B4519.quest_desc: ["Bottled experience, ready to feed into upgrades that run on XP."]
	quest.46F5D464B29B4519.title: "Bucket of Experience"
	quest.46FD6B0FC5AB9F3A.quest_desc: ["A hundred down. You don't flinch at cobwebs anymore."]
	quest.46FD6B0FC5AB9F3A.title: "Spider Bounty: Expert"
	quest.47007D2D2B4CB8E5.quest_desc: [
		"Standing still is how you get hit."
		"Learn the combat roll, time it right, and watch the attack sail past."
	]
	quest.47007D2D2B4CB8E5.title: "Dodge and Roll"
	quest.47189CCDE4076DAA.quest_desc: [
		"Finishes off the frame with a sleeker profile."
		"Run it through the Train Assembly tool and your first true locomotive is ready to roll."
	]
	quest.47189CCDE4076DAA.title: "Streamlined Smokestack"
	quest.47220F88BA662C4F.quest_desc: ["Grind Prosperity Ore into shards, the quiet currency behind Soulium craft."]
	quest.47220F88BA662C4F.title: "Prosperity Shards"
	quest.4726EFBF134D3E6F.quest_desc: [
		"Fifty and counting. You've got a rhythm for this now."
		"A Smite charm, for the undead that still give you trouble."
	]
	quest.4726EFBF134D3E6F.title: "Zombie Bounty: Veteran"
	quest.4727859E7971E95A.quest_desc: ["The Archmage Spell Book holds spells long enough to stop feeling like experiments and start feeling like spellcraft."]
	quest.4727859E7971E95A.title: "Archmage Spell Book"
	quest.472BAA4C285C9CBC.quest_desc: [
		"Warm brick for walls that feel lived-in."
		"Start with a batch of Scarlet Bricks."
	]
	quest.472BAA4C285C9CBC.title: "Scarlet Brick Palette"
	quest.472CC9F0ED23081F.quest_desc: [
		"Somewhere between the first seed and the hundredth harvest, the farm became something else entirely."
		"Magic, grown patiently rather than mined."
	]
	quest.472CC9F0ED23081F.title: "A Green Thumb's Legacy"
	quest.473FFAE35E805851.quest_desc: ["Top-tier capacity, for when you're storing by the thousands."]
	quest.473FFAE35E805851.title: "Diamond Upgrade"
	quest.47743D73390E789F.quest_desc: [
		"Every explorer starts leaving their own trail of shortcuts and landmarks eventually."
		"You may already have a Waystone or two out there without calling it anything special."
	]
	quest.47743D73390E789F.title: "Marks on the Map"
	quest.477BD541B9D4D8B5.quest_desc: ["Grind meat down for all the recipes that call for it."]
	quest.477BD541B9D4D8B5.title: "The Grinder"
	quest.477FA41C0BD48CD9.quest_desc: ["Serves no purpose at all, and somehow that's exactly the charm."]
	quest.477FA41C0BD48CD9.title: "Tiny Potato"
	quest.47BCA59D1D432DEB.quest_desc: [
		"Automate the grinding itself and you get a steady drip"
		"of both items and XP."
	]
	quest.47BCA59D1D432DEB.title: "Mechanical Grindstone"
	quest.47EC8ACE75ED9688.quest_desc: [
		"Wood only gets you so far before you hit something harder."
		"Mine a little cobblestone and upgrade."
	]
	quest.47EC8ACE75ED9688.title: "Onto Stone"
	quest.481EBB5E31763C4D.quest_desc: ["Souls refine into Soulium, and Soulium into a blade quick enough to earn its name."]
	quest.481EBB5E31763C4D.title: "Blade of Souls"
	quest.4820F0EDA0E56DFF.quest_desc: [
		"Compacts stored items into blocks automatically."
		"The capstone drawer for a maxed-out storage room."
	]
	quest.4820F0EDA0E56DFF.title: "Compacting Drawer"
	quest.48297107D8A952C9.quest_desc: ["A wall-mounted light that warms up any hallway."]
	quest.48297107D8A952C9.title: "Sconce"
	quest.483745E08C422239.quest_desc: ["Magebloom woven into robes light enough that spellcasting never feels encumbered."]
	quest.483745E08C422239.title: "Arcanist's Robes"
	quest.487FFF6EAE286E4F.quest_desc: ["Simmer your tomatoes down into something worth saving."]
	quest.487FFF6EAE286E4F.title: "Tomato Sauce"
	quest.48932D919E8DF050.quest_desc: ["The key that opens the safe, and anything else you've locked up."]
	quest.48932D919E8DF050.title: "Key"
	quest.489DBBABDB8F2EF9.quest_desc: [
		"Cargo won't sort and route itself - well, almost."
		"Craft a logistics terminal and automate the flow of goods through your station."
	]
	quest.489DBBABDB8F2EF9.title: "Logistics Network"
	quest.48A325A2DF74CE99.quest_desc: ["Top-tier capacity, for when you're storing by the thousands."]
	quest.48A325A2DF74CE99.title: "Diamond Upgrade"
	quest.48A87E5BDF643E58.quest_desc: [
		"Feed it Blaze Cake and it superheats whatever's sitting above it."
		"Unlocks the hotter alloying recipes, Brass included."
	]
	quest.48A87E5BDF643E58.title: "Blaze Burner"
	quest.48BC2F61D5F30E86.quest_desc: [
		"Cargo won't sort and route itself - well, almost."
		"Craft a logistics terminal and automate the flow of goods through your station."
	]
	quest.48BC2F61D5F30E86.title: "Logistics Network"
	quest.48BDE71A3DDE67A8.quest_desc: ["Two slots for a matched pair of items."]
	quest.48BDE71A3DDE67A8.title: "Oak Drawer (1x2)"
	quest.48CCA05EA6CBF498.quest_desc: ["One blast and the platform knows it's time to go."]
	quest.48CCA05EA6CBF498.title: "Conductor's Whistle"
	quest.491545B0266005B3.quest_desc: ["A friendly signpost pointing visitors toward the notice board, and beyond."]
	quest.491545B0266005B3.title: "Way Sign"
	quest.49408B6513A1C441.quest_desc: ["A crate cut from the same wood as the barrel beside it."]
	quest.49408B6513A1C441.title: "Matching Crate"
	quest.4960210E97568C88.quest_desc: [
		"Stolen from a nest perched somewhere no sane creature builds a home."
		"Raise it right and it will carry you further than your legs ever could."
	]
	quest.4960210E97568C88.title: "Hippogryph Egg"
	quest.4981331D6E342144.quest_desc: [
		"So many trees to try."
		"Apples are a fine place to start an orchard."
	]
	quest.4981331D6E342144.title: "Plant an Apple Orchard"
	quest.49825DD236FDC8C3.quest_desc: [
		"Calcium powder and prismarine crystals, fused together."
		"Everything underwater gets built on this."
	]
	quest.49825DD236FDC8C3.title: "Prismarine Alloy"
	quest.499AC2ECF353C6D0.quest_desc: [
		"The payoff for the whole network: a Tesla Coil that lets"
		"your stored power go out with a bang."
	]
	quest.499AC2ECF353C6D0.title: "Tesla Coil"
	quest.49A6DD5C164206AB.quest_desc: [
		"You hear the clatter of a loaded pack before you ever see who's carrying it."
		"Track down a Goblin Trader out in the world."
	]
	quest.49A6DD5C164206AB.title: "A Jingle in the Distance"
	quest.49CC35EAE43D5C04.quest_desc: ["Longer, cleverer spells need a sturdier book. The Mage's Spell Book obliges."]
	quest.49CC35EAE43D5C04.title: "Mage's Spell Book"
	quest.49D0B0011869F958.quest_desc: ["Tomato sauce and fresh onions, brought together into a rustic little classic."]
	quest.49D0B0011869F958.title: "Ratatouille"
	quest.4A10F427D73A2890.quest_desc: ["Charm a Starbuncle into friendship, and it'll spend its days gathering on your behalf."]
	quest.4A10F427D73A2890.title: "Befriend a Starbuncle"
	quest.4A1117E5531DFCB2.quest_desc: [
		"Melt a brick down into a proper drink."
		"A fitting reward for a fully automated cocoa line."
	]
	quest.4A1117E5531DFCB2.title: "Hot Chocolate"
	quest.4A351993A0E74751.quest_desc: [
		"Odd-shaped and easy to miss on the seafloor."
		"Crack it open and it's usually worth the detour."
	]
	quest.4A351993A0E74751.title: "Suspicious Rock"
	quest.4A43F1A5E9D30894.quest_desc: [
		"Make a big batch and keep it close."
		"A bucket of stew never goes to waste."
	]
	quest.4A43F1A5E9D30894.title: "Stew by the Bucket"
	quest.4A55DDA638D1FCF1.quest_desc: [
		"Flattens metal into sheets, or set it over a Basin for"
		"compacting recipes. One tool, two jobs."
	]
	quest.4A55DDA638D1FCF1.title: "Mechanical Press"
	quest.4A70E6AB11CDFB35.quest_desc: ["A hundred. Villages sleep easier because of you."]
	quest.4A70E6AB11CDFB35.title: "Zombie Bounty: Expert"
	quest.4A776BDA7875F7C7.quest_desc: ["Cozy up the dim corners with a couple of cage lamps."]
	quest.4A776BDA7875F7C7.title: "Cage Lighting"
	quest.4AA03094324A3BDD.quest_desc: ["A hundred. The End itself is starting to feel routine."]
	quest.4AA03094324A3BDD.title: "Enderman Bounty: Expert"
	quest.4AA1586E86CF11D6.quest_desc: ["The Imbuement Chamber lets essence seep into gear, leaving it quietly magical."]
	quest.4AA1586E86CF11D6.title: "Imbuement Chamber"
	quest.4AA21C18BE1D9216.quest_desc: [
		"Point it anywhere and feel the pull toward whatever biome you're chasing."
		"No more blind wandering, hoping the terrain agrees with you."
	]
	quest.4AA21C18BE1D9216.title: "Nature's Compass"
	quest.4AD3C60F7FF5B5C9.quest_desc: ["Turn fruit from the orchard into something worth drinking."]
	quest.4AD3C60F7FF5B5C9.title: "The Juicer"
	quest.4AE88B28F50FB8E7.quest_desc: [
		"Combos, rolls, trinkets, a skill set that's actually yours now."
		"You're not stumbling into fights anymore - you're choosing them."
	]
	quest.4AE88B28F50FB8E7.title: "Found Your Footing"
	quest.4AFE1459150D7852.quest_desc: ["Gathers up loose seeds as you tend the fields, so you don't have to."]
	quest.4AFE1459150D7852.title: "Seed Pouch"
	quest.4B08665F18BA330C.quest_desc: [
		"Rarer, stranger, and said to trade in things pulled straight from the rock."
		"Find and trade with a Vein Goblin Trader."
	]
	quest.4B08665F18BA330C.title: "The Vein Goblin"
	quest.4B249899BBB7D396.quest_desc: [
		"Hand it an item and it'll punch, place or craft just like"
		"you would. Automated hands, basically."
	]
	quest.4B249899BBB7D396.title: "Deployer"
	quest.4B25DD74E41734CE.quest_desc: [
		"Still smoldering when you pull it free of the dragon that carried it."
		"Everything a Fire Dragonsteel weapon needs to exist."
	]
	quest.4B25DD74E41734CE.title: "Heart of a Fire Dragon"
	quest.4B33E2311CC1D78B.quest_desc: ["A softer take on glass, framed in wood and dyed to match any room."]
	quest.4B33E2311CC1D78B.title: "Framed Glass"
	quest.4B6F984780CDB219.quest_desc: [
		"Fifty. Even the caves feel less crawly."
		"A Bane of Arthropods charm, well overdue."
	]
	quest.4B6F984780CDB219.title: "Spider Bounty: Veteran"
	quest.4B75AADAA7621B1D.quest_desc: [
		"Regulates current flow for the heavier machinery"
		"further down the line."
	]
	quest.4B75AADAA7621B1D.title: "Capacitor"
	quest.4B764A8ECA4A9E6D.quest_desc: [
		"Regulates current flow for the heavier machinery"
		"further down the line."
	]
	quest.4B764A8ECA4A9E6D.title: "Capacitor"
	quest.4B9C0263E0E760C2.quest_desc: ["Grind meat down for all the recipes that call for it."]
	quest.4B9C0263E0E760C2.title: "The Grinder"
	quest.4BAD336068477B03.quest_desc: ["Blend it up for something cool and refreshing."]
	quest.4BAD336068477B03.title: "Banana Smoothie"
	quest.4BB7F2E7D9E40153.quest_desc: ["Two slots for a matched pair of items."]
	quest.4BB7F2E7D9E40153.title: "Oak Drawer (1x2)"
	quest.4BB8ECFCC2FB309C.quest_desc: [
		"No more spinning propellers by hand - it's time for real self-contained power."
		"Build a portable engine and work it up into a finished engine assembly."
	]
	quest.4BB8ECFCC2FB309C.title: "Building an Engine"
	quest.4BE42F01D74F439A.quest_desc: ["Soft, magic-soaked stone, gathered wherever Source Gems are found."]
	quest.4BE42F01D74F439A.title: "Sourcestone"
	quest.4BEC8082B2980336.quest_desc: [
		"Roll a brick out and cut it into bite-sized candy."
		"Dead simple, and it belts up nicely."
	]
	quest.4BEC8082B2980336.title: "Chocolate Candy"
	quest.4BF58DFEE335ECCF.quest_desc: [
		"Source Gems hum quietly near deposits of Sourcestone, holding the energy every spell will draw from."
		"Gather a handful to begin."
	]
	quest.4BF58DFEE335ECCF.title: "Gems of Source"
	quest.4C26F9BF3C40D0F2.quest_desc: [
		"Two habits will save you hours out here."
		"Press U over an item for its recipe in JEI, and let Jade tell you what you're looking at."
	]
	quest.4C26F9BF3C40D0F2.title: "Learn Your Tools"
	quest.4C28FA3AF6116001.quest_desc: ["A low brick wall gives the yard a tidy edge."]
	quest.4C28FA3AF6116001.title: "Brick Wall"
	quest.4C38F866DC4C1ABC.quest_desc: ["A simple shelf for books, pots, and the odd knick-knack."]
	quest.4C38F866DC4C1ABC.title: "Bookshelf"
	quest.4C41A882046E4CF6.quest_desc: ["A softer take on glass, framed in wood and dyed to match any room."]
	quest.4C41A882046E4CF6.title: "Framed Glass"
	quest.4C4D38F82F6107B6.quest_desc: [
		"A drawer, a piston, some iron and stone."
		"Automatically compacts its contents into their block form."
	]
	quest.4C4D38F82F6107B6.title: "Compacting Drawer"
	quest.4C569F59F00E540F.quest_desc: [
		"Build a cutting board and dinner stops being an afterthought."
		"A whole kitchen's worth of possibilities starts right here."
	]
	quest.4C569F59F00E540F.title: "A Taste of Farming"
	quest.4C64DF2BBD745AA6.quest_desc: ["A low brick wall gives the yard a tidy edge."]
	quest.4C64DF2BBD745AA6.title: "Brick Wall"
	quest.4C6E536B63AF4B6C.quest_desc: [
		"Bolt on Windmill Sails and output climbs with every one you add."
		"Big footprint, bigger payoff."
	]
	quest.4C6E536B63AF4B6C.title: "Windmill Bearing"
	quest.4CB2934A3B7A6A1A.quest_desc: [
		"Two wheels spinning against each other, crushing ore for"
		"a shot at bonus output. Worth the setup."
	]
	quest.4CB2934A3B7A6A1A.title: "Crushing Wheels"
	quest.4CC40238162997B6.quest_desc: ["Slow, sturdy, and happy to fight on your behalf while you focus on the spellwork."]
	quest.4CC40238162997B6.title: "Befriend an Amethyst Golem"
	quest.4CCF082BD2573CD9.quest_desc: ["Every home needs somewhere to sit down."]
	quest.4CCF082BD2573CD9.title: "Take a Seat"
	quest.4CD1B113E34FDF3A.quest_desc: [
		"Near a crafting table, in a hole in the ground - that's where every story here begins."
		"The horizon has been waiting this whole time."
	]
	quest.4CD1B113E34FDF3A.title: "First Steps Beyond"
	quest.4CD60E0FF56FC300.quest_desc: [
		"A pale ore veined through the deep rock, waiting to be melted down."
		"The first ingredient in gear built for things that don't die easy."
	]
	quest.4CD60E0FF56FC300.title: "Silver Ore"
	quest.4CFAD4C25A90061D.quest_desc: [
		"Feed it Blaze Cake and it superheats whatever's sitting above it."
		"Unlocks the hotter alloying recipes, Brass included."
	]
	quest.4CFAD4C25A90061D.title: "Blaze Burner"
	quest.4D0C84307F691DE2.quest_desc: [
		"A wand and a little stored Source are enough to bind your first spell book."
		"Simple glyphs, simple experiments."
	]
	quest.4D0C84307F691DE2.title: "Novice Spell Book"
	quest.4D19BC222788A77D.quest_desc: ["Keeps the fire fed - no fuel, no steam."]
	quest.4D19BC222788A77D.title: "Fuel Tank"
	quest.4D1A2D62D87F2D46.quest_desc: [
		"An iron rod holds up longer and finds better luck."
		"Worth the upgrade."
	]
	quest.4D1A2D62D87F2D46.title: "Iron Fishing Rod"
	quest.4D40EF878BBC46BA.quest_desc: [
		"Rarer, stranger, and said to trade in things pulled straight from the rock."
		"Find and trade with a Vein Goblin Trader."
	]
	quest.4D40EF878BBC46BA.title: "The Vein Goblin"
	quest.4D451611266D529F.quest_desc: [
		"Regulates current flow for the heavier machinery"
		"further down the line."
	]
	quest.4D451611266D529F.title: "Capacitor"
	quest.4D47864AA963D12E.quest_desc: [
		"A homestead's better with some company in the pasture."
		"Fence in a few animals and look after them."
	]
	quest.4D47864AA963D12E.title: "Livestock and Care"
	quest.4D57B15DDB621C27.quest_desc: ["Serves no purpose at all, and somehow that's exactly the charm."]
	quest.4D57B15DDB621C27.title: "Tiny Potato"
	quest.4D8F62D829DEC8EF.quest_desc: [
		"Feed it your levels and it turns them into Liquid Experience."
		"Every automated enchanter starts right here."
	]
	quest.4D8F62D829DEC8EF.title: "Experience Hatch"
	quest.4DAB12AD8285F069.quest_desc: ["Runes coaxed from the Apparatus unlock glyphs your Novice book could never hold."]
	quest.4DAB12AD8285F069.title: "Runes of Knowledge"
	quest.4DBD901662764001.quest_desc: [
		"All three chocolates, blended and moulded into bricks."
		"This is the building block everything downstream uses."
	]
	quest.4DBD901662764001.title: "Chocolate Bricks"
	quest.4DBFAD9F2A98347E.quest_desc: ["A sturdier ladder for climbs that need a bit more backbone."]
	quest.4DBFAD9F2A98347E.title: "Iron Ladder"
	quest.4DC71B865E7B9DF7.quest_desc: [
		"Odd-shaped and easy to miss on the seafloor."
		"Crack it open and it's usually worth the detour."
	]
	quest.4DC71B865E7B9DF7.title: "Suspicious Rock"
	quest.4DCCFC64EF8476E9.quest_desc: ["Tomato sauce and fresh onions, brought together into a rustic little classic."]
	quest.4DCCFC64EF8476E9.title: "Ratatouille"
	quest.4DDDA6EE8F67D4CA.quest_desc: [
		"Every hit you land heals you back."
		"The ultimate combat artifact - simple as that."
	]
	quest.4DDDA6EE8F67D4CA.title: "Vampiric Glove"
	quest.4DE25801F8F434CF.quest_desc: [
		"Binds devices across different frequencies, tying your"
		"whole wireless setup into one network."
	]
	quest.4DE25801F8F434CF.title: "Redstone Link Wildcard"
	quest.4DEAFAC46D1CA72A.quest_desc: [
		"Not every strange trinket shares the same origin."
		"Some feel newer. Sharper. Like they were waiting to be found by someone in particular."
	]
	quest.4DEAFAC46D1CA72A.title: "Beyond the Ordinary"
	quest.4DEC6040C65C46FE.quest_desc: [
		"Hand it an item and it'll punch, place or craft just like"
		"you would. Automated hands, basically."
	]
	quest.4DEC6040C65C46FE.title: "Deployer"
	quest.4E1DBD611DAFD125.quest_desc: [
		"Not every strange trinket shares the same origin."
		"Some feel newer. Sharper. Like they were waiting to be found by someone in particular."
	]
	quest.4E1DBD611DAFD125.title: "Beyond the Ordinary"
	quest.4E2B00E3C4193C2A.quest_desc: [
		"There's more swimming out there than you'd think."
		"Grab a rod and find out what's biting."
	]
	quest.4E2B00E3C4193C2A.title: "Cast a Line"
	quest.4E56F998BA5EEE11.quest_desc: ["A Wixie brews potions on your behalf, given a cauldron of its own to work."]
	quest.4E56F998BA5EEE11.title: "Befriend a Wixie"
	quest.4E72F43FA11F2203.quest_desc: [
		"Roll a brick out and cut it into bite-sized candy."
		"Dead simple, and it belts up nicely."
	]
	quest.4E72F43FA11F2203.title: "Chocolate Candy"
	quest.4E8DCA87E84C8C7D.quest_desc: [
		"A pendant that seems to know things before you do."
		"Its origin is unmistakably arcane."
	]
	quest.4E8DCA87E84C8C7D.title: "A Flicker of Light"
	quest.4EA9C6B3666B16C1.quest_desc: [
		"Envelope, propeller, and levitite - three disciplines, now one."
		"Craft aviator's goggles and wear the mark of someone who belongs up here."
	]
	quest.4EA9C6B3666B16C1.title: "Aviator's Goggles"
	quest.4EB0E489B0F971FF.quest_desc: [
		"No engine, no problem."
		"Steer a ship at the mercy of the wind, using nothing but your own hands."
	]
	quest.4EB0E489B0F971FF.title: "Unpowered Steering"
	quest.4EDCB6F4F8116A15.quest_desc: ["A crossbow means the raiders never even reach you."]
	quest.4EDCB6F4F8116A15.title: "Ranged Defense"
	quest.4F07657327DA507D.quest_desc: [
		"A red sleeping bag is a statement: you are not going back tonight."
		"Sleep through the dark without moving your respawn."
	]
	quest.4F07657327DA507D.title: "No Bed Required"
	quest.4F0D964C8AE2ACAC.quest_desc: [
		"Just a drawer, a comparator, and some quartz and stone."
		"Links every drawer in range into one searchable network."
	]
	quest.4F0D964C8AE2ACAC.title: "Storage Controller"
	quest.4F200B7A9F913BF5.quest_desc: ["A low brick wall gives the yard a tidy edge."]
	quest.4F200B7A9F913BF5.title: "Brick Wall"
	quest.4F2938E144B437FC.quest_desc: [
		"The Basin catches items and fluids; the Mixer stirs them together."
		"Between the two, half your crafting table becomes obsolete."
	]
	quest.4F2938E144B437FC.title: "Basin \\& Mechanical Mixer"
	quest.4F395D1CB4923201.quest_desc: [
		"Andesite casing tidies up the wiring and toughens it -"
		"the first upgrade tier."
	]
	quest.4F395D1CB4923201.title: "Andesite Encased Connector"
	quest.4F48C5C11DBFFE88.quest_desc: [
		"A Shovel for digging, a Cleaver for mobs -"
		"rounds out the Blazing set nicely."
	]
	quest.4F48C5C11DBFFE88.title: "Blazing Shovel \\& Cleaver"
	quest.4F4E1B4DF7336E90.quest_desc: [
		"Keeps an eye on tube traffic as it moves through the network."
		"About as far as aquatic engineering goes."
	]
	quest.4F4E1B4DF7336E90.title: "Tube Scanner Attachment"
	quest.4F6535F48A6630AB.quest_desc: [
		"A wand and a little stored Source are enough to bind your first spell book."
		"Simple glyphs, simple experiments."
	]
	quest.4F6535F48A6630AB.title: "Novice Spell Book"
	quest.4F79863E5961330C.quest_desc: ["Reinforced with nautilus shell - dive deeper, stay under longer."]
	quest.4F79863E5961330C.title: "Nautilus Helmet"
	quest.4F97A7A1A27E6E45.quest_desc: [
		"Obsidian and a spark. The portal does not stay broken if you walk away - NetherPortalFix keeps the other side honest."
		"Light a nether portal when you are ready to leave the overworld's rules behind."
	]
	quest.4F97A7A1A27E6E45.title: "A Spark for the Nether"
	quest.4F9E8A425C56CBE8.quest_desc: ["The Pickarang's fiery cousin, for when mining turns to fighting."]
	quest.4F9E8A425C56CBE8.title: "Flamarang"
	quest.4FA72D857CED7A08.quest_desc: ["A dressed-up controller for the room you actually want to look at."]
	quest.4FA72D857CED7A08.title: "Framed Drawer Controller"
	quest.4FF9C5E1817EFB35.quest_desc: [
		"No more spinning propellers by hand - it's time for real self-contained power."
		"Build a portable engine and work it up into a finished engine assembly."
	]
	quest.4FF9C5E1817EFB35.title: "Building an Engine"
	quest.502421A14AEC3523.quest_desc: ["A thousand spiders. That's not a fear anymore - that's a hobby."]
	quest.502421A14AEC3523.title: "Spider Bounty: Legend"
	quest.504758D57BEC5992.quest_desc: [
		"Set it beside a spinning shaft and let it grind out bonus"
		"materials while you do something else."
	]
	quest.504758D57BEC5992.title: "Millstone"
	quest.5049F51DD496BE65.quest_desc: [
		"A thousand. At this point they might be more scared of you."
		"Maximum Looting, and a scrap pulled from the Nether's depths."
	]
	quest.5049F51DD496BE65.title: "Enderman Bounty: Legend"
	quest.5057AFB0B3A4C517.quest_desc: [
		"The ground drops away and, for the first time, you're actually flying."
		"Every aviator remembers this moment."
	]
	quest.5057AFB0B3A4C517.title: "Head in the Clouds"
	quest.506BA3CE13289A40.quest_desc: ["Ten down. The horde barely notices, but you will."]
	quest.506BA3CE13289A40.title: "Zombie Bounty: Apprentice"
	quest.506D4ABAB7F0A6B8.quest_desc: [
		"A spell book full of glyphs means nothing until you actually cast one."
		"Break a block, light a fire, push something across the room - it barely matters what. The first cast is the one that makes it real."
	]
	quest.506D4ABAB7F0A6B8.title: "Cast Something"
	quest.50857CD3A81A39F4.quest_desc: ["One screen, your whole network searchable at a glance."]
	quest.50857CD3A81A39F4.title: "Storage Terminal"
	quest.50969B00B17380AC.quest_desc: [
		"Built from a Fluid Hatch and a block of bottled experience."
		"Feeds liquid XP straight into your enchanting setup."
	]
	quest.50969B00B17380AC.title: "Experience Hatch"
	quest.50A8E7EFB761FF18.quest_desc: [
		"A full chestplate demanding fire, ice, and lightning all pay their toll first."
		"You don't wear this until three different dragons have already tried to stop you."
	]
	quest.50A8E7EFB761FF18.title: "Fire Dragonsteel Chestplate"
	quest.50AACF90892DDA02.quest_desc: [
		"Source Gems hum quietly near deposits of Sourcestone, holding the energy every spell will draw from."
		"Gather a handful to begin."
	]
	quest.50AACF90892DDA02.title: "Gems of Source"
	quest.50B0E05480A84644.quest_desc: [
		"A Mechanical Crafter stamps four Blank Parchment at once from fiber and paper."
		"Glyphs still belong on the Scribe's table — this just keeps the paper coming."
	]
	quest.50B0E05480A84644.title: "Parchment Press"
	quest.50B3C67D889F5D80.quest_desc: [
		"Deep beneath the waves lies neptunium."
		"Melt the ore down into something useful."
	]
	quest.50B3C67D889F5D80.title: "Neptunium Ingots"
	quest.50EB6D269421E5CA.quest_desc: ["Nut trees like walnut are worth the wait, come roasting time."]
	quest.50EB6D269421E5CA.title: "Walnut Trees"
	quest.50ECC3A3479ACF14.quest_desc: ["Let a little daylight in with a window and matching pane."]
	quest.50ECC3A3479ACF14.title: "Windows"
	quest.50F21ADF7A6137B7.quest_desc: ["Every sprint gets a little faster with these on."]
	quest.50F21ADF7A6137B7.title: "Running Shoes"
	quest.5105820458683FE0.quest_desc: ["Grind Prosperity Ore into shards, the quiet currency behind Soulium craft."]
	quest.5105820458683FE0.title: "Prosperity Shards"
	quest.511CDF9728B1DDE5.quest_desc: [
		"The ground drops away and, for the first time, you're actually flying."
		"Every aviator remembers this moment."
	]
	quest.511CDF9728B1DDE5.title: "Head in the Clouds"
	quest.511DCA5A5A181046.quest_desc: ["Sucks matching drops off the floor straight into the drawer."]
	quest.511DCA5A5A181046.title: "Magnet Upgrade"
	quest.511F28066B270D33.quest_desc: ["The deepslate version rounds out the whole lamp family nicely."]
	quest.511F28066B270D33.title: "Deepslate Lamp"
	quest.512078D624D47F86.quest_desc: ["A thousand fallen. You've earned the quiet nights."]
	quest.512078D624D47F86.title: "Zombie Bounty: Legend"
	quest.51366B324F19EBAF.quest_desc: ["Soft, magic-soaked stone, gathered wherever Source Gems are found."]
	quest.51366B324F19EBAF.title: "Sourcestone"
	quest.5144E2A2ABED61EF.quest_desc: [
		"Create: Sourceworks lets crushing wheels turn Magebloom into a pile of fiber — far more than a crafting table."
		"Millstone works too if you have not built the wheels yet."
	]
	quest.5144E2A2ABED61EF.title: "Fiber by the Wheel"
	quest.5184A8A75F0CFDD7.quest_desc: ["A dressed-up controller for the room you actually want to look at."]
	quest.5184A8A75F0CFDD7.title: "Framed Drawer Controller"
	quest.518A8938D3D6A9D2.quest_desc: [
		"Timing beats mashing every time."
		"Chain your strikes together and land a combo on something that deserves it."
	]
	quest.518A8938D3D6A9D2.title: "Chain Your Strikes"
	quest.51913F788ACDC108.quest_desc: [
		"Smelt the Zinc, mix it with Copper in the Mixer, and you've"
		"got Brass - the metal the rest of this pack runs on."
	]
	quest.51913F788ACDC108.title: "Zinc and Brass"
	quest.51972B5A015FDD30.quest_desc: ["A friendly signpost pointing visitors toward the notice board, and beyond."]
	quest.51972B5A015FDD30.title: "Way Sign"
	quest.51B2B9951AA1CD47.quest_desc: ["Pressurized and ready to work - the heart of any steam engine."]
	quest.51B2B9951AA1CD47.title: "Locometal Boiler"
	quest.51D5054867037030.quest_desc: ["Fancy a cooler look? Try a batch of Blue Bricks instead."]
	quest.51D5054867037030.title: "Blue Brick Palette"
	quest.52045BEAF292DC61.quest_desc: [
		"Plays a sound of your choosing when the signal comes through."
		"Pair it with the relayer for a doorbell or a dinner call."
	]
	quest.52045BEAF292DC61.title: "Speaker Block"
	quest.52149C62456A973B.quest_desc: [
		"Calcium powder and prismarine crystals, fused together."
		"Everything underwater gets built on this."
	]
	quest.52149C62456A973B.title: "Prismarine Alloy"
	quest.521E84AF0D586E99.quest_desc: ["For the angler who's serious about it. A diamond rod earns its keep."]
	quest.521E84AF0D586E99.title: "Diamond Fishing Rod"
	quest.522EE31EEB4020B2.quest_desc: [
		"Look at everything behind you now - what you fought, what you learned, what you built, how far you wandered."
		"None of it was required. You did it anyway, and that's the whole point."
	]
	quest.522EE31EEB4020B2.title: "A Life Well Built"
	quest.523BDEECDBCA2DA7.quest_desc: [
		"Bolt on Windmill Sails and output climbs with every one you add."
		"Big footprint, bigger payoff."
	]
	quest.523BDEECDBCA2DA7.title: "Windmill Bearing"
	quest.527A7DF80886EFBE.quest_desc: ["The upgrade: a scroll bound for good, always ready for that one trip."]
	quest.527A7DF80886EFBE.title: "Bound Scroll"
	quest.52857CF73E6CFCEF.quest_desc: [
		"Tempered over a Blaze Burner. Hits like Diamond"
		"and never needs repairing."
	]
	quest.52857CF73E6CFCEF.title: "Blazing Pickaxe"
	quest.529BF6761A473418.quest_desc: ["Vents smoke from a coal-fired boiler - simple, reliable, gets the job done."]
	quest.529BF6761A473418.title: "Coalburner Smokestack"
	quest.52A3F9538AA8B927.quest_desc: [
		"Stolen from a nest perched somewhere no sane creature builds a home."
		"Raise it right and it will carry you further than your legs ever could."
	]
	quest.52A3F9538AA8B927.title: "Hippogryph Egg"
	quest.52AC9647155D8411.quest_desc: ["Runes coaxed from the Apparatus unlock glyphs your Novice book could never hold."]
	quest.52AC9647155D8411.title: "Runes of Knowledge"
	quest.52E397D0275C20DE.quest_desc: ["Keeps an eye out for anything living that wanders past."]
	quest.52E397D0275C20DE.title: "Ender Watcher"
	quest.52E55E6F198F2E4F.quest_desc: [
		"Copper's cheap and you've got plenty of it."
		"Start your tool line here."
	]
	quest.52E55E6F198F2E4F.title: "Copper Tools"
	quest.52EF9C02A0B0E747.quest_desc: ["Grind Prosperity Ore into shards, the quiet currency behind Soulium craft."]
	quest.52EF9C02A0B0E747.title: "Prosperity Shards"
	quest.52FE20B1495E9FA7.quest_desc: [
		"Feed it to a hatchling and hope it decides to trust you."
		"Armed and ready - now it's time to find a nest."
	]
	quest.52FE20B1495E9FA7.title: "Taming a Dragon"
	quest.530629BCD8BF62A2.quest_desc: [
		"Calcium powder and prismarine crystals, fused together."
		"Everything underwater gets built on this."
	]
	quest.530629BCD8BF62A2.title: "Prismarine Alloy"
	quest.532021AD9C833B7D.quest_desc: ["A docking connector on your ship, ready to link up with another vessel or a mobile base."]
	quest.532021AD9C833B7D.title: "Docking Systems"
	quest.532DB6B0456B46EF.quest_desc: [
		"Thrust alone won't keep you up forever - you need lift."
		"Sew an envelope and encase a shaft within it: together, the heart of a proper balloon."
	]
	quest.532DB6B0456B46EF.title: "Catching the Wind"
	quest.534229542C569E34.quest_desc: ["A crossbow means the raiders never even reach you."]
	quest.534229542C569E34.title: "Ranged Defense"
	quest.535B04509B903761.quest_desc: [
		"Take a walk. Get a feel for the biome, the neighbours, whatever's watching you back."
		"Keep your eyes open - this world hides more than it shows."
	]
	quest.535B04509B903761.title: "Step Outside"
	quest.536348C86802A13A.quest_desc: [
		"Run your Liquid Experience and reclaimed grindstone XP into this,"
		"and you've got your first hands-off enchanting station."
	]
	quest.536348C86802A13A.title: "Classic Blaze Enchanter"
	quest.536CF9145578E7DA.quest_desc: [
		"Not everything out there is common, and not every common thing behaves itself."
		"Something crossed your path and made you stop and stare."
	]
	quest.536CF9145578E7DA.title: "An Unusual Encounter"
	quest.53724BA48BBD53B7.quest_desc: [
		"Every hit you land heals you back."
		"The ultimate combat artifact - simple as that."
	]
	quest.53724BA48BBD53B7.title: "Vampiric Glove"
	quest.537EAF40C5A11846.quest_desc: [
		"Magic in this world doesn't announce itself. It hums in strange stones, sleeps in ancient relics, and grows quietly in soil that shouldn't be fertile."
		"Three paths in, all leading somewhere real. Pick one, or wander between all three - nothing here locks the others away."
	]
	quest.537EAF40C5A11846.title: "Something Stirs"
	quest.5386716392E0EB32.quest_desc: ["Lay down Inferium Farmland, and your crops grow eager without ever needing a drop of water."]
	quest.5386716392E0EB32.title: "Fertile Ground"
	quest.53AC1BBA4C4FF970.quest_desc: [
		"Binds devices across different frequencies, tying your"
		"whole wireless setup into one network."
	]
	quest.53AC1BBA4C4FF970.title: "Redstone Link Wildcard"
	quest.53AD37842ADD4B0F.quest_desc: [
		"Whip these up soft and fluffy."
		"Good on their own, better once they meet chocolate."
	]
	quest.53AD37842ADD4B0F.title: "Marshmallow"
	quest.53ADC1337AEC60A9.quest_desc: [
		"A boot that seems to forget it's supposed to be heavy."
		"Whoever crafted these understood more than simple enchanting."
	]
	quest.53ADC1337AEC60A9.title: "Light as Air"
	quest.53C528AF8FF6934D.quest_desc: [
		"Barding forged to keep your mount alive when the fight follows you into the air."
		"A flying companion is only as safe as the armor on its back."
	]
	quest.53C528AF8FF6934D.title: "Iron Hippogryph Armor"
	quest.53E8131F51F19DC2.quest_desc: ["Souls refine into Soulium, and Soulium into a blade quick enough to earn its name."]
	quest.53E8131F51F19DC2.title: "Blade of Souls"
	quest.53EE219A942C824A.quest_desc: ["After enough seasons of farming and building, it all starts to come naturally."]
	quest.53EE219A942C824A.title: "A Grower's Instinct"
	quest.53FA6415B504F04D.quest_desc: [
		"There's no shortage of things to grow here."
		"Start easy, with a row of tomatoes."
	]
	quest.53FA6415B504F04D.title: "Plant Tomatoes"
	quest.545F5E16333051E4.quest_desc: [
		"Winches, couplings, plungers - you move around a ship now without ever needing an engine."
		"Traversal mastered."
	]
	quest.545F5E16333051E4.title: "Learning the Ropes"
	quest.54640884928C0597.quest_desc: ["Pressurized and ready to work - the heart of any steam engine."]
	quest.54640884928C0597.title: "Locometal Boiler"
	quest.547A4261F2DEFF33.quest_desc: [
		"Mesh with a regular Cogwheel and you can gear speed up or down."
		"Simple as that."
	]
	quest.547A4261F2DEFF33.title: "Large Cogwheel"
	quest.547C8136F4B10E52.quest_desc: ["Wake your Supremium at the altar, and it becomes something the mod never quite intended."]
	quest.547C8136F4B10E52.title: "Awakened Supremium"
	quest.548B81BAD145ED41.quest_desc: ["The blank slate every backpack upgrade is built from."]
	quest.548B81BAD145ED41.title: "Upgrade Base"
	quest.549D1AADAC11DC6D.quest_desc: [
		"Not everything out there is common, and not every common thing behaves itself."
		"Something crossed your path and made you stop and stare."
	]
	quest.549D1AADAC11DC6D.title: "An Unusual Encounter"
	quest.54B6C896A4AB6CB3.quest_desc: ["Mix it up and see what a simple stew tastes like."]
	quest.54B6C896A4AB6CB3.title: "A Simple Stew"
	quest.54C5135C5FD141A2.quest_desc: ["A sturdier switch for junctions that see real traffic."]
	quest.54C5135C5FD141A2.title: "Brass Track Switch"
	quest.54CF5F55B0927D4A.quest_desc: [
		"Feed it to a hatchling and hope it decides to trust you."
		"Armed and ready - now it's time to find a nest."
	]
	quest.54CF5F55B0927D4A.title: "Taming a Dragon"
	quest.54F24DA1F9F819DE.quest_desc: [
		"A floating nether menace, all fire and fury."
		"Watch for the flames."
	]
	quest.54F24DA1F9F819DE.title: "Rare Encounter: Wildfire"
	quest.54F8DDF02EDF1BBE.quest_desc: [
		"A thousand. At this point they might be more scared of you."
		"Maximum Looting, and a scrap pulled from the Nether's depths."
	]
	quest.54F8DDF02EDF1BBE.title: "Enderman Bounty: Legend"
	quest.54FAF7179CB6C08D.quest_desc: [
		"Near a crafting table, in a hole in the ground - that's where every story here begins."
		"The horizon has been waiting this whole time."
	]
	quest.54FAF7179CB6C08D.title: "First Steps Beyond"
	quest.552D74D28931FB4B.quest_desc: [
		"Fifty down. Caves are a little less rattly now."
		"A Protection charm, for the arrows you didn't dodge."
	]
	quest.552D74D28931FB4B.title: "Skeleton Bounty: Veteran"
	quest.552ED7E38EBD0BE4.quest_desc: [
		"Dresses drawers up with trim and matching materials."
		"For when function needs to look good too."
	]
	quest.552ED7E38EBD0BE4.title: "Framing Table"
	quest.553E4E0155632EAC.quest_desc: [
		"A wand and a little stored Source are enough to bind your first spell book."
		"Simple glyphs, simple experiments."
	]
	quest.553E4E0155632EAC.title: "Novice Spell Book"
	quest.5575FAB071EC9863.quest_desc: [
		"A wood-matched chest for whichever room it lands in."
		"Start the collection with a simple Oak Chest."
	]
	quest.5575FAB071EC9863.title: "Variant Chest"
	quest.557F9858A8829502.quest_desc: [
		"Finishes off the frame with a sleeker profile."
		"Run it through the Train Assembly tool and your first true locomotive is ready to roll."
	]
	quest.557F9858A8829502.title: "Streamlined Smokestack"
	quest.55988D2B2481BCD6.quest_desc: [
		"Every tier cleared, every dragon down, every rare threat accounted for."
		"The board is finally, completely clear."
	]
	quest.55988D2B2481BCD6.title: "Master Bounty Hunter"
	quest.55AE3E41063580FF.quest_desc: ["Mix it up and see what a simple stew tastes like."]
	quest.55AE3E41063580FF.title: "A Simple Stew"
	quest.55BEFDF6CDB52AA7.quest_desc: ["A sturdier switch for junctions that see real traffic."]
	quest.55BEFDF6CDB52AA7.title: "Brass Track Switch"
	quest.55E4776A67525AA7.quest_desc: ["Sucks matching drops off the floor straight into the drawer."]
	quest.55E4776A67525AA7.title: "Magnet Upgrade"
	quest.56393B170458C645.quest_desc: ["The upgrade: a scroll bound for good, always ready for that one trip."]
	quest.56393B170458C645.title: "Bound Scroll"
	quest.563E1FD7EEF3337E.quest_desc: ["A little zinc fencing keeps things secure, and still looks the part."]
	quest.563E1FD7EEF3337E.title: "Bars and Mesh Fences"
	quest.56841BF3229EA9A4.quest_desc: ["Imperium Essence glows brighter than anything before it - and the climb still isn't over."]
	quest.56841BF3229EA9A4.title: "Imperium Tier"
	quest.56AB89FBA0DAC52B.quest_desc: [
		"Small and Large Connectors join your wire runs together,"
		"routing power wherever it needs to go."
	]
	quest.56AB89FBA0DAC52B.title: "Connectors"
	quest.56B43CCA6AF6FB6A.quest_desc: ["The deepslate version rounds out the whole lamp family nicely."]
	quest.56B43CCA6AF6FB6A.title: "Deepslate Lamp"
	quest.56EA5EDE63DE220C.quest_desc: ["Finish the bedroom off with a bed that's a cut above plain."]
	quest.56EA5EDE63DE220C.title: "A Proper Bed"
	quest.5753C57E31ED01C7.quest_desc: [
		"Dresses drawers up with trim and matching materials."
		"For when function needs to look good too."
	]
	quest.5753C57E31ED01C7.title: "Framing Table"
	quest.57597F9C6B73D0B4.quest_desc: [
		"Crack the ore, or grow it from seed - either way, essence pools in your hands."
		"Nearly everything ahead starts with this."
	]
	quest.57597F9C6B73D0B4.title: "Inferium Essence"
	quest.575AFA0B492A434B.quest_desc: [
		"Not every piece of furniture is just for looks."
		"The Alchemy Bench gives your study a little personality of its own."
	]
	quest.575AFA0B492A434B.title: "Alchemy Bench"
	quest.57689DF2D5C5E82D.quest_desc: [
		"Take a walk. Get a feel for the biome, the neighbours, whatever's watching you back."
		"Keep your eyes open - this world hides more than it shows."
	]
	quest.57689DF2D5C5E82D.title: "Step Outside"
	quest.576E81FF3128B35B.quest_desc: [
		"Make a big batch and keep it close."
		"A bucket of stew never goes to waste."
	]
	quest.576E81FF3128B35B.title: "Stew by the Bucket"
	quest.5790BB10A6288B31.quest_desc: ["Oak track, plain and sturdy - every railway starts with a length of this underfoot."]
	quest.5790BB10A6288B31.title: "Lay Some Track"
	quest.57A226F9B46AEBA0.quest_desc: [
		"Deletes the overflow once a drawer's full."
		"A lifesaver on cobblestone generators and anything else that never stops producing."
	]
	quest.57A226F9B46AEBA0.title: "Void Upgrade"
	quest.57B4CF71C273F652.quest_desc: ["Let a machine take over the slicing, so your hands are free for everything else."]
	quest.57B4CF71C273F652.title: "The Mechanical Cutter"
	quest.57DA2A501A632782.quest_desc: [
		"Hits a bit harder than Copper and lasts a bit longer too."
		"Small upgrade, worth making."
	]
	quest.57DA2A501A632782.title: "Zinc Tools"
	quest.57E3D4DF68F83AEF.quest_desc: [
		"Still crackling faintly, taken from something that ruled the storm."
		"The spark that Lightning Dragonsteel needs to exist - and storms don't give up their hearts quietly."
	]
	quest.57E3D4DF68F83AEF.title: "Heart of a Lightning Dragon"
	quest.57EDE1D9DD37E711.quest_desc: ["A couch is the start of any cozy living room."]
	quest.57EDE1D9DD37E711.title: "Living Room Couch"
	quest.57FF6EC03BE98A1D.quest_desc: [
		"Point it anywhere and feel the pull toward whatever biome you're chasing."
		"No more blind wandering, hoping the terrain agrees with you."
	]
	quest.57FF6EC03BE98A1D.title: "Nature's Compass"
	quest.580A74ED3295D2B1.quest_desc: [
		"The rumours are true. Somewhere out past the frontier, something with wings is old enough to remember when the land looked different."
		"This isn't early-game country. Come with diamond gear or better, and something that's already survived worse than a skeleton."
	]
	quest.580A74ED3295D2B1.title: "Ready for Dragon Country"
	quest.5824777691666837.quest_desc: ["A thousand. There may not be a quieter cave system left."]
	quest.5824777691666837.title: "Skeleton Bounty: Legend"
	quest.5841DFB305CB5DEA.quest_desc: [
		"Deep beneath the waves lies neptunium."
		"Melt the ore down into something useful."
	]
	quest.5841DFB305CB5DEA.title: "Neptunium Ingots"
	quest.58446BDC58A45125.quest_desc: [
		"Feed it to a hatchling and hope it decides to trust you."
		"Armed and ready - now it's time to find a nest."
	]
	quest.58446BDC58A45125.title: "Taming a Dragon"
	quest.5859C8C4B3E8CE0A.quest_desc: ["Top-tier capacity, for when you're storing by the thousands."]
	quest.5859C8C4B3E8CE0A.title: "Diamond Upgrade"
	quest.5871E9001648001F.quest_desc: ["A hundred down. You don't flinch at cobwebs anymore."]
	quest.5871E9001648001F.title: "Spider Bounty: Expert"
	quest.589DAA82716AC11F.quest_desc: [
		"Bringing a moving ship to rest against something solid takes more than good piloting."
		"Craft a pair of docking connectors and link two points together."
	]
	quest.589DAA82716AC11F.title: "Docking Systems"
	quest.58B356CB322AC35A.quest_desc: ["Your builds are starting to feel a lot safer."]
	quest.58B356CB322AC35A.title: "Creeper Bounty: Veteran"
	quest.58B90D5A778A311A.quest_desc: [
		"You're about to collect a lot of stuff."
		"Craft a chest before your pockets give out."
	]
	quest.58B90D5A778A311A.title: "Somewhere to Put Things"
	quest.58D68D2959CFF42F.quest_desc: ["Gold fishes faster still, for an angler who's always got somewhere else to be."]
	quest.58D68D2959CFF42F.title: "Golden Fishing Rod"
	quest.58DAE3E0061D1F22.quest_desc: ["Mystical Agradditions dares one tier further. Crux and awakened essence combine into the true capstone: Insanium."]
	quest.58DAE3E0061D1F22.title: "Insanium: Beyond Awakened"
	quest.58FC3C988B8AC4A3.quest_desc: [
		"Raise one at every junction."
		"Keeps two trains from ever meeting somewhere they shouldn't."
	]
	quest.58FC3C988B8AC4A3.title: "Raise a Semaphore"
	quest.59169CB56CC1EB51.quest_desc: ["Grind meat down for all the recipes that call for it."]
	quest.59169CB56CC1EB51.title: "The Grinder"
	quest.5936ADE43C2D940D.quest_desc: [
		"Flick it out to mine a block and it comes right back to you."
		"Handy for that one ore you can never quite reach."
	]
	quest.5936ADE43C2D940D.title: "Pickarang"
	quest.593E85FC16E5EDDD.quest_desc: [
		"Gold and Silver alloyed into Electrum wire - carries"
		"current more efficiently than Copper ever could."
	]
	quest.593E85FC16E5EDDD.title: "Electrum Wiring"
	quest.59554071A1B8760A.quest_desc: [
		"Cargo won't sort and route itself - well, almost."
		"Craft a logistics terminal and automate the flow of goods through your station."
	]
	quest.59554071A1B8760A.title: "Logistics Network"
	quest.5958688FFBAFE7DE.quest_desc: [
		"None of this locks you in - just gives you a feel for what's out there."
		"Chase whichever one pulled at you the most."
	]
	quest.5958688FFBAFE7DE.title: "Somewhere to Start"
	quest.59942BED9BACC30D.quest_desc: ["Ring your pedestal with the Enchanting Apparatus, and glyphs, runes and enchanted gear all become possible."]
	quest.59942BED9BACC30D.title: "Enchanting Apparatus"
	quest.59A80EF2A6A9458C.quest_desc: [
		"A hopper and some redstone, bolted onto any drawer."
		"Pulls matching items in from adjacent inventories automatically."
	]
	quest.59A80EF2A6A9458C.title: "Puller Upgrade"
	quest.59CEA19250191CC0.quest_desc: ["A Spell Turret casts on its own - magic quietly learning to automate itself."]
	quest.59CEA19250191CC0.title: "Automated Casting"
	quest.59D78ECB7A77FC10.quest_desc: [
		"The ocean keeps its best secrets where the light gives up."
		"Bring something back worth telling people about."
	]
	quest.59D78ECB7A77FC10.title: "Beneath the Waves"
	quest.59DAE02DBBD77B0F.quest_desc: [
		"Not everyone in the sky is friendly - raiders have been known to board unprepared ships."
		"Survive the encounter and pull a set of captain's orders from the wreckage."
	]
	quest.59DAE02DBBD77B0F.title: "Under the Black Flag"
	quest.59EB98401E54F279.quest_desc: [
		"A ship this valuable needs protecting - from raiders, from griefers, from anyone who isn't you."
		"Place a claim block aboard and bring it under your protection, wherever it flies."
	]
	quest.59EB98401E54F279.title: "Claim the Skies"
	quest.59F0363CA1E7D3B5.quest_desc: ["One blast and the platform knows it's time to go."]
	quest.59F0363CA1E7D3B5.title: "Conductor's Whistle"
	quest.5A19643B5FA8C54C.quest_desc: ["Reinforced with nautilus shell - dive deeper, stay under longer."]
	quest.5A19643B5FA8C54C.title: "Nautilus Helmet"
	quest.5A1E1DC89A938B7B.quest_desc: [
		"Everything so far has stayed bolted to the ground."
		"Assemble a Contraption - a piston, a train, anything that carries its machinery with it when it moves - and Create stops being a factory and starts being an engine."
	]
	quest.5A1E1DC89A938B7B.title: "Something That Moves"
	quest.5A35A88F41A5670E.quest_desc: [
		"Chests in ruins are not a race. Each player gets their own loot from the same box."
		"Open a structure chest and take what is yours - nobody else loses theirs."
	]
	quest.5A35A88F41A5670E.title: "Loot That Stays Yours"
	quest.5A7E5E224C8398DB.quest_desc: [
		"Press K to open the skills screen, or type /skills."
		"No grinding required - just live, and they'll rise with you."
	]
	quest.5A7E5E224C8398DB.title: "Check Your Skills"
	quest.5ABCAD337E9CF4E7.quest_desc: [
		"No more spinning propellers by hand - it's time for real self-contained power."
		"Build a portable engine and work it up into a finished engine assembly."
	]
	quest.5ABCAD337E9CF4E7.title: "Building an Engine"
	quest.5B09A28EBCF2DEDE.quest_desc: [
		"A thousand Creepers. Nobody's builds have been safer."
		"Maximum Blast Protection, and something dug up from deep in the Nether."
	]
	quest.5B09A28EBCF2DEDE.title: "Creeper Bounty: Legend"
	quest.5B43FAD3F04770A1.quest_desc: ["Pressurized and ready to work - the heart of any steam engine."]
	quest.5B43FAD3F04770A1.title: "Locometal Boiler"
	quest.5B717C13C2981BBF.quest_desc: [
		"Auto-compacts stored items into their block form."
		"Cobblestone and sand stop eating up so much room."
	]
	quest.5B717C13C2981BBF.title: "Compacting Drawers"
	quest.5B7A8773537B8496.quest_desc: [
		"Six familiars now, each pulling its own weight."
		"Not bad for a wizard who started out talking to a glowing rock."
	]
	quest.5B7A8773537B8496.title: "A Full Menagerie"
	quest.5B95EABCF3BA6EAD.quest_desc: [
		"Look at everything behind you now - what you fought, what you learned, what you built, how far you wandered."
		"None of it was required. You did it anyway, and that's the whole point."
	]
	quest.5B95EABCF3BA6EAD.title: "A Life Well Built"
	quest.5BA4A607167B8EE2.quest_desc: ["A darker take on the lamp, right at home in a nether-themed room."]
	quest.5BA4A607167B8EE2.title: "Blackstone Lamp"
	quest.5BDFA49D8438ED0B.quest_desc: [
		"Every explorer starts leaving their own trail of shortcuts and landmarks eventually."
		"You may already have a Waystone or two out there without calling it anything special."
	]
	quest.5BDFA49D8438ED0B.title: "Marks on the Map"
	quest.5BEEE487A426886C.quest_desc: [
		"Combos, rolls, trinkets, a skill set that's actually yours now."
		"You're not stumbling into fights anymore - you're choosing them."
	]
	quest.5BEEE487A426886C.title: "Found Your Footing"
	quest.5BF4027226B61A6F.quest_desc: [
		"Frost-forged, and every bit as dangerous as its fiery cousin."
		"Cold to the touch, unforgiving in a fight."
	]
	quest.5BF4027226B61A6F.title: "Ice Dragonsteel Ingot"
	quest.5C1101E7624E6B18.quest_desc: ["Splits the tube so your network can branch wherever you need it to go."]
	quest.5C1101E7624E6B18.title: "Hypertube Splitter"
	quest.5C1606E87FB8C479.quest_desc: ["Light the Brazier, perform the Warping ritual, and watch space bend politely around your base."]
	quest.5C1606E87FB8C479.title: "Rituals and Braziers"
	quest.5C749AFF2F97E5C1.quest_desc: [
		"Two habits will save you hours out here."
		"Press U over an item for its recipe in JEI, and let Jade tell you what you're looking at."
	]
	quest.5C749AFF2F97E5C1.title: "Learn Your Tools"
	quest.5CA812E6CD379340.quest_desc: ["One swing clears a 3x3 patch, so tunnels go a lot faster."]
	quest.5CA812E6CD379340.title: "Hammer"
	quest.5CA8483DDF118F05.quest_desc: [
		"Andesite plating over the frame."
		"More protection, more utility, same idea."
	]
	quest.5CA8483DDF118F05.title: "Andesite Exoskeleton"
	quest.5CC71E909D4AE9EB.quest_desc: [
		"A plain lamp that only glows when you flick a switch for it."
		"Perfect for a hidden light you control from elsewhere."
	]
	quest.5CC71E909D4AE9EB.title: "Stone Lamp"
	quest.5CCB3D8958E6944C.quest_desc: [
		"Every airship starts with one spinning blade."
		"Craft a wooden propeller - crude, but it's real thrust in your hands."
	]
	quest.5CCB3D8958E6944C.title: "Wooden Wings"
	quest.5CD545BE0643DD08.quest_desc: [
		"A full stomach keeps you sprinting, jumping, healing - all of it."
		"Cook something simple and eat."
	]
	quest.5CD545BE0643DD08.title: "Fill Your Belly"
	quest.5CE500EB47A1FB10.quest_desc: [
		"A boot that seems to forget it's supposed to be heavy."
		"Whoever crafted these understood more than simple enchanting."
	]
	quest.5CE500EB47A1FB10.title: "Light as Air"
	quest.5CF8CEF019BA0DD6.quest_desc: [
		"Still smoldering when you pull it free of the dragon that carried it."
		"Your own dragon won't give this up - you'll need to bring down a wild one."
		"Everything a Fire Dragonsteel weapon needs to exist."
	]
	quest.5CF8CEF019BA0DD6.title: "Heart of a Fire Dragon"
	quest.5D11E4B19C83565C.quest_desc: [
		"Timing beats mashing every time."
		"Chain your strikes together and land a combo on something that deserves it."
	]
	quest.5D11E4B19C83565C.title: "Chain Your Strikes"
	quest.5D4274F05198544B.quest_desc: [
		"A propeller in your hand is just a toy."
		"Mount it on a bearing and give a contraption something to drive."
	]
	quest.5D4274F05198544B.title: "Mounted for Flight"
	quest.5D50860C4CDC1E24.quest_desc: [
		"Feed it to a hatchling and hope it decides to trust you."
		"Armed and ready - now it's time to find a nest."
	]
	quest.5D50860C4CDC1E24.title: "Taming a Dragon"
	quest.5D53764FBE4B525E.quest_desc: [
		"One slot, one item, no fuss."
		"Your first step into Functional Storage."
	]
	quest.5D53764FBE4B525E.title: "Oak Drawer (1x1)"
	quest.5D6139368D9034C5.quest_desc: ["An oven and hood turn a corner of the house into a real kitchen."]
	quest.5D6139368D9034C5.title: "Kitchen Appliances"
	quest.5D6B7C6542C4A588.quest_desc: [
		"A good fillet knife turns a catch into supper."
		"The wooden one's cheap, but it'll do."
	]
	quest.5D6B7C6542C4A588.title: "Wooden Fillet Knife"
	quest.5D7C1BE60AE34FBF.quest_desc: [
		"Armor pieced together from scales that once belonged to something enormous."
		"Light on your back, heavy in what it says about you."
	]
	quest.5D7C1BE60AE34FBF.title: "Dragon Scale Chestplate"
	quest.5D88DF4D45363C95.quest_desc: [
		"Turns power ninety degrees, no fuss."
		"Handy the moment your build stops being a straight line."
	]
	quest.5D88DF4D45363C95.title: "Gearbox"
	quest.5D8A0A4B94BDE0D5.quest_desc: ["Let a little daylight in with a window and matching pane."]
	quest.5D8A0A4B94BDE0D5.title: "Windows"
	quest.5D977E3CA90DD79C.quest_desc: [
		"Winches, couplings, plungers - you move around a ship now without ever needing an engine."
		"Traversal mastered."
	]
	quest.5D977E3CA90DD79C.title: "Learning the Ropes"
	quest.5DA5F25E83D2F99C.quest_desc: [
		"Wood only gets you so far before you hit something harder."
		"Mine a little cobblestone and upgrade."
	]
	quest.5DA5F25E83D2F99C.title: "Onto Stone"
	quest.5DD49D25578D1963.quest_desc: [
		"Onions turn up in more recipes than you'd expect."
		"Get a patch growing."
	]
	quest.5DD49D25578D1963.title: "Plant Onions"
	quest.5DD8413AAA5F47DD.quest_desc: ["Prudentium tools bite far deeper than Inferium ever could."]
	quest.5DD8413AAA5F47DD.title: "Prudentium Gear"
	quest.5DFB64BF577C8572.quest_desc: [
		"Conjures decoys and vanishes mid-fight."
		"Trust nothing you see."
	]
	quest.5DFB64BF577C8572.title: "Rare Encounter: Illusioner"
	quest.5E01E0B77FA3EC5D.quest_desc: [
		"Melt a brick down into a proper drink."
		"A fitting reward for a fully automated cocoa line."
	]
	quest.5E01E0B77FA3EC5D.title: "Hot Chocolate"
	quest.5E20B11CFB5210E1.quest_desc: [
		"Timing beats mashing every time."
		"Chain your strikes together and land a combo on something that deserves it."
	]
	quest.5E20B11CFB5210E1.title: "Chain Your Strikes"
	quest.5E2BCBF4D81A6378.quest_desc: [
		"Holds a mountain of one item in a single block."
		"Where every drawer room starts."
	]
	quest.5E2BCBF4D81A6378.title: "Your First Drawer"
	quest.5E684AAA7CE4285C.quest_desc: ["Shell plating for extra protection out on aquatic jobs."]
	quest.5E684AAA7CE4285C.title: "Turtle Chestplate"
	quest.5E69524FA7CDBF29.quest_desc: ["A softer take on glass, framed in wood and dyed to match any room."]
	quest.5E69524FA7CDBF29.title: "Framed Glass"
	quest.5E71E68AFBA84709.quest_desc: ["Lay down Inferium Farmland, and your crops grow eager without ever needing a drop of water."]
	quest.5E71E68AFBA84709.title: "Fertile Ground"
	quest.5E75229C27FFB011.quest_desc: [
		"Bolt on Windmill Sails and output climbs with every one you add."
		"Big footprint, bigger payoff."
	]
	quest.5E75229C27FFB011.title: "Windmill Bearing"
	quest.5ECD944E3CC659EE.quest_desc: ["Serves no purpose at all, and somehow that's exactly the charm."]
	quest.5ECD944E3CC659EE.title: "Tiny Potato"
	quest.5EDF699CE4A14C96.quest_desc: [
		"Look at everything behind you now - what you fought, what you learned, what you built, how far you wandered."
		"None of it was required. You did it anyway, and that's the whole point."
	]
	quest.5EDF699CE4A14C96.title: "A Life Well Built"
	quest.5F067CADD6038829.quest_desc: ["One screen, your whole network searchable at a glance."]
	quest.5F067CADD6038829.title: "Storage Terminal"
	quest.5F0F7A1FC1CD0831.quest_desc: [
		"Relics reveal themselves through use, not explanation."
		"Keep it on you. Try it in places you wouldn't expect."
	]
	quest.5F0F7A1FC1CD0831.title: "Experiment"
	quest.5F1A315CB66A90DF.quest_desc: [
		"Ferment it further and you've got Bioethanol -"
		"clean fuel for your generators."
	]
	quest.5F1A315CB66A90DF.title: "Bioethanol"
	quest.5F2D4D7B7B24F212.quest_desc: [
		"All three chocolates, blended and moulded into bricks."
		"This is the building block everything downstream uses."
	]
	quest.5F2D4D7B7B24F212.title: "Chocolate Bricks"
	quest.5F453171C1A22957.quest_desc: [
		"A pale ore veined through the deep rock, waiting to be melted down."
		"The first ingredient in gear built for things that don't die easy."
	]
	quest.5F453171C1A22957.title: "Silver Ore"
	quest.5F58712C06EBF3B1.quest_desc: [
		"Refined Radiance and Shadow Steel, fused into a component your"
		"logic and display setups will lean on."
	]
	quest.5F58712C06EBF3B1.title: "Electron Tube"
	quest.5F6EB87A536A6917.quest_desc: ["Mix it up and see what a simple stew tastes like."]
	quest.5F6EB87A536A6917.title: "A Simple Stew"
	quest.5F6EBA0594F77F47.quest_desc: ["Gathers up loose seeds as you tend the fields, so you don't have to."]
	quest.5F6EBA0594F77F47.title: "Seed Pouch"
	quest.5F708B248144AD27.quest_desc: [
		"A heart, a forge, and heat most things wouldn't survive."
		"What comes out the other side is close to unbreakable."
	]
	quest.5F708B248144AD27.title: "Fire Dragonsteel Ingot"
	quest.5F83DA30A4D081E5.quest_desc: [
		"Feed it Blaze Cake and it superheats whatever's sitting above it."
		"Unlocks the hotter alloying recipes, Brass included."
	]
	quest.5F83DA30A4D081E5.title: "Blaze Burner"
	quest.5F8E80E00DBEE727.quest_desc: [
		"Not everything out there is common, and not every common thing behaves itself."
		"Something crossed your path and made you stop and stare."
	]
	quest.5F8E80E00DBEE727.title: "An Unusual Encounter"
	quest.5FF808D6EDF37FB3.quest_desc: ["It moves like a storm and hits like one too."]
	quest.5FF808D6EDF37FB3.title: "Slay a Lightning Dragon"
	quest.602AC6F2B1C71A53.quest_desc: [
		"Deep underground, a mineral seems to weigh less than it should."
		"Mine some levitite and find out why."
	]
	quest.602AC6F2B1C71A53.title: "A Strange Floating Mineral"
	quest.603018C44635C7A8.quest_desc: [
		"Holds a mountain of one item in a single block."
		"Where every drawer room starts."
	]
	quest.603018C44635C7A8.title: "Your First Drawer"
	quest.605862B6C76848EF.quest_desc: [
		"Something a dragon exhales, bottled before it dissolves into the wind."
		"The first strange step toward automating what a dragon leaves behind."
	]
	quest.605862B6C76848EF.title: "Bottling Dragon's Breath"
	quest.606C3E5968F3BE66.quest_desc: [
		"A thousand spiders. That's not a fear anymore - that's a hobby."
		"Maximum Bane of Arthropods, and a piece of the Nether's finest."
	]
	quest.606C3E5968F3BE66.title: "Spider Bounty: Legend"
	quest.606CCD465A961123.quest_desc: ["A lockable spot to tuck away whatever you treasure most."]
	quest.606CCD465A961123.title: "Safe"
	quest.6083BE06EC45C93B.quest_desc: [
		"Not everything in the garden is for eating."
		"Cotton grows well alongside the rest."
	]
	quest.6083BE06EC45C93B.title: "Harvest Cotton"
	quest.60910D3529390629.quest_desc: [
		"Some of what you've found doesn't just feel powerful."
		"It feels arcane. Deliberate. Like it was made, not found. Somewhere, there may be an explanation."
	]
	quest.60910D3529390629.title: "Something Stranger Still"
	quest.609154335B985DAC.quest_desc: [
		"Mix it down to a fine powder - the base for anything"
		"dark and bitter."
	]
	quest.609154335B985DAC.title: "Cocoa Powder"
	quest.60B38830C89D5705.quest_desc: ["A tabletop holder for a candle of any color you fancy."]
	quest.60B38830C89D5705.title: "Candle Holder"
	quest.60B62059C25D1C55.quest_desc: [
		"Load the frame with books and it works exactly like a"
		"vanilla bookshelf - stack them around your enchanter."
	]
	quest.60B62059C25D1C55.title: "Brass Bookshelf"
	quest.60BF31643EDBC254.quest_desc: [
		"Big, armored, and built to hit hard."
		"Bring backup."
	]
	quest.60BF31643EDBC254.title: "Rare Encounter: Mauler"
	quest.60EB0E7792B4F816.quest_desc: [
		"Timing beats mashing every time."
		"Chain your strikes together and land a combo on something that deserves it."
	]
	quest.60EB0E7792B4F816.title: "Chain Your Strikes"
	quest.6110CB36EDAE7C18.quest_desc: [
		"Ferment it further and you've got Bioethanol -"
		"clean fuel for your generators."
	]
	quest.6110CB36EDAE7C18.title: "Bioethanol"
	quest.611B29D381E4F72D.quest_desc: ["Access the network from anywhere - no need to stand at a block."]
	quest.611B29D381E4F72D.title: "Wireless Terminal"
	quest.611D7C5AFA53DF36.quest_desc: [
		"Flattens metal into sheets, or set it over a Basin for"
		"compacting recipes. One tool, two jobs."
	]
	quest.611D7C5AFA53DF36.title: "Mechanical Press"
	quest.613F6F4CA0EC815C.quest_desc: [
		"Draw Copper Rods into wire. Every electrical connection"
		"in this network starts with a spool of this."
	]
	quest.613F6F4CA0EC815C.title: "Copper Wiring"
	quest.614EFE06FA97EADD.quest_desc: ["Small enchanted rings that shave cost and risk off every cast."]
	quest.614EFE06FA97EADD.title: "Rings of Convenience"
	quest.6150655A6839B0E7.quest_desc: ["Scrape it up off the seabed - it's the starting point for every prismarine alloy you'll cast."]
	quest.6150655A6839B0E7.title: "Calcium Rich Powder"
	quest.6152DF766753A9EA.quest_desc: [
		"There's more swimming out there than you'd think."
		"Grab a rod and find out what's biting."
	]
	quest.6152DF766753A9EA.title: "Cast a Line"
	quest.6180581712BBD4D9.quest_desc: [
		"Compacts stored items into blocks automatically."
		"The capstone drawer for a maxed-out storage room."
	]
	quest.6180581712BBD4D9.title: "Compacting Drawer"
	quest.61880B6388027CB7.quest_desc: [
		"Something a dragon exhales, bottled before it dissolves into the wind."
		"The first strange step toward automating what a dragon leaves behind."
	]
	quest.61880B6388027CB7.title: "Bottling Dragon's Breath"
	quest.6189DAE976C1330D.quest_desc: ["Only one tier of gear now stands between you and Supremium."]
	quest.6189DAE976C1330D.title: "Imperium Gear"
	quest.619BF49C20A7AA2D.quest_desc: ["One screen, your whole network searchable at a glance."]
	quest.619BF49C20A7AA2D.title: "Storage Terminal"
	quest.61AE1390A18F31B7.quest_desc: [
		"Source Gems hum quietly near deposits of Sourcestone, holding the energy every spell will draw from."
		"Gather a handful to begin."
	]
	quest.61AE1390A18F31B7.title: "Gems of Source"
	quest.61B74EC0E33E4BC1.quest_desc: ["Sweeps nearby drops straight into the backpack as you walk."]
	quest.61B74EC0E33E4BC1.title: "Pickup Upgrade"
	quest.61BF8913331DFB0A.quest_desc: [
		"A propeller in your hand is just a toy."
		"Mount it on a bearing and give a contraption something to drive."
	]
	quest.61BF8913331DFB0A.title: "Mounted for Flight"
	quest.61DE0CA82D5178F4.quest_desc: ["Finish the bedroom off with a bed that's a cut above plain."]
	quest.61DE0CA82D5178F4.title: "A Proper Bed"
	quest.61E5CE895169E1D4.quest_desc: ["Every room deserves a proper door, and a trapdoor besides."]
	quest.61E5CE895169E1D4.title: "Doors and Trapdoors"
	quest.61F57EECFFACDB2E.quest_desc: ["Every sprint gets a little faster with these on."]
	quest.61F57EECFFACDB2E.title: "Running Shoes"
	quest.620B8C643D7D4D68.quest_desc: [
		"Links storage across dimensions, even from inside a backpack."
		"The capstone piece of the whole line."
	]
	quest.620B8C643D7D4D68.title: "Ender Linker"
	quest.6223DC561343C49C.quest_desc: ["A Blank Scroll is where every travel scroll starts."]
	quest.6223DC561343C49C.title: "Blank Scroll"
	quest.62269CB2ABC42B87.quest_desc: [
		"Sometimes the fastest way on or off your ship isn't a ladder."
		"Rig up a rope winch, a connector, and a coupling."
	]
	quest.62269CB2ABC42B87.title: "Rope Winch and Rigging"
	quest.622E1E215F9C0FEE.quest_desc: ["A low brick wall gives the yard a tidy edge."]
	quest.622E1E215F9C0FEE.title: "Brick Wall"
	quest.6239D0F2E3CF3180.quest_desc: [
		"Settling in, engineering, magic, the skies, and worse things than skeletons - it's all through this book, organised so you always know where you left off."
		"Your skills grow on their own as you play. Nothing here demands grinding - just curiosity, and a willingness to open the next chapter."
	]
	quest.6239D0F2E3CF3180.title: "The Road Ahead"
	quest.62410D409017D032.quest_desc: ["A trophy on the wall, a story from your travels."]
	quest.62410D409017D032.title: "Hunter's Trophy"
	quest.6260EB469046BB36.quest_desc: [
		"The oddest dessert in the whole harvest."
		"Bake one to round it all off."
	]
	quest.6260EB469046BB36.title: "Slime Pie"
	quest.627A7CB9B223EB96.quest_desc: ["Ten fewer webs to walk into."]
	quest.627A7CB9B223EB96.title: "Spider Bounty: Apprentice"
	quest.628ECDC70F279B94.quest_desc: [
		"Tempered over a Blaze Burner. Hits like Diamond"
		"and never needs repairing."
	]
	quest.628ECDC70F279B94.title: "Blazing Pickaxe"
	quest.62981A90AF6353DF.quest_desc: ["Passes a signal along to a linked block, with or without wires."]
	quest.62981A90AF6353DF.title: "Relayer"
	quest.62A72C63D7438743.quest_desc: [
		"A wheel to turn is only half the job."
		"Wire in a throttle lever and command your speed too."
	]
	quest.62A72C63D7438743.title: "Throttle Control"
	quest.62B77C97F1B820C7.quest_desc: ["Beyond Supremium lies something Awakened - reachable only through a second, stranger altar."]
	quest.62B77C97F1B820C7.title: "The Awakening Altar"
	quest.62E478AC0A816B32.quest_desc: [
		"Every good defense starts with a shield."
		"Craft one before the raiders come knocking."
	]
	quest.62E478AC0A816B32.title: "Arm Yourself"
	quest.62E780C603CB49AE.quest_desc: [
		"Every stage of propulsion, conquered."
		"This is what true thrust mastery feels like."
	]
	quest.62E780C603CB49AE.title: "In Thrust We Trust"
	quest.631800074EFF387E.quest_desc: ["Brew up something warming for a quiet evening."]
	quest.631800074EFF387E.title: "Chai Tea"
	quest.63189C11D13009B5.quest_desc: [
		"A blank journal, waiting to fill up with everything you become out here."
		"Just a book and a stick. It'll matter more than you think."
	]
	quest.63189C11D13009B5.title: "Your Journal of Progress"
	quest.631F4C37BC0E55A5.quest_desc: ["Four slots - the drawer you'll end up placing the most."]
	quest.631F4C37BC0E55A5.title: "Oak Drawer (2x2)"
	quest.633018D2B4F77CF4.quest_desc: [
		"Near a crafting table, in a hole in the ground - that's where every story here begins."
		"The horizon has been waiting this whole time."
	]
	quest.633018D2B4F77CF4.title: "First Steps Beyond"
	quest.6335176E1889771A.quest_desc: [
		"Deep, blue, and worth every torch it took to find."
		"Diamond tools are the last stop before the world gets truly strange."
	]
	quest.6335176E1889771A.title: "Striking Diamond"
	quest.63572A536F910E1D.quest_desc: [
		"A simple wooden propeller doesn't look like much."
		"But it's the same part that ends up carrying entire flying bases."
	]
	quest.63572A536F910E1D.title: "A Taste of the Skies"
	quest.6361B852D1762A70.quest_desc: ["Matching slabs and stairs round the set out nicely."]
	quest.6361B852D1762A70.title: "Brick Shapes"
	quest.636407B017B8AA37.quest_desc: [
		"Longer range, more capable."
		"The last terminal you'll need."
	]
	quest.636407B017B8AA37.title: "Advanced Wireless Terminal"
	quest.6380158AD35173FE.quest_desc: ["Top-tier capacity, for when you're storing by the thousands."]
	quest.6380158AD35173FE.title: "Diamond Upgrade"
	quest.6382E97CC7043DB5.quest_desc: ["Pair that chair with a proper table for meals and gatherings."]
	quest.6382E97CC7043DB5.title: "Dining Table"
	quest.638D981463D0E055.quest_desc: [
		"Brass casing for the runs that matter."
		"You'll need this tier before the fancier components unlock."
	]
	quest.638D981463D0E055.title: "Brass Encased Connector"
	quest.63A0FD50FCDAE637.quest_desc: ["After enough seasons of farming and building, it all starts to come naturally."]
	quest.63A0FD50FCDAE637.title: "A Grower's Instinct"
	quest.63C61E4268C67D11.quest_desc: ["Turn fruit from the orchard into something worth drinking."]
	quest.63C61E4268C67D11.title: "The Juicer"
	quest.63D455DD22E5C004.quest_desc: [
		"Spreads dirt, sand, and gravel without the back-and-forth."
		"A small thing, but you'll reach for it constantly."
	]
	quest.63D455DD22E5C004.title: "Trowel"
	quest.63E0B6BCDDFCDF3F.quest_desc: [
		"The seasons turn here, and they shape what grows."
		"A calendar helps you keep up."
	]
	quest.63E0B6BCDDFCDF3F.title: "Track the Seasons"
	quest.64127F7CCD1D2080.quest_desc: ["Pair that chair with a proper table for meals and gatherings."]
	quest.64127F7CCD1D2080.title: "Dining Table"
	quest.64374797ADD814E6.quest_desc: [
		"Strange veins hum beneath the stone, waiting to be broken open."
		"Essence farming begins right here."
	]
	quest.64374797ADD814E6.title: "A Curious Ore"
	quest.643CD1EB6728A7F3.quest_desc: ["Magebloom woven into robes light enough that spellcasting never feels encumbered."]
	quest.643CD1EB6728A7F3.title: "Arcanist's Robes"
	quest.644276A1A29E1208.quest_desc: ["Ars Creo turns spellcraft into rotation. Let your Starbuncle spin power straight into your Create network."]
	quest.644276A1A29E1208.title: "The Starbuncle Wheel"
	quest.64452E89C5F99B13.quest_desc: ["Gathers up loose seeds as you tend the fields, so you don't have to."]
	quest.64452E89C5F99B13.title: "Seed Pouch"
	quest.6445384957508B62.quest_desc: ["Fry, sear, and get creative with what the stove can do."]
	quest.6445384957508B62.title: "The Skillet"
	quest.645624109319AA40.quest_desc: ["Scrape it up off the seabed - it's the starting point for every prismarine alloy you'll cast."]
	quest.645624109319AA40.title: "Calcium Rich Powder"
	quest.646FBC935002D2C4.quest_desc: ["A thousand. There may not be a quieter cave system left."]
	quest.646FBC935002D2C4.title: "Skeleton Bounty: Legend"
	quest.649FEB0CC80219F5.quest_desc: [
		"Finishes off the frame with a sleeker profile."
		"Run it through the Train Assembly tool and your first true locomotive is ready to roll."
	]
	quest.649FEB0CC80219F5.title: "Streamlined Smokestack"
	quest.64A7B8C4CA552D7A.quest_desc: ["Ten fewer things that go boom near your builds."]
	quest.64A7B8C4CA552D7A.title: "Creeper Bounty: Apprentice"
	quest.64CF4A6E77905B44.quest_desc: ["The biggest, toughest pack in the line."]
	quest.64CF4A6E77905B44.title: "Netherite Backpack"
	quest.64E937613AE177E8.quest_desc: [
		"Onions turn up in more recipes than you'd expect."
		"Get a patch growing."
	]
	quest.64E937613AE177E8.title: "Plant Onions"
	quest.64E93C5FA22CFC3D.quest_desc: ["Arm a villager and give your village its first line of defense."]
	quest.64E93C5FA22CFC3D.title: "Hire a Guard"
	quest.64FAB4189A1175BB.quest_desc: [
		"A book that only matters once its pages are full of things you actually lived through."
		"Yours has real weight to it now."
	]
	quest.64FAB4189A1175BB.title: "The Grimoire's Weight"
	quest.64FB92FE901D81E8.quest_desc: ["Thick, meaty, and just the thing after a long day's work."]
	quest.64FB92FE901D81E8.title: "Hearty Beef Stew"
	quest.651A949104BD882D.quest_desc: [
		"Rarer, stranger, and said to trade in things pulled straight from the rock."
		"Find and trade with a Vein Goblin Trader."
	]
	quest.651A949104BD882D.title: "The Vein Goblin"
	quest.65288EC665766BDE.quest_desc: [
		"Deep underground, a mineral seems to weigh less than it should."
		"Mine some levitite and find out why."
	]
	quest.65288EC665766BDE.title: "A Strange Floating Mineral"
	quest.652EFCDFB7264C24.quest_desc: [
		"Andesite alloy plating around a rotating shaft."
		"A simple frame for grinding down enchanted gear."
	]
	quest.652EFCDFB7264C24.title: "Mechanical Grindstone"
	quest.6533470813FD8216.quest_desc: [
		"A ship this valuable needs protecting - from raiders, from griefers, from anyone who isn't you."
		"Place a claim block aboard and bring it under your protection, wherever it flies."
	]
	quest.6533470813FD8216.title: "Claim the Skies"
	quest.6549F3EC857B1BF9.quest_desc: ["A docking connector on your ship, ready to link up with another vessel or a mobile base."]
	quest.6549F3EC857B1BF9.title: "Docking Systems"
	quest.6552BDD8D9F8D4FB.quest_desc: ["A cupboard and drawer keep the clutter out of sight."]
	quest.6552BDD8D9F8D4FB.title: "Storage Furniture"
	quest.65738479CD8321A8.quest_desc: ["Pair that chair with a proper table for meals and gatherings."]
	quest.65738479CD8321A8.title: "Dining Table"
	quest.65783E94CCFC7647.quest_desc: ["Pair that chair with a proper table for meals and gatherings."]
	quest.65783E94CCFC7647.title: "Dining Table"
	quest.6593FD33E55569A4.quest_desc: [
		"A full stomach keeps you sprinting, jumping, healing - all of it."
		"Cook something simple and eat."
	]
	quest.6593FD33E55569A4.title: "Fill Your Belly"
	quest.65A4E21076889314.quest_desc: ["Walls and a roof make shelter. A little care makes it home."]
	quest.65A4E21076889314.title: "Make It Feel Like Home"
	quest.65AF5423CDF664F6.quest_desc: [
		"Finishes off the frame with a sleeker profile."
		"Run it through the Train Assembly tool and your first true locomotive is ready to roll."
	]
	quest.65AF5423CDF664F6.title: "Streamlined Smokestack"
	quest.65C6A1940B1726C1.quest_desc: ["Access the network from anywhere - no need to stand at a block."]
	quest.65C6A1940B1726C1.title: "Wireless Terminal"
	quest.65EA37C9720190B6.quest_desc: [
		"Something a dragon exhales, bottled before it dissolves into the wind."
		"The first strange step toward automating what a dragon leaves behind."
	]
	quest.65EA37C9720190B6.title: "Bottling Dragon's Breath"
	quest.65F5A7420B578B34.quest_desc: ["A Stabilized Warp Scroll offers a steadier way to cross the space you've just learned to bend."]
	quest.65F5A7420B578B34.title: "Stabilized Travel"
	quest.660B38D1EBDEDB16.quest_desc: [
		"One panel, the whole network."
		"Monitor and control everything from a single dashboard."
	]
	quest.660B38D1EBDEDB16.title: "Dashboard"
	quest.6623C519BC6ED086.quest_desc: [
		"Deep underground, a mineral seems to weigh less than it should."
		"Mine some levitite and find out why."
	]
	quest.6623C519BC6ED086.title: "A Strange Floating Mineral"
	quest.665FC81BA6C5DED6.quest_desc: ["Oak track, plain and sturdy - every railway starts with a length of this underfoot."]
	quest.665FC81BA6C5DED6.title: "Lay Some Track"
	quest.6682A3504D19EC51.quest_desc: [
		"A simple wooden propeller doesn't look like much."
		"But it's the same part that ends up carrying entire flying bases."
	]
	quest.6682A3504D19EC51.title: "A Taste of the Skies"
	quest.668A96BCFE31BB27.quest_desc: [
		"Holds a mountain of one item in a single block."
		"Where every drawer room starts."
	]
	quest.668A96BCFE31BB27.title: "Your First Drawer"
	quest.669E9F333EB29A2E.quest_desc: ["Attune a Shard and your Portstone network gets faster, tighter, more reliable."]
	quest.669E9F333EB29A2E.title: "Attuned Shard"
	quest.66B2493C70E7CE1C.quest_desc: ["Two slots for a matched pair of items."]
	quest.66B2493C70E7CE1C.title: "Oak Drawer (1x2)"
	quest.66D42F58D980C5A4.quest_desc: ["Light the brazier with this one, and gravity stops being quite so insistent."]
	quest.66D42F58D980C5A4.title: "The Flight Ritual"
	quest.66D83AE32CEFB30B.quest_desc: ["Ten down. The horde barely notices, but you will."]
	quest.66D83AE32CEFB30B.title: "Zombie Bounty: Apprentice"
	quest.66E49BC1B4227F55.quest_desc: ["Serves no purpose at all, and somehow that's exactly the charm."]
	quest.66E49BC1B4227F55.title: "Tiny Potato"
	quest.6718D3BE4E700E09.quest_desc: [
		"Armor pieced together from scales that once belonged to something enormous."
		"Light on your back, heavy in what it says about you."
	]
	quest.6718D3BE4E700E09.title: "Dragon Scale Chestplate"
	quest.67192D62CCD27A91.quest_desc: ["A handful of walnuts, roasted into a good little snack."]
	quest.67192D62CCD27A91.title: "Roasted Walnuts"
	quest.672FEF776CCB473F.quest_desc: ["A cupboard and drawer keep the clutter out of sight."]
	quest.672FEF776CCB473F.title: "Storage Furniture"
	quest.67479BCD3B9A548C.quest_desc: [
		"Combos, rolls, trinkets, a skill set that's actually yours now."
		"You're not stumbling into fights anymore - you're choosing them."
	]
	quest.67479BCD3B9A548C.title: "Found Your Footing"
	quest.6747C9E5EBCD9E72.quest_desc: [
		"An illager who traded a crossbow for ice magic."
		"Rare, and rarely friendly."
	]
	quest.6747C9E5EBCD9E72.title: "Rare Encounter: Iceologer"
	quest.675E3BB81D4C0A67.quest_desc: [
		"Hand it an item and it'll punch, place or craft just like"
		"you would. Automated hands, basically."
	]
	quest.675E3BB81D4C0A67.title: "Deployer"
	quest.67746DF6C9705EF2.quest_desc: ["The upgrade: a scroll bound for good, always ready for that one trip."]
	quest.67746DF6C9705EF2.title: "Bound Scroll"
	quest.677874BE573F6DA6.quest_desc: [
		"Combos, rolls, trinkets, a skill set that's actually yours now."
		"You're not stumbling into fights anymore - you're choosing them."
	]
	quest.677874BE573F6DA6.title: "Found Your Footing"
	quest.67997E219F409444.quest_desc: ["Scrape it up off the seabed - it's the starting point for every prismarine alloy you'll cast."]
	quest.67997E219F409444.title: "Calcium Rich Powder"
	quest.679CC24B354A44FD.quest_desc: ["Let a little daylight in with a window and matching pane."]
	quest.679CC24B354A44FD.title: "Windows"
	quest.679E5760CEF38372.quest_desc: [
		"Envelope, propeller, and levitite - three disciplines, now one."
		"Craft aviator's goggles and wear the mark of someone who belongs up here."
	]
	quest.679E5760CEF38372.title: "Aviator's Goggles"
	quest.67A4787033A15D54.quest_desc: ["Every home needs somewhere to sit down."]
	quest.67A4787033A15D54.title: "Take a Seat"
	quest.67B85D5A294314F7.quest_desc: [
		"The last guardian of the End, and one of the oldest fights in the game."
		"Bring it down."
	]
	quest.67B85D5A294314F7.title: "Slay the Ender Dragon"
	quest.67C22609A084220E.quest_desc: [
		"Barding forged to keep your mount alive when the fight follows you into the air."
		"A flying companion is only as safe as the armor on its back."
	]
	quest.67C22609A084220E.title: "Iron Hippogryph Armor"
	quest.67E9C46A2B83C7F0.quest_desc: [
		"Raw levitite is too unstable to use as-is."
		"Blend it down into the base ingredient for a whole class of anti-gravity gear."
	]
	quest.67E9C46A2B83C7F0.title: "Refining Levitite"
	quest.67ED7663DA749316.quest_desc: [
		"Odd-shaped and easy to miss on the seafloor."
		"Crack it open and it's usually worth the detour."
	]
	quest.67ED7663DA749316.title: "Suspicious Rock"
	quest.67F674E39683022D.quest_desc: [
		"Holds a mountain of one item in a single block."
		"Where every drawer room starts."
	]
	quest.67F674E39683022D.title: "Your First Drawer"
	quest.67F70E5464984D5E.quest_desc: [
		"Mix it down to a fine powder - the base for anything"
		"dark and bitter."
	]
	quest.67F70E5464984D5E.title: "Cocoa Powder"
	quest.6805FAF1A974B0C8.quest_desc: [
		"Whip these up soft and fluffy."
		"Good on their own, better once they meet chocolate."
	]
	quest.6805FAF1A974B0C8.title: "Marshmallow"
	quest.681853B99E40140F.quest_desc: [
		"A thousand spiders. That's not a fear anymore - that's a hobby."
		"Maximum Bane of Arthropods, and a piece of the Nether's finest."
	]
	quest.681853B99E40140F.title: "Spider Bounty: Legend"
	quest.6818E01DDAE48DC7.quest_desc: ["One screen, your whole network searchable at a glance."]
	quest.6818E01DDAE48DC7.title: "Storage Terminal"
	quest.68413649E02EC69E.quest_desc: ["Access the network from anywhere - no need to stand at a block."]
	quest.68413649E02EC69E.title: "Wireless Terminal"
	quest.685445DF9AB4C812.quest_desc: ["Slabs, stairs, and a wall finish the blue set off."]
	quest.685445DF9AB4C812.title: "Blue Brick Set"
	quest.685C0334F0E5B9FB.quest_desc: ["Power source sorted, gear on - lay the first stretch and get moving at speed underwater."]
	quest.685C0334F0E5B9FB.title: "Lay Hypertube"
	quest.6886C544254EDBC0.quest_desc: [
		"Cold even in your hand, taken from a dragon that never once blinked."
		"The Ice Dragonsteel line begins here."
	]
	quest.6886C544254EDBC0.title: "Heart of an Ice Dragon"
	quest.688D71B3E12D759C.quest_desc: [
		"Look up. Soaring Traders and Pillager Aviators already ride the clouds on contraptions of their own."
		"Spot one and prove the sky is busier than you thought."
	]
	quest.688D71B3E12D759C.title: "Sky Travelers"
	quest.68912F186DE0DCE8.quest_desc: [
		"A wood-matched chest for whichever room it lands in."
		"Start the collection with a simple Oak Chest."
	]
	quest.68912F186DE0DCE8.title: "Variant Chest"
	quest.689DFAB9B955B919.quest_desc: ["Mystical Agradditions dares one tier further. Crux and awakened essence combine into the true capstone: Insanium."]
	quest.689DFAB9B955B919.title: "Insanium: Beyond Awakened"
	quest.68A6DE5E8DCCB059.quest_desc: [
		"Still crackling faintly, taken from something that ruled the storm."
		"The spark that Lightning Dragonsteel needs to exist - and storms don't give up their hearts quietly."
	]
	quest.68A6DE5E8DCCB059.title: "Heart of a Lightning Dragon"
	quest.68B11411B1EF6EEE.quest_desc: [
		"An illager who traded a crossbow for ice magic."
		"Rare, and rarely friendly."
	]
	quest.68B11411B1EF6EEE.title: "Rare Encounter: Iceologer"
	quest.68B8D1DA5075641A.quest_desc: [
		"Flick it out to mine a block and it comes right back to you."
		"Handy for that one ore you can never quite reach."
	]
	quest.68B8D1DA5075641A.title: "Pickarang"
	quest.68D373F96EE3600D.quest_desc: ["Perches on a lectern and reads spells back to itself, refining them as it goes."]
	quest.68D373F96EE3600D.title: "Befriend a Bookwyrm"
	quest.68D5D0D0A9A4F024.quest_desc: [
		"Every hit you land heals you back."
		"The ultimate combat artifact - simple as that."
	]
	quest.68D5D0D0A9A4F024.title: "Vampiric Glove"
	quest.68E6A92EDFCCB7AE.quest_desc: [
		"Set it beside a spinning shaft and let it grind out bonus"
		"materials while you do something else."
	]
	quest.68E6A92EDFCCB7AE.title: "Millstone"
	quest.68F9656C71ED89EA.quest_desc: [
		"The ground drops away and, for the first time, you're actually flying."
		"Every aviator remembers this moment."
	]
	quest.68F9656C71ED89EA.title: "Head in the Clouds"
	quest.69288ED24911D087.quest_desc: [
		"Magic in this world doesn't announce itself. It hums in strange stones, sleeps in ancient relics, and grows quietly in soil that shouldn't be fertile."
		"Three paths in, all leading somewhere real. Pick one, or wander between all three - nothing here locks the others away."
	]
	quest.69288ED24911D087.title: "Something Stirs"
	quest.693750E70721574F.quest_desc: ["Souls refine into Soulium, and Soulium into a blade quick enough to earn its name."]
	quest.693750E70721574F.title: "Blade of Souls"
	quest.6988086510077B31.quest_desc: ["Every home needs somewhere to sit down."]
	quest.6988086510077B31.title: "Take a Seat"
	quest.69B3AB5241319DCA.quest_desc: [
		"Press instead of mix and you get cocoa butter,"
		"the fatty base behind the paler chocolates."
	]
	quest.69B3AB5241319DCA.title: "Cocoa Butter"
	quest.69C5D0A93B91CF84.quest_desc: [
		"Don't stare too long."
		"Take one down."
	]
	quest.69C5D0A93B91CF84.title: "Enderman Bounty: Novice"
	quest.69DAC109E32D0446.quest_desc: ["Nut trees like walnut are worth the wait, come roasting time."]
	quest.69DAC109E32D0446.title: "Walnut Trees"
	quest.69F5D78B95B9F739.quest_desc: [
		"Whip these up soft and fluffy."
		"Good on their own, better once they meet chocolate."
	]
	quest.69F5D78B95B9F739.title: "Marshmallow"
	quest.6A0333E3403DE642.quest_desc: [
		"A matched pair sends rotational power wirelessly."
		"Run machinery clear across your base without laying a single shaft."
	]
	quest.6A0333E3403DE642.title: "Kinetic Bridge"
	quest.6A03C0AFDD3F697C.quest_desc: ["Soft, magic-soaked stone, gathered wherever Source Gems are found."]
	quest.6A03C0AFDD3F697C.title: "Sourcestone"
	quest.6A0B9AF777CAACA8.quest_desc: [
		"Not every strange trinket shares the same origin."
		"Some feel newer. Sharper. Like they were waiting to be found by someone in particular. Keep hunting until one of those finds you."
	]
	quest.6A0B9AF777CAACA8.title: "Beyond the Ordinary"
	quest.6A1F9BD64F636D9E.quest_desc: ["Scrape it up off the seabed - it's the starting point for every prismarine alloy you'll cast."]
	quest.6A1F9BD64F636D9E.title: "Calcium Rich Powder"
	quest.6A22C50B8B802F75.quest_desc: ["River and kitchen finally meet, in a classic worth the wait."]
	quest.6A22C50B8B802F75.title: "Fish and Chips"
	quest.6A28C180B49059C6.quest_desc: ["Reinforced with nautilus shell - dive deeper, stay under longer."]
	quest.6A28C180B49059C6.title: "Nautilus Helmet"
	quest.6A6D0A0038FC7DD9.quest_desc: [
		"Bolt one onto a Grindstone and reclaim the XP you'd"
		"otherwise waste disenchanting gear."
	]
	quest.6A6D0A0038FC7DD9.title: "Grindstone Drain"
	quest.6ABE430BBDBEE324.quest_desc: ["A crossbow means the raiders never even reach you."]
	quest.6ABE430BBDBEE324.title: "Ranged Defense"
	quest.6ABF6BE19348006C.quest_desc: ["A couch is the start of any cozy living room."]
	quest.6ABF6BE19348006C.title: "Living Room Couch"
	quest.6AC02867B50F7842.quest_desc: ["Simmer your tomatoes down into something worth saving."]
	quest.6AC02867B50F7842.title: "Tomato Sauce"
	quest.6AC388A105FEEEE9.quest_desc: [
		"A thousand. There may not be a quieter cave system left."
		"Maximum Protection, and a shard of pure netherite."
	]
	quest.6AC388A105FEEEE9.title: "Skeleton Bounty: Legend"
	quest.6AE1B8D949E2FF36.quest_desc: [
		"Still crackling faintly, taken from something that ruled the storm."
		"The spark that Lightning Dragonsteel needs to exist."
	]
	quest.6AE1B8D949E2FF36.title: "Heart of a Lightning Dragon"
	quest.6AEE5A257D9F9127.quest_desc: [
		"Deep, blue, and worth every torch it took to find."
		"Diamond tools are the last stop before the world gets truly strange."
	]
	quest.6AEE5A257D9F9127.title: "Striking Diamond"
	quest.6AF3F0C72A1D9503.quest_desc: [
		"Same heat treatment as the pickaxe, aimed at"
		"your tree farm instead."
	]
	quest.6AF3F0C72A1D9503.title: "Blazing Axe"
	quest.6B0238AB41342154.quest_desc: ["Let a little daylight in with a window and matching pane."]
	quest.6B0238AB41342154.title: "Windows"
	quest.6B21243A888B949C.quest_desc: [
		"Keeps an eye on tube traffic as it moves through the network."
		"About as far as aquatic engineering goes."
	]
	quest.6B21243A888B949C.title: "Tube Scanner Attachment"
	quest.6B3B997A589177BE.quest_desc: [
		"All three chocolates, blended and moulded into bricks."
		"This is the building block everything downstream uses."
	]
	quest.6B3B997A589177BE.title: "Chocolate Bricks"
	quest.6B4B69432896C0D0.quest_desc: [
		"Navigation, docking, logistics, claims, altitude, a name of its own."
		"You don't just fly anymore - you command a travelling base worth admiring."
	]
	quest.6B4B69432896C0D0.title: "Master of the Skies"
	quest.6B5D691A6D855E87.quest_desc: [
		"Track's down, signals are up, the locomotive's built."
		"Couple it all together and send your first train out."
	]
	quest.6B5D691A6D855E87.title: "Build Your First Train Line"
	quest.6B86439EEECF497F.quest_desc: ["One swing clears a 3x3 patch, so tunnels go a lot faster."]
	quest.6B86439EEECF497F.title: "Hammer"
	quest.6B939604A6C83F4A.quest_desc: [
		"Not experience earned through practice - power poured directly in."
		"This is not the same kind of growth Skill Progression tracks. This is augmentation."
	]
	quest.6B939604A6C83F4A.title: "A Spark of Knowledge"
	quest.6BA748461F134231.quest_desc: ["Multiplies what a drawer can hold - the first step up from base capacity."]
	quest.6BA748461F134231.title: "Storage Upgrade (I)"
	quest.6BD6B0ABB2F52F38.quest_desc: [
		"Track's down, signals are up, the locomotive's built."
		"Couple it all together and send your first train out."
	]
	quest.6BD6B0ABB2F52F38.title: "Build Your First Train Line"
	quest.6BE8AC14D59204DA.quest_desc: [
		"Whip these up soft and fluffy."
		"Good on their own, better once they meet chocolate."
	]
	quest.6BE8AC14D59204DA.title: "Marshmallow"
	quest.6C3186891CF3A421.quest_desc: ["Brass catwalks and railings keep you steady above it all."]
	quest.6C3186891CF3A421.title: "Catwalks and Railings"
	quest.6C45E799EFF01C3A.quest_desc: ["A friendly signpost pointing visitors toward the notice board, and beyond."]
	quest.6C45E799EFF01C3A.title: "Way Sign"
	quest.6C5716B50BCA1EEA.quest_desc: [
		"Odd-shaped and easy to miss on the seafloor."
		"Crack it open and it's usually worth the detour."
	]
	quest.6C5716B50BCA1EEA.title: "Suspicious Rock"
	quest.6C587DCFC92AA62E.quest_desc: [
		"Blend the powder down and you've got dark chocolate -"
		"bitter, intense, and the backbone of half this chapter."
	]
	quest.6C587DCFC92AA62E.title: "Dark Chocolate"
	quest.6C81079713F644F0.quest_desc: ["Every room deserves a proper door, and a trapdoor besides."]
	quest.6C81079713F644F0.title: "Doors and Trapdoors"
	quest.6C97C85C8F61DBCE.quest_desc: ["A little stand to show off your favorite hat by the door."]
	quest.6C97C85C8F61DBCE.title: "Hat Stand"
	quest.6CB8AA78130992CC.quest_desc: [
		"Smelted, forged, and sharpened against things that fear silver more than steel."
		"The undead in particular will not enjoy this."
	]
	quest.6CB8AA78130992CC.title: "Silver Sword"
	quest.6CC81DE84D73F279.quest_desc: [
		"Still crackling faintly, taken from something that ruled the storm."
		"The spark that Lightning Dragonsteel needs to exist."
	]
	quest.6CC81DE84D73F279.title: "Heart of a Lightning Dragon"
	quest.6CD45EBAF6EA00D8.quest_desc: ["Walls and a roof make shelter. A little care makes it home."]
	quest.6CD45EBAF6EA00D8.title: "Make It Feel Like Home"
	quest.6CE51007D77DEABF.quest_desc: ["Cast from riveted locometal - frames out the body of a locomotive."]
	quest.6CE51007D77DEABF.title: "Locometal Pillar"
	quest.6CEA9640930AFB6B.quest_desc: ["Ten teleports too slow."]
	quest.6CEA9640930AFB6B.title: "Enderman Bounty: Apprentice"
	quest.6D1EA0CAACD86FD8.quest_desc: [
		"A garden's better with a bit of red in it."
		"Get some tomato seeds in the ground."
	]
	quest.6D1EA0CAACD86FD8.title: "Growing Tomatoes"
	quest.6D1FFDAF49A5BEE1.quest_desc: [
		"A hearty root crop worth keeping in the pantry."
		"Plant a few and let them settle in."
	]
	quest.6D1FFDAF49A5BEE1.title: "Plant Sweet Potatoes"
	quest.6D242282842D6395.quest_desc: ["Links cars together - bolt one on and start pulling carriages."]
	quest.6D242282842D6395.title: "Knuckle Coupler"
	quest.6D3C768D03793983.quest_desc: ["Lay down Inferium Farmland, and your crops grow eager without ever needing a drop of water."]
	quest.6D3C768D03793983.title: "Fertile Ground"
	quest.6D4FD974828265D4.quest_desc: [
		"Every journey starts with a chopped log and a rough set of tools."
		"Nothing fancy - just enough to get moving."
	]
	quest.6D4FD974828265D4.title: "First Tools"
	quest.6D749E86822807B7.quest_desc: [
		"Raw levitite is too unstable to use as-is."
		"Blend it down into the base ingredient for a whole class of anti-gravity gear."
	]
	quest.6D749E86822807B7.title: "Refining Levitite"
	quest.6D807285B6C4E8DE.quest_desc: [
		"Flying in a straight line is easy - turning is another matter."
		"Craft a steering wheel and take real control."
	]
	quest.6D807285B6C4E8DE.title: "Steering Wheel"
	quest.6D97FFCED352AF8B.quest_desc: [
		"Nine Super Experience Nuggets, compacted down."
		"A dense, storable stockpile of XP for whenever the grindstone runs dry."
	]
	quest.6D97FFCED352AF8B.title: "Block of Super Experience"
	quest.6DABF2612DED2455.quest_desc: [
		"Crack the ore, or grow it from seed - either way, essence pools in your hands."
		"Nearly everything ahead starts with this."
	]
	quest.6DABF2612DED2455.title: "Inferium Essence"
	quest.6DAF57C7D82A7002.quest_desc: ["Bind a Warp Scroll to a Waystone for one quick trip from anywhere."]
	quest.6DAF57C7D82A7002.title: "Warp Scroll"
	quest.6DC83B6BCA074DA5.quest_desc: [
		"A hearty root crop worth keeping in the pantry."
		"Plant a few and let them settle in."
	]
	quest.6DC83B6BCA074DA5.title: "Plant Sweet Potatoes"
	quest.6DCCC1357536D67A.quest_desc: [
		"One slot, one item, no fuss."
		"Your first step into Functional Storage."
	]
	quest.6DCCC1357536D67A.title: "Oak Drawer (1x1)"
	quest.6DD8C1B85557E9ED.quest_desc: ["Brass catwalks and railings keep you steady above it all."]
	quest.6DD8C1B85557E9ED.title: "Catwalks and Railings"
	quest.6DEADE9A7A5BC4A1.quest_desc: ["Stops a train dead at the end of the line, no drama."]
	quest.6DEADE9A7A5BC4A1.title: "Track Buffer"
	quest.6E0F272B8B4753BE.quest_desc: ["A dressed-up controller for the room you actually want to look at."]
	quest.6E0F272B8B4753BE.title: "Framed Drawer Controller"
	quest.6E23E6CE7EAB1FE8.quest_desc: [
		"Not every crop here is ordinary."
		"Gather slime jelly for something a little stranger."
	]
	quest.6E23E6CE7EAB1FE8.title: "Slime Jelly"
	quest.6E40C9C5B0A9797E.quest_desc: [
		"N opens this book. M opens the map. G opens Curios. C opens the Ars spellbook. R is combat roll. Shift+E opens your backpack."
		"Need a key you cannot find? Options, Controls, then use the search bar. Grave accent opens the mod config list."
	]
	quest.6E40C9C5B0A9797E.title: "The Buttons That Matter"
	quest.6E448EC62E7DAA26.quest_desc: [
		"Not every crop here is ordinary."
		"Gather slime jelly for something a little stranger."
	]
	quest.6E448EC62E7DAA26.title: "Slime Jelly"
	quest.6E4A3044356A2AC0.quest_desc: [
		"There's more swimming out there than you'd think."
		"Grab a rod and find out what's biting."
	]
	quest.6E4A3044356A2AC0.title: "Cast a Line"
	quest.6E620AA9163FA362.quest_desc: [
		"Track's down, signals are up, the locomotive's built."
		"Couple it all together and send your first train out."
	]
	quest.6E620AA9163FA362.title: "Build Your First Train Line"
	quest.6E7875F605DFFB22.quest_desc: [
		"Roll a brick out and cut it into bite-sized candy."
		"Dead simple, and it belts up nicely."
	]
	quest.6E7875F605DFFB22.title: "Chocolate Candy"
	quest.6E976AD957AD6CBE.quest_desc: ["Round out the table with a warm loaf of garlic bread."]
	quest.6E976AD957AD6CBE.title: "Garlic Bread Feast"
	quest.6EA3A15B80899F6F.quest_desc: [
		"A bed back home is fine until night catches you three biomes away."
		"Craft a sleeping bag so you can skip the night without resetting spawn."
	]
	quest.6EA3A15B80899F6F.title: "Sleep on the Road"
	quest.6EBEB7C84682A860.quest_desc: ["Keep the altar turning. Tertium marks the essence tree's midpoint."]
	quest.6EBEB7C84682A860.title: "Tertium Tier"
	quest.6EC84C20996E49BD.quest_desc: ["Mix it up and see what a simple stew tastes like."]
	quest.6EC84C20996E49BD.title: "A Simple Stew"
	quest.6EDDAA7570D08593.quest_desc: [
		"Relics reveal themselves through use, not explanation."
		"Keep it on you. Try it in places you wouldn't expect."
	]
	quest.6EDDAA7570D08593.title: "Experiment"
	quest.6EE06DA4688E0F15.quest_desc: ["The blank slate every backpack upgrade is built from."]
	quest.6EE06DA4688E0F15.title: "Upgrade Base"
	quest.6EE2CC921D785039.quest_desc: [
		"The last guardian of the End, and one of the oldest fights in the game."
		"Bring it down."
	]
	quest.6EE2CC921D785039.title: "Slay the Ender Dragon"
	quest.6EE5E3E9E33AB17B.quest_desc: [
		"Winches, couplings, plungers - you move around a ship now without ever needing an engine."
		"Traversal mastered."
	]
	quest.6EE5E3E9E33AB17B.title: "Learning the Ropes"
	quest.6F2D43A1FFAF5C30.quest_desc: [
		"Press instead of mix and you get cocoa butter,"
		"the fatty base behind the paler chocolates."
	]
	quest.6F2D43A1FFAF5C30.title: "Cocoa Butter"
	quest.6F45891AC3EC9D95.quest_desc: [
		"A drawer, a piston, some iron and stone."
		"Automatically compacts its contents into their block form."
	]
	quest.6F45891AC3EC9D95.title: "Compacting Drawer"
	quest.6F67D79A8130AF98.quest_desc: ["Roomier still."]
	quest.6F67D79A8130AF98.title: "Gold Backpack"
	quest.6F7514BC53D80D59.quest_desc: ["Only one tier of gear now stands between you and Supremium."]
	quest.6F7514BC53D80D59.title: "Imperium Gear"
	quest.6F7BBE145D7EEDAC.quest_desc: [
		"Straight-line power transfer, nothing fancy about it."
		"Every contraption you build will have a few of these running through it."
	]
	quest.6F7BBE145D7EEDAC.title: "Shaft"
	quest.6F826CEF8EA240FC.quest_desc: [
		"Still smoldering when you pull it free of the dragon that carried it."
		"Your own dragon won't give this up - you'll need to bring down a wild one."
		"Everything a Fire Dragonsteel weapon needs to exist."
	]
	quest.6F826CEF8EA240FC.title: "Heart of a Fire Dragon"
	quest.6FC04C32B6F18019.quest_desc: [
		"Do not meet its eyes if you can help it."
		"A cockatrice is proof that the rumours in Dragon Country start smaller than dragons."
	]
	quest.6FC04C32B6F18019.title: "Rare Encounter: Cockatrice"
	quest.6FC64CC8980E666B.quest_desc: ["Matching slabs and stairs round the set out nicely."]
	quest.6FC64CC8980E666B.title: "Brick Shapes"
	quest.6FD6C9F69A0C0A34.quest_desc: ["Bumps up the stack size on everything stored inside."]
	quest.6FD6C9F69A0C0A34.title: "Stack Upgrade Tier 1"
	quest.6FDE92FEADD5D340.quest_desc: ["A little zinc fencing keeps things secure, and still looks the part."]
	quest.6FDE92FEADD5D340.title: "Bars and Mesh Fences"
	quest.700E0CA08B81F3D6.quest_desc: ["Keeps the fire fed - no fuel, no steam."]
	quest.700E0CA08B81F3D6.title: "Fuel Tank"
	quest.701EB95AAF747A32.quest_desc: [
		"Bind an amethyst shard, a writable book, and spruce wood together."
		"What results is no ordinary book - it's a record of arcane augmentation, waiting to be filled."
	]
	quest.701EB95AAF747A32.title: "The Skills Grimoire"
	quest.705F291C4259D3EF.quest_desc: [
		"Armor pieced together from scales that once belonged to something enormous."
		"Light on your back, heavy in what it says about you."
	]
	quest.705F291C4259D3EF.title: "Dragon Scale Chestplate"
	quest.7064619976CDF7C7.quest_desc: [
		"A strange wand hums with weightless energy in your hand."
		"Mark your first parts - the sky is closer than you think."
	]
	quest.7064619976CDF7C7.title: "A Curious Wand"
	quest.7088501AD6A45E88.quest_desc: [
		"A blade carved from the bones of something that used to be unstoppable."
		"Your first real answer to dragon country."
	]
	quest.7088501AD6A45E88.title: "Dragon Bone Sword"
	quest.708F634B09E7E85C.quest_desc: ["Grind meat down for all the recipes that call for it."]
	quest.708F634B09E7E85C.title: "The Grinder"
	quest.70AA899FDB166729.quest_desc: [
		"A hatch built to move something that really shouldn't be pipeable."
		"Dragon slaying, meeting full-blown automation."
	]
	quest.70AA899FDB166729.title: "Automating Dragon's Breath"
	quest.70B8D6ED5529E5EE.quest_desc: [
		"Wood only gets you so far before you hit something harder."
		"Mine a little cobblestone and upgrade."
	]
	quest.70B8D6ED5529E5EE.title: "Onto Stone"
	quest.70D1E3A1B8D655BE.quest_desc: [
		"Deep beneath the waves lies neptunium."
		"Melt the ore down into something useful."
	]
	quest.70D1E3A1B8D655BE.title: "Neptunium Ingots"
	quest.70DFCCE0BE9B6803.quest_desc: [
		"Not every strange trinket shares the same origin."
		"Some feel newer. Sharper. Like they were waiting to be found by someone in particular."
	]
	quest.70DFCCE0BE9B6803.title: "Beyond the Ordinary"
	quest.71179F14BB0A6774.quest_desc: ["Reinforced with nautilus shell - dive deeper, stay under longer."]
	quest.71179F14BB0A6774.title: "Nautilus Helmet"
	quest.711C3FAD8C764248.quest_desc: ["Light the Brazier, perform the Warping ritual, and watch space bend politely around your base."]
	quest.711C3FAD8C764248.title: "Rituals and Braziers"
	quest.711D90B647468834.quest_desc: [
		"There's no shortage of things to grow here."
		"Start easy, with a row of tomatoes."
	]
	quest.711D90B647468834.title: "Plant Tomatoes"
	quest.712D3A8F9D5E9E6C.quest_desc: [
		"Built from a Fluid Hatch and a block of bottled experience."
		"Feeds liquid XP straight into your enchanting setup."
	]
	quest.712D3A8F9D5E9E6C.title: "Experience Hatch"
	quest.713EBE5C292F4F10.quest_desc: ["Every sprint gets a little faster with these on."]
	quest.713EBE5C292F4F10.title: "Running Shoes"
	quest.71488CBA97BCDE1D.quest_desc: [
		"Every stage of propulsion, conquered."
		"This is what true thrust mastery feels like."
	]
	quest.71488CBA97BCDE1D.title: "In Thrust We Trust"
	quest.71589650818164AB.quest_desc: [
		"A homestead's better with some company in the pasture."
		"Fence in a few animals and look after them."
	]
	quest.71589650818164AB.title: "Livestock and Care"
	quest.71849604BAE326E5.quest_desc: ["Souls refine into Soulium, and Soulium into a blade quick enough to earn its name."]
	quest.71849604BAE326E5.title: "Blade of Souls"
	quest.71896A91B5D0A1DD.quest_desc: [
		"Spreads dirt, sand, and gravel without the back-and-forth."
		"A small thing, but you'll reach for it constantly."
	]
	quest.71896A91B5D0A1DD.title: "Trowel"
	quest.718C78BE447CA9CD.quest_desc: ["Cozy up the dim corners with a couple of cage lamps."]
	quest.718C78BE447CA9CD.title: "Cage Lighting"
	quest.71ABDFAEE23AD873.quest_desc: ["A little stand to show off your favorite hat by the door."]
	quest.71ABDFAEE23AD873.title: "Hat Stand"
	quest.71AF5CB47B82BA1B.quest_desc: [
		"Barding forged to keep your mount alive when the fight follows you into the air."
		"A flying companion is only as safe as the armor on its back."
	]
	quest.71AF5CB47B82BA1B.title: "Iron Hippogryph Armor"
	quest.71B3FBA82237F651.quest_desc: [
		"Don't stare too long."
		"Take one down."
	]
	quest.71B3FBA82237F651.title: "Enderman Bounty: Novice"
	quest.71C890371D347A80.quest_desc: ["A Spell Turret casts on its own - magic quietly learning to automate itself."]
	quest.71C890371D347A80.title: "Automated Casting"
	quest.71D07563BFFB189E.quest_desc: [
		"Bare walls have no story to tell."
		"A fancy painting gives them a little character."
	]
	quest.71D07563BFFB189E.title: "Wall Art"
	quest.71D6F94A78408199.quest_desc: [
		"Set it beside a spinning shaft and let it grind out bonus"
		"materials while you do something else."
	]
	quest.71D6F94A78408199.title: "Millstone"
	quest.71E5D0D66E5D6B4A.quest_desc: [
		"The Basin catches items and fluids; the Mixer stirs them together."
		"Between the two, half your crafting table becomes obsolete."
	]
	quest.71E5D0D66E5D6B4A.title: "Basin and Mechanical Mixer"
	quest.71F2DB344BB76153.quest_desc: [
		"There's more swimming out there than you'd think."
		"Grab a rod and find out what's biting."
	]
	quest.71F2DB344BB76153.title: "Cast a Line"
	quest.71F8182A86408766.quest_desc: [
		"Spreads dirt, sand, and gravel without the back-and-forth."
		"A small thing, but you'll reach for it constantly."
	]
	quest.71F8182A86408766.title: "Trowel"
	quest.72106315AD9816F2.quest_desc: [
		"Flattens metal into sheets, or set it over a Basin for"
		"compacting recipes. One tool, two jobs."
	]
	quest.72106315AD9816F2.title: "Mechanical Press"
	quest.721CA876937F0D17.quest_desc: [
		"Every fight you walk away from teaches your combat skill something."
		"Keep swinging until holding your own feels natural."
	]
	quest.721CA876937F0D17.title: "A Capable Fighter"
	quest.72390F9034B93F74.quest_desc: [
		"Fifty down. Caves are a little less rattly now."
		"A Protection charm, for the arrows you didn't dodge."
	]
	quest.72390F9034B93F74.title: "Skeleton Bounty: Veteran"
	quest.723F2B71846F7C7F.quest_desc: [
		"Smelted, forged, and sharpened against things that fear silver more than steel."
		"The undead in particular will not enjoy this."
	]
	quest.723F2B71846F7C7F.title: "Silver Sword"
	quest.72415BF0A4BBDD42.quest_desc: [
		"A construct of bone and spite, built to end you."
		"End it first."
	]
	quest.72415BF0A4BBDD42.title: "Slay the Wither"
	quest.724C4BEF52CA7932.quest_desc: [
		"Your ship is claimed and ready - nothing's stopping you from testing its ceiling now."
		"Push it to a genuinely dizzying altitude."
	]
	quest.724C4BEF52CA7932.title: "How High Can We Go?"
	quest.72998CC3BB81C8DB.quest_desc: ["Grind Prosperity Ore into shards, the quiet currency behind Soulium craft."]
	quest.72998CC3BB81C8DB.title: "Prosperity Shards"
	quest.72BD3C5400533A68.quest_desc: ["After enough seasons of farming and building, it all starts to come naturally."]
	quest.72BD3C5400533A68.title: "A Grower's Instinct"
	quest.72C9A832BD83B4A7.quest_desc: [
		"Look at everything behind you now - what you fought, what you learned, what you built, how far you wandered."
		"None of it was required. You did it anyway, and that's the whole point."
	]
	quest.72C9A832BD83B4A7.title: "A Life Well Built"
	quest.72F381D4F75B38A6.quest_desc: [
		"Take a walk. Get a feel for the biome, the neighbours, whatever's watching you back."
		"Keep your eyes open - this world hides more than it shows."
	]
	quest.72F381D4F75B38A6.title: "Step Outside"
	quest.72F4CDCBEE96CEE8.quest_desc: ["Brew up something warming for a quiet evening."]
	quest.72F4CDCBEE96CEE8.title: "Chai Tea"
	quest.72FAC2FE756CC9CA.quest_desc: [
		"The night is full of them."
		"Put one down."
	]
	quest.72FAC2FE756CC9CA.title: "Zombie Bounty: Novice"
	quest.7300FE2E68A67A4F.quest_desc: ["A cupboard and drawer keep the clutter out of sight."]
	quest.7300FE2E68A67A4F.title: "Storage Furniture"
	quest.73079BEC5E98CBA3.quest_desc: ["A dressed-up controller for the room you actually want to look at."]
	quest.73079BEC5E98CBA3.title: "Framed Drawer Controller"
	quest.733355E31E00F12B.quest_desc: [
		"Bolt on Windmill Sails and output climbs with every one you add."
		"Big footprint, bigger payoff."
	]
	quest.733355E31E00F12B.title: "Windmill Bearing"
	quest.733B4FDEF601AD55.quest_desc: ["A lantern that mounts flush to a wall, no floor space lost."]
	quest.733B4FDEF601AD55.title: "Wall Lantern"
	quest.733BD4590091FB9B.quest_desc: ["It moves like a storm and hits like one too."]
	quest.733BD4590091FB9B.title: "Slay a Lightning Dragon"
	quest.7356D45D664946D3.quest_desc: [
		"An illager who traded a crossbow for ice magic."
		"Rare, and rarely friendly."
	]
	quest.7356D45D664946D3.title: "Rare Encounter: Iceologer"
	quest.7358A539BA8DEF0A.quest_desc: [
		"Copper's cheap and you've got plenty of it."
		"Start your tool line here."
	]
	quest.7358A539BA8DEF0A.title: "Copper Tools"
	quest.7364712B34F2536C.quest_desc: [
		"Draw Copper Rods into wire. Every electrical connection"
		"in this network starts with a spool of this."
	]
	quest.7364712B34F2536C.title: "Copper Wiring"
	quest.737E8420D47AA999.quest_desc: ["Blend it up for something cool and refreshing."]
	quest.737E8420D47AA999.title: "Banana Smoothie"
	quest.738B868F6AF2AE5D.quest_desc: ["Another jump in capacity, stacked on top of the first."]
	quest.738B868F6AF2AE5D.title: "Storage Upgrade (II)"
	quest.73C0D5807B124D2D.quest_desc: ["A friendly signpost pointing visitors toward the notice board, and beyond."]
	quest.73C0D5807B124D2D.title: "Way Sign"
	quest.73C48A0454DCA1F1.quest_desc: [
		"Source Gems hum quietly near deposits of Sourcestone, holding the energy every spell will draw from."
		"Gather a handful to begin."
	]
	quest.73C48A0454DCA1F1.title: "Gems of Source"
	quest.73CD29663D82F5B4.quest_desc: ["Brass catwalks and railings keep you steady above it all."]
	quest.73CD29663D82F5B4.title: "Catwalks and Railings"
	quest.73D40FD0B8005E23.quest_desc: ["Another jump in capacity, stacked on top of the first."]
	quest.73D40FD0B8005E23.title: "Storage Upgrade (II)"
	quest.73E72148E71FE32E.quest_desc: [
		"Every explorer starts leaving their own trail of shortcuts and landmarks eventually."
		"You may already have a Waystone or two out there without calling it anything special."
	]
	quest.73E72148E71FE32E.title: "Marks on the Map"
	quest.73F76892AEC1B142.quest_desc: ["Every room deserves a proper door, and a trapdoor besides."]
	quest.73F76892AEC1B142.title: "Doors and Trapdoors"
	quest.73F95F1B5710BBED.quest_desc: [
		"A plain lamp that only glows when you flick a switch for it."
		"Perfect for a hidden light you control from elsewhere."
	]
	quest.73F95F1B5710BBED.title: "Stone Lamp"
	quest.7401BDD2C34E545E.quest_desc: ["Shell plating for extra protection out on aquatic jobs."]
	quest.7401BDD2C34E545E.title: "Turtle Chestplate"
	quest.7401CF376992BFA8.quest_desc: ["Round out the table with a warm loaf of garlic bread."]
	quest.7401CF376992BFA8.title: "Garlic Bread Feast"
	quest.7406E9D32E408036.quest_desc: ["Ten down. The horde barely notices, but you will."]
	quest.7406E9D32E408036.title: "Zombie Bounty: Apprentice"
	quest.741B2FC8728AED64.quest_desc: ["Every room deserves a proper door, and a trapdoor besides."]
	quest.741B2FC8728AED64.title: "Doors and Trapdoors"
	quest.745FEDE15ECFD033.quest_desc: ["Arm a villager and give your village its first line of defense."]
	quest.745FEDE15ECFD033.title: "Hire a Guard"
	quest.746CB3C8D85C5449.quest_desc: [
		"Bringing a moving ship to rest against something solid takes more than good piloting."
		"Craft a pair of docking connectors and link two points together."
	]
	quest.746CB3C8D85C5449.title: "Docking Systems"
	quest.74A9D51210F59D0F.quest_desc: [
		"Strange veins hum beneath the stone, waiting to be broken open."
		"Essence farming begins right here."
	]
	quest.74A9D51210F59D0F.title: "A Curious Ore"
	quest.74E294B4E09B3AA1.quest_desc: [
		"The stove is the heart of a proper kitchen."
		"It's what gets the skillet going."
	]
	quest.74E294B4E09B3AA1.title: "Fire Up the Stove"
	quest.74E3388B4928C91B.quest_desc: ["Fancy a cooler look? Try a batch of Blue Bricks instead."]
	quest.74E3388B4928C91B.title: "Blue Brick Palette"
	quest.74E52F1AC41C9980.quest_desc: [
		"A wand and a little stored Source are enough to bind your first spell book."
		"Simple glyphs, simple experiments."
	]
	quest.74E52F1AC41C9980.title: "Novice Spell Book"
	quest.74FAB2BBC96CBE1F.quest_desc: [
		"Sheet metal, riveted tight."
		"The stuff locomotives are built from."
	]
	quest.74FAB2BBC96CBE1F.title: "Riveted Locometal"
	quest.75006942C8090729.quest_desc: [
		"Every good defense starts with a shield."
		"Craft one before the raiders come knocking."
	]
	quest.75006942C8090729.title: "Arm Yourself"
	quest.750241B0C05BE952.quest_desc: ["Wake your Supremium at the altar, and it becomes something the mod never quite intended."]
	quest.750241B0C05BE952.title: "Awakened Supremium"
	quest.7562FAF2562DFC17.quest_desc: ["Turn fruit from the orchard into something worth drinking."]
	quest.7562FAF2562DFC17.title: "The Juicer"
	quest.75DBB872AF762F2B.quest_desc: ["Souls refine into Soulium, and Soulium into a blade quick enough to earn its name."]
	quest.75DBB872AF762F2B.title: "Blade of Souls"
	quest.75DF908DE4F949BE.quest_desc: ["Nut trees like walnut are worth the wait, come roasting time."]
	quest.75DF908DE4F949BE.title: "Walnut Trees"
	quest.75F8AA22E1C9F247.quest_desc: ["The key that opens the safe, and anything else you've locked up."]
	quest.75F8AA22E1C9F247.title: "Key"
	quest.7618E1B9E76D48ED.quest_desc: ["The key that opens the safe, and anything else you've locked up."]
	quest.7618E1B9E76D48ED.title: "Key"
	quest.763766189E6CC39A.quest_desc: [
		"The ocean keeps its best secrets where the light gives up."
		"Bring something back worth telling people about."
	]
	quest.763766189E6CC39A.title: "Beneath the Waves"
	quest.765631AB6445C796.quest_desc: [
		"Dresses drawers up with trim and matching materials."
		"For when function needs to look good too."
	]
	quest.765631AB6445C796.title: "Framing Table"
	quest.76A53A1CC1AD27C6.quest_desc: [
		"Plant a Waystone and the map shrinks a little."
		"Right-click it any time to open the travel menu."
	]
	quest.76A53A1CC1AD27C6.title: "Place a Waystone"
	quest.76D51B989D5E0EB5.quest_desc: [
		"The ocean keeps its best secrets where the light gives up."
		"Bring something back worth telling people about."
	]
	quest.76D51B989D5E0EB5.title: "Beneath the Waves"
	quest.76DC08601E83EF19.quest_desc: [
		"Shell and bone, sharpened to a point."
		"Keeps the local wildlife off your back while you work."
	]
	quest.76DC08601E83EF19.title: "Seashell Spear"
	quest.76E1D034CAD89A23.quest_desc: ["A versatile little grain that turns up in dish after dish."]
	quest.76E1D034CAD89A23.title: "Harvest Rice"
	quest.76FEEC4AE0F53B9D.quest_desc: [
		"A ruin, a tower, something half-buried and strange enough to stop you mid-stride."
		"You'll know it the moment you see it."
	]
	quest.76FEEC4AE0F53B9D.title: "Something Worth Finding"
	quest.770F009D8D27DC35.quest_desc: [
		"A contraption that actually leaves the ground, and airspace you can finally call yours."
		"The sky was never really closed off. It just took you a while to get up there."
	]
	quest.770F009D8D27DC35.title: "Claimed Skies"
	quest.770F1A60A8A4B9CF.quest_desc: [
		"Every journey starts with a chopped log and a rough set of tools."
		"Nothing fancy - just enough to get moving."
	]
	quest.770F1A60A8A4B9CF.title: "First Tools"
	quest.77107989A7A65095.quest_desc: [
		"Some relics want to be worn, not just held."
		"Find their proper place - a ring, a belt, a charm slot - and settle it in."
	]
	quest.77107989A7A65095.title: "Worn, Not Carried"
	quest.771F520D1597E570.quest_desc: [
		"Feed it to a hatchling and hope it decides to trust you."
		"Armed and ready - now it's time to find a nest."
	]
	quest.771F520D1597E570.title: "Taming a Dragon"
	quest.77326AA5C041D2EE.quest_desc: [
		"Eight legs, bad attitude."
		"Deal with one."
	]
	quest.77326AA5C041D2EE.title: "Spider Bounty: Novice"
	quest.77500B705F8739E8.quest_desc: [
		"This isn't ordinary treasure. Relics drop from exploration, not a single named item."
		"Whatever you've discovered appears to respond to its owner. Carry it with you, and see what it can become."
	]
	quest.77500B705F8739E8.title: "Something Ancient"
	quest.776BBB11C3913718.quest_desc: ["Another capacity jump on top of copper."]
	quest.776BBB11C3913718.title: "Gold Upgrade"
	quest.7771D5EFD2003774.quest_desc: ["Every sprint gets a little faster with these on."]
	quest.7771D5EFD2003774.title: "Running Shoes"
	quest.77B848D99AF22F51.quest_desc: [
		"Every stage of propulsion, conquered."
		"This is what true thrust mastery feels like."
	]
	quest.77B848D99AF22F51.title: "In Thrust We Trust"
	quest.77C3B261622F5B7E.quest_desc: [
		"Mesh with a regular Cogwheel and you can gear speed up or down."
		"Simple as that."
	]
	quest.77C3B261622F5B7E.title: "Large Cogwheel"
	quest.77C7D2284195740C.quest_desc: [
		"Bind an amethyst shard, a writable book, and spruce wood together."
		"What results is no ordinary book - it's a record of arcane augmentation, waiting to be filled."
	]
	quest.77C7D2284195740C.title: "The Skills Grimoire"
	quest.77CFB974CA7B9AD6.quest_desc: [
		"Bottle the XP so pipes and pumps can move it wherever"
		"it's needed next."
	]
	quest.77CFB974CA7B9AD6.title: "Bucket o' Enchanting"
	quest.77EBE2D6EF1B537B.quest_desc: ["Mystical Agradditions dares one tier further. Crux and awakened essence combine into the true capstone: Insanium."]
	quest.77EBE2D6EF1B537B.title: "Insanium: Beyond Awakened"
	quest.782646A1F1B5DAC2.quest_desc: [
		"Conjures decoys and vanishes mid-fight."
		"Trust nothing you see."
	]
	quest.782646A1F1B5DAC2.title: "Rare Encounter: Illusioner"
	quest.78307A4A330F364D.quest_desc: [
		"Dip the marshmallow in melted chocolate and both branches"
		"of this line finally meet."
	]
	quest.78307A4A330F364D.title: "Chocolate Glazed Marshmallow"
	quest.785A94580AC6494C.quest_desc: [
		"Plant one down and hostile magic simply stops working nearby."
		"A quiet, permanent kind of safety."
	]
	quest.785A94580AC6494C.title: "Warding Stone"
	quest.78682FACA89C870B.quest_desc: [
		"A boot that seems to forget it's supposed to be heavy."
		"Whoever crafted these understood more than simple enchanting."
	]
	quest.78682FACA89C870B.title: "Light as Air"
	quest.7886B4717228A8B7.quest_desc: ["See through a linked eye, anywhere the ritual has been cast before."]
	quest.7886B4717228A8B7.title: "The Scrying Ritual"
	quest.78932AEF527039B5.quest_desc: [
		"Run cocoa beans under a millstone or crushing wheels."
		"Every chocolate recipe in this line traces back to this step."
	]
	quest.78932AEF527039B5.title: "Crushed Cocoa"
	quest.7893B2F63C1C22D2.quest_desc: [
		"Regulates current flow for the heavier machinery"
		"further down the line."
	]
	quest.7893B2F63C1C22D2.title: "Capacitor"
	quest.78CE6D36C24C800C.quest_desc: ["Magebloom woven into robes light enough that spellcasting never feels encumbered."]
	quest.78CE6D36C24C800C.title: "Arcanist's Robes"
	quest.78E3DB246027FC21.quest_desc: [
		"Alloy your first bit of andesite and you've taken your first step into Create."
		"There's a whole engineer's life waiting past this one alloy."
	]
	quest.78E3DB246027FC21.title: "A Taste of Engineering"
	quest.78FAE473FAD3D4D8.quest_desc: ["Finish the bedroom off with a bed that's a cut above plain."]
	quest.78FAE473FAD3D4D8.title: "A Proper Bed"
	quest.792C97C1E444816C.quest_desc: [
		"Goblins never give anything away for free, but they'll always make a deal."
		"Trade with a Goblin Trader and see what they're carrying."
	]
	quest.792C97C1E444816C.title: "Strike a Deal"
	quest.795142A94E21C928.quest_desc: [
		"You've seen more of this world than most people who ever load it up will."
		"The map stopped being frightening a long time ago."
	]
	quest.795142A94E21C928.title: "Beyond the Horizon"
	quest.7954D79A7D313436.quest_desc: ["A friendly signpost pointing visitors toward the notice board, and beyond."]
	quest.7954D79A7D313436.title: "Way Sign"
	quest.79558E09597913DE.quest_desc: [
		"Ropes aren't the only way to cross a gap in a hurry."
		"Craft a plunger launcher for a spring-loaded burst of momentum."
	]
	quest.79558E09597913DE.title: "Plunger Launcher"
	quest.795970C5E2ACE957.quest_desc: [
		"A garden's better with a bit of red in it."
		"Get some tomato seeds in the ground."
	]
	quest.795970C5E2ACE957.title: "Growing Tomatoes"
	quest.795AC4DC7893367D.quest_desc: [
		"A blade turns that board into a real prep station."
		"The flint knife won't win awards, but it'll do."
	]
	quest.795AC4DC7893367D.title: "A Sharp Edge"
	quest.798C5536AAAA3CCD.quest_desc: [
		"A blade carved from the bones of something that used to be unstoppable."
		"Your first real answer to dragon country."
	]
	quest.798C5536AAAA3CCD.title: "Dragon Bone Sword"
	quest.79CF8BEE5401B893.quest_desc: ["Another jump in capacity, stacked on top of the first."]
	quest.79CF8BEE5401B893.title: "Storage Upgrade (II)"
	quest.79E052414FAA0F01.quest_desc: [
		"Loot drops, and it comes straight to you."
		"A must-have for anyone who mines seriously."
	]
	quest.79E052414FAA0F01.title: "Universal Attractor"
	quest.7A021444F7E41FAE.quest_desc: [
		"Drop one down and it links up with its neighbors automatically."
		"The starting point for any wired network."
	]
	quest.7A021444F7E41FAE.title: "Cross Connector"
	quest.7A0605FE15B04433.quest_desc: [
		"Channels mechanical power straight down into the depths."
		"The hypertube network runs on this."
	]
	quest.7A0605FE15B04433.title: "Conduit Cage"
	quest.7A0C28894CFC2992.quest_desc: ["Walls and a roof make shelter. A little care makes it home."]
	quest.7A0C28894CFC2992.title: "Make It Feel Like Home"
	quest.7A24529FE101C582.quest_desc: ["Ten quivers emptied for nothing."]
	quest.7A24529FE101C582.title: "Skeleton Bounty: Apprentice"
	quest.7A2595130248CF6A.quest_desc: [
		"A plain lamp that only glows when you flick a switch for it."
		"Perfect for a hidden light you control from elsewhere."
	]
	quest.7A2595130248CF6A.title: "Stone Lamp"
	quest.7A29457E8482F264.quest_desc: [
		"Gold and Silver alloyed into Electrum wire - carries"
		"current more efficiently than Copper ever could."
	]
	quest.7A29457E8482F264.title: "Electrum Wiring"
	quest.7A42F05FEC42FDFB.quest_desc: ["Choose your enchantments exactly, instead of leaving it to chance."]
	quest.7A42F05FEC42FDFB.title: "Matrix Enchanting Table"
	quest.7A48592F5011DB58.quest_desc: ["Another capacity jump on top of copper."]
	quest.7A48592F5011DB58.title: "Gold Upgrade"
	quest.7A58A5E684BED2AF.quest_desc: [
		"Wood splinters and warps - time to upgrade."
		"Craft sturdier andesite blades, then a smart propeller that adjusts its own pitch for real efficient thrust."
	]
	quest.7A58A5E684BED2AF.title: "Propeller Upgrades"
	quest.7A6B2025AB94C4E6.quest_desc: [
		"Fifty. You've got a real knack for not making eye contact."
		"A Looting charm - they were carrying pearls anyway."
	]
	quest.7A6B2025AB94C4E6.title: "Enderman Bounty: Veteran"
	quest.7A740665D3ACD978.quest_desc: [
		"Bleeds excess pressure off before it becomes a problem."
		"Every serious envelope has one."
	]
	quest.7A740665D3ACD978.title: "Steam Vent"
	quest.7A75395F7BFD3DF8.quest_desc: [
		"Spreads dirt, sand, and gravel without the back-and-forth."
		"A small thing, but you'll reach for it constantly."
	]
	quest.7A75395F7BFD3DF8.title: "Trowel"
	quest.7A7DF69EC2E7CFD7.quest_desc: [
		"Run cocoa beans under a millstone or crushing wheels."
		"Every chocolate recipe in this line traces back to this step."
	]
	quest.7A7DF69EC2E7CFD7.title: "Crushed Cocoa"
	quest.7A9A59879785C9D2.quest_desc: ["A little zinc fencing keeps things secure, and still looks the part."]
	quest.7A9A59879785C9D2.title: "Bars and Mesh Fences"
	quest.7AC1544970F8E822.quest_desc: [
		"Rattling bones, aimed arrows."
		"Silence one."
	]
	quest.7AC1544970F8E822.title: "Skeleton Bounty: Novice"
	quest.7AC21475B13173F7.quest_desc: [
		"So many trees to try."
		"Apples are a fine place to start an orchard."
	]
	quest.7AC21475B13173F7.title: "Plant an Apple Orchard"
	quest.7ADA20B88FB59562.quest_desc: ["Magebloom woven into robes light enough that spellcasting never feels encumbered."]
	quest.7ADA20B88FB59562.title: "Arcanist's Robes"
	quest.7AE34DEFE162CE3A.quest_desc: [
		"Odd-shaped and easy to miss on the seafloor."
		"Crack it open and it's usually worth the detour."
	]
	quest.7AE34DEFE162CE3A.title: "Suspicious Rock"
	quest.7AE65C72EFED4B9A.quest_desc: ["Bumps up the stack size on everything stored inside."]
	quest.7AE65C72EFED4B9A.title: "Stack Upgrade Tier 1"
	quest.7AEBACD2060ED034.quest_desc: [
		"Straps on over your chestplate and speeds up mining"
		"and movement both. Your first taste of powered gear."
	]
	quest.7AEBACD2060ED034.title: "Copper Exoskeleton"
	quest.7AF036E7D783AEED.quest_desc: ["Seals out the water so you can actually get work done down there."]
	quest.7AF036E7D783AEED.title: "Diving Helmet"
	quest.7B0597E18889CCFA.quest_desc: ["Keep your hooks and gear tidy, right where you can find them."]
	quest.7B0597E18889CCFA.title: "The Tackle Box"
	quest.7B0B80702A405BEE.quest_desc: [
		"Goblins never give anything away for free, but they'll always make a deal."
		"Trade with a Goblin Trader and see what they're carrying."
	]
	quest.7B0B80702A405BEE.title: "Strike a Deal"
	quest.7B122BE455D6462C.quest_desc: [
		"Andesite casing tidies up the wiring and toughens it -"
		"the first upgrade tier."
	]
	quest.7B122BE455D6462C.title: "Andesite Encased Connector"
	quest.7B2DACED99940DF4.quest_desc: [
		"Keeps an eye on tube traffic as it moves through the network."
		"About as far as aquatic engineering goes."
	]
	quest.7B2DACED99940DF4.title: "Tube Scanner Attachment"
	quest.7B38F7AB6DE05648.quest_desc: [
		"So many trees to try."
		"Apples are a fine place to start an orchard."
	]
	quest.7B38F7AB6DE05648.title: "Plant an Apple Orchard"
	quest.7B5F7CA991CAF4D8.quest_desc: [
		"Journal in hand, belly full, loot stashed, iron tools ready."
		"Diamond can wait. That's everything you need to start. The rest is out there waiting."
	]
	quest.7B5F7CA991CAF4D8.title: "Ready for What's Next"
	quest.7B731EE115D9E4D1.quest_desc: [
		"Every stage of propulsion, conquered."
		"This is what true thrust mastery feels like."
	]
	quest.7B731EE115D9E4D1.title: "In Thrust We Trust"
	quest.7B78AC5083429230.quest_desc: [
		"Raise one at every junction."
		"Keeps two trains from ever meeting somewhere they shouldn't."
	]
	quest.7B78AC5083429230.title: "Raise a Semaphore"
	quest.7B7B56194FA6227B.quest_desc: ["Stops a train dead at the end of the line, no drama."]
	quest.7B7B56194FA6227B.title: "Track Buffer"
	quest.7B88C2EEAD6488FB.quest_desc: [
		"This isn't practice. It's augmentation - power drawn from somewhere else entirely."
		"You've uncovered a second kind of growth, running alongside your own."
	]
	quest.7B88C2EEAD6488FB.title: "Arcane Mastery"
	quest.7BBFD9207C635FD2.quest_desc: ["Tomato sauce and fresh onions, brought together into a rustic little classic."]
	quest.7BBFD9207C635FD2.title: "Ratatouille"
	quest.7BE1109BEA8D8F1D.quest_desc: [
		"Two habits will save you hours out here."
		"Press U over an item for its recipe in JEI, and let Jade tell you what you're looking at."
	]
	quest.7BE1109BEA8D8F1D.title: "Learn Your Tools"
	quest.7BF2F3C1AEF8EBBF.quest_desc: ["More room, more upgrade slots - a solid step up from the basic pack."]
	quest.7BF2F3C1AEF8EBBF.title: "Iron Backpack"
	quest.7BF3B898A4616CE2.quest_desc: [
		"Draw Copper Rods into wire. Every electrical connection"
		"in this network starts with a spool of this."
	]
	quest.7BF3B898A4616CE2.title: "Copper Wiring"
	quest.7C131A5B6EA9CFED.quest_desc: [
		"A full stomach keeps you sprinting, jumping, healing - all of it."
		"Cook something simple and eat."
	]
	quest.7C131A5B6EA9CFED.title: "Fill Your Belly"
	quest.7C223B4A6FC2B4E5.quest_desc: [
		"Raw levitite is too unstable to use as-is."
		"Blend it down into the base ingredient for a whole class of anti-gravity gear."
	]
	quest.7C223B4A6FC2B4E5.title: "Refining Levitite"
	quest.7C3E9C1A42E641F8.quest_desc: [
		"A whole new set of kitchen tools begins here."
		"Craft a cutting board and start prepping."
	]
	quest.7C3E9C1A42E641F8.title: "Pam's Cutting Board"
	quest.7C54D307A554ABE2.quest_desc: ["Bind a Warp Scroll to a Waystone for one quick trip from anywhere."]
	quest.7C54D307A554ABE2.title: "Warp Scroll"
	quest.7C5C0FB89ECBD10D.quest_desc: ["Shell plating for extra protection out on aquatic jobs."]
	quest.7C5C0FB89ECBD10D.title: "Turtle Chestplate"
	quest.7C5D33E71031FB70.quest_desc: [
		"A ship this valuable needs protecting - from raiders, from griefers, from anyone who isn't you."
		"Place a claim block aboard and bring it under your protection, wherever it flies."
	]
	quest.7C5D33E71031FB70.title: "Claim the Skies"
	quest.7C64BEC99183D6E6.quest_desc: ["Prudentium tools bite far deeper than Inferium ever could."]
	quest.7C64BEC99183D6E6.title: "Prudentium Gear"
	quest.7C6884D55F55BEE8.quest_desc: [
		"A blade carved from the bones of something that used to be unstoppable."
		"Your first real answer to dragon country."
	]
	quest.7C6884D55F55BEE8.title: "Dragon Bone Sword"
	quest.7C8B66EB85B86EF7.quest_desc: [
		"A floating nether menace, all fire and fury."
		"Watch for the flames."
	]
	quest.7C8B66EB85B86EF7.title: "Rare Encounter: Wildfire"
	quest.7C913270A2D091F0.quest_desc: [
		"Blows air down a belt for smelting, smoking, blasting or"
		"washing - no furnace required."
	]
	quest.7C913270A2D091F0.title: "Encased Fan"
	quest.7C92B5E4E4ED61F9.quest_desc: ["One swing clears a 3x3 patch, so tunnels go a lot faster."]
	quest.7C92B5E4E4ED61F9.title: "Hammer"
	quest.7C9A4B6AE7888EDD.quest_desc: [
		"Your builds are starting to feel a lot safer."
		"A basic Blast Protection charm for your trouble."
	]
	quest.7C9A4B6AE7888EDD.title: "Creeper Bounty: Veteran"
	quest.7CC1E112A9AACA6F.quest_desc: [
		"Four iron blocks in a T, a carved pumpkin on top."
		"Summon an Iron Golem built to take a beating for your village."
	]
	quest.7CC1E112A9AACA6F.title: "Iron Golem"
	quest.7CE0BF53AEE9FF51.quest_desc: ["Bind a Warp Scroll to a Waystone for one quick trip from anywhere."]
	quest.7CE0BF53AEE9FF51.title: "Warp Scroll"
	quest.7CEF5CAD501F1F72.quest_desc: [
		"A heart, a forge, and heat most things wouldn't survive."
		"What comes out the other side is close to unbreakable."
	]
	quest.7CEF5CAD501F1F72.title: "Fire Dragonsteel Ingot"
	quest.7CF356AE52ADF1E0.quest_desc: ["Longer, cleverer spells need a sturdier book. The Mage's Spell Book obliges."]
	quest.7CF356AE52ADF1E0.title: "Mage's Spell Book"
	quest.7CF9DDBB764ABAA8.quest_desc: [
		"Raw levitite is too unstable to use as-is."
		"Blend it down into the base ingredient for a whole class of anti-gravity gear."
	]
	quest.7CF9DDBB764ABAA8.title: "Refining Levitite"
	quest.7D0071188E369EA4.quest_desc: [
		"Deep underground, a mineral seems to weigh less than it should."
		"Mine some levitite and find out why."
	]
	quest.7D0071188E369EA4.title: "A Strange Floating Mineral"
	quest.7D1121F435DEEAE0.quest_desc: ["Turn fruit from the orchard into something worth drinking."]
	quest.7D1121F435DEEAE0.title: "The Juicer"
	quest.7D2E9F6F67F96051.quest_desc: ["Access the network from anywhere - no need to stand at a block."]
	quest.7D2E9F6F67F96051.title: "Wireless Terminal"
	quest.7D3CBADE95CB8D82.quest_desc: [
		"Copper's cheap and you've got plenty of it."
		"Start your tool line here."
	]
	quest.7D3CBADE95CB8D82.title: "Copper Tools"
	quest.7D5C66ABE4F8EA70.quest_desc: [
		"Envelope, propeller, and levitite - three disciplines, now one."
		"Craft aviator's goggles and wear the mark of someone who belongs up here."
	]
	quest.7D5C66ABE4F8EA70.title: "Aviator's Goggles"
	quest.7D7A3D8D040EB516.quest_desc: [
		"Drop it in flowing water and forget about it."
		"Steady power, zero upkeep."
	]
	quest.7D7A3D8D040EB516.title: "Water Wheel"
	quest.7D880888E2855575.quest_desc: [
		"No more spinning propellers by hand - it's time for real self-contained power."
		"Build a portable engine and work it up into a finished engine assembly."
	]
	quest.7D880888E2855575.title: "Building an Engine"
	quest.7D9F20A19341D23E.quest_desc: [
		"Cold even in your hand, taken from a dragon that never once blinked."
		"The Ice Dragonsteel line begins here - but it starts with a kill."
	]
	quest.7D9F20A19341D23E.title: "Heart of an Ice Dragon"
	quest.7DC0FC322A6323B1.quest_desc: [
		"Straight-line power transfer, nothing fancy about it."
		"Every contraption you build will have a few of these running through it."
	]
	quest.7DC0FC322A6323B1.title: "Shaft"
	quest.7DC5062D93D35BB2.quest_desc: [
		"A Netherite Ingot and a Netherite Upgrade Smithing Template, applied to a Diamond Upgrade at a smithing table."
		"The true final tier - nothing stores more, nothing survives more."
	]
	quest.7DC5062D93D35BB2.title: "Netherite Upgrade"
	quest.7DCC0BCC2DEC9926.quest_desc: [
		"Calcium powder and prismarine crystals, fused together."
		"Everything underwater gets built on this."
	]
	quest.7DCC0BCC2DEC9926.title: "Prismarine Alloy"
	quest.7DFDC03CDAD6A864.quest_desc: [
		"A full chestplate demanding fire, ice, and lightning all pay their toll first."
		"You don't wear this until three different dragons have already tried to stop you."
	]
	quest.7DFDC03CDAD6A864.title: "Fire Dragonsteel Chestplate"
	quest.7DFF125C6AC3D2C9.quest_desc: [
		"Mesh with a regular Cogwheel and you can gear speed up or down."
		"Simple as that."
	]
	quest.7DFF125C6AC3D2C9.title: "Large Cogwheel"
	quest.7E11127425B82CCF.quest_desc: [
		"Tempered over a Blaze Burner. Hits like Diamond"
		"and never needs repairing."
	]
	quest.7E11127425B82CCF.title: "Blazing Pickaxe"
	quest.7E1A0C0057AE5EA5.quest_desc: ["A hundred archers who never got a shot off worth remembering."]
	quest.7E1A0C0057AE5EA5.title: "Skeleton Bounty: Expert"
	quest.7E43925B115CBED6.quest_desc: [
		"Two habits will save you hours out here."
		"In JEI, press R over an item for its recipe and U for its uses. Hover a block in the world for Jade."
	]
	quest.7E43925B115CBED6.title: "Learn Your Tools"
	quest.7E6F5222DFEC2B92.quest_desc: ["Light the Brazier, perform the Warping ritual, and watch space bend politely around your base."]
	quest.7E6F5222DFEC2B92.title: "Rituals and Braziers"
	quest.7E94AF73DCEF5A03.quest_desc: [
		"Press instead of mix and you get cocoa butter,"
		"the fatty base behind the paler chocolates."
	]
	quest.7E94AF73DCEF5A03.title: "Cocoa Butter"
	quest.7ED53FD90A015528.quest_desc: [
		"Tempered over a Blaze Burner. Hits like Diamond"
		"and never needs repairing."
	]
	quest.7ED53FD90A015528.title: "Blazing Pickaxe"
	quest.7F407BCEEA37FC6E.quest_desc: [
		"The payoff for the whole network: a Tesla Coil that lets"
		"your stored power go out with a bang."
	]
	quest.7F407BCEEA37FC6E.title: "Tesla Coil"
	quest.7F45C239251689F1.quest_desc: [
		"Make a big batch and keep it close."
		"A bucket of stew never goes to waste."
	]
	quest.7F45C239251689F1.title: "Stew by the Bucket"
	quest.7F4618BF4BD39229.quest_desc: ["Suddenly your reach is a lot longer than your arm."]
	quest.7F4618BF4BD39229.title: "Power Glove"
	quest.7F4A3D57E1758890.quest_desc: ["Only one tier of gear now stands between you and Supremium."]
	quest.7F4A3D57E1758890.title: "Imperium Gear"
	quest.7F6A46C39C7254B1.quest_desc: [
		"Set it beside a spinning shaft and let it grind out bonus"
		"materials while you do something else."
	]
	quest.7F6A46C39C7254B1.title: "Millstone"
	quest.7F89DA8821CEB4A8.quest_desc: ["A crafting table that pulls ingredients straight from the network - no more digging through chests."]
	quest.7F89DA8821CEB4A8.title: "Crafting Terminal"
	quest.7F8A0622D7783234.quest_desc: [
		"Link two together and the signal jumps between them"
		"with no wire in sight."
	]
	quest.7F8A0622D7783234.title: "Linked Transmitter"
	quest.7FBDC08C80F4F1ED.quest_desc: [
		"A wood-matched chest for whichever room it lands in."
		"Start the collection with a simple Oak Chest."
	]
	quest.7FBDC08C80F4F1ED.title: "Variant Chest"
	quest.7FD86FBAB7D7C08A.quest_desc: [
		"A compass that points toward entire biomes, not just north."
		"This world is bigger than you think - go see some of it."
	]
	quest.7FD86FBAB7D7C08A.title: "A Taste of Exploration"
	quest.7FEAA0D9304C697E.quest_desc: ["Roomier still."]
	quest.7FEAA0D9304C697E.title: "Gold Backpack"
	quest.7FF6941989E5E902.quest_desc: ["Mix it up and see what a simple stew tastes like."]
	quest.7FF6941989E5E902.title: "A Simple Stew"
	quest.7FFA37B4BD4EF64A.quest_desc: [
		"Relics reveal themselves through use, not explanation."
		"Keep it on you. Try it in places you wouldn't expect."
	]
	quest.7FFA37B4BD4EF64A.title: "Experiment"
